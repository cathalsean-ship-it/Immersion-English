---
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = [
  {
    slug: 'ielts-preparation-tips-for-bulgarian-students',
    title: 'IELTS Preparation Tips for Bulgarian Students',
    excerpt: 'Practical advice for Bulgarian students preparing for IELTS – from Speaking and Writing strategies to the most common mistakes and how immersion builds real exam confidence.',
    date: '5 June 2026',
    author: 'Cathal Leonard',
    image: '/blog-ielts.webp',
  },
  {
    slug: 'why-speaking-english-feels-harder-than-reading-or-listening',
    title: 'Why Speaking English Feels Harder Than Reading or Listening',
    excerpt: 'Many English learners understand far more than they can comfortably say. The reason speaking feels harder lies in how the brain processes language and how English is usually learned.',
    date: '15 January 2026',
    author: 'Cathal Leonard',
    image: '/blog-speaking-harder.webp',
    imageAlt: 'Person hesitating to speak',
  },
  {
    slug: 'cefr-what-your-english-level-really-tells-you-and-what-it-doesnt',
    title: 'CEFR: What Your English Level Really Tells You – and What It Doesn\'t',
    excerpt: 'Being told you\'re B2 or C1 doesn\'t always mean you feel confident speaking English. CEFR levels are useful, but they don\'t show the full picture of real communication.',
    date: '10 January 2026',
    author: 'Cathal Leonard',
    image: '/blog-cefr.webp',
    imageAlt: 'CEFR language levels',
  },
  {
    slug: 'why-ireland-is-one-of-the-best-places-in-the-world-to-learn-english',
    title: 'Why Ireland Is One of the Best Places in the World to Learn English',
    excerpt: 'Ireland combines high-quality English education with a culture built on conversation, storytelling, and human connection. Discover why it\'s one of the best places in the world to learn English through immersion.',
    date: '22 December 2025',
    author: 'Cathal Leonard',
    image: '/blog-ireland.webp',
    imageAlt: 'Irish people in conversation in a pub',
  },
  {
    slug: 'ai-and-the-human-touch-in-language-learning',
    title: 'AI and the Human Touch: Why Teachers Matter More Than Ever',
    excerpt: 'Artificial intelligence can support learning – but real progress happens through human connection. Research shows that teachers remain essential to developing real communicative competence.',
    date: '21 October 2025',
    author: 'Cathal Leonard',
    image: '/blog-ai.webp',
    imageAlt: 'AI robot on a wooden bench',
  },
  {
    slug: 'the-power-of-conversation-how-small-talk-builds-big-confidence',
    title: 'The Power of Conversation: How Small Talk Builds Big Confidence',
    excerpt: 'Small talk isn\'t small. Research shows everyday conversation boosts confidence, wellbeing, and fluency – especially when guided by CELTA-qualified teachers.',
    date: '14 August 2025',
    author: 'Cathal Leonard',
    image: '/blog-conversation.webp',
    imageAlt: 'Teens in conversation',
  },
];
---

<BaseLayout title="Insights & Perspectives | English Learning Blog | Immersion English Sofia" description="Teaching reflections, language research, and expert perspectives from Immersion English – a CELTA-qualified English school in Sofia with a summer programme in Dublin."
  ogImage="/blog-ireland.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 44vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.2) 0%, rgba(20,32,26,0.65) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[56px] md:pb-[80px]">
      <p class="eyebrow mb-4" style="color: var(--orange-text);">Immersion English</p>
      <h1 class="text-white mb-6" style="max-width: 16ch;">Insights &amp; perspectives</h1>
      <p class="text-white/75 text-[1rem] md:text-[1.15rem]" style="max-width: 52ch;">Reflections on language learning, teaching, and the role of real communication in building genuine confidence in English.</p>
    </div>
  </section>

  <!-- ARTICLES GRID -->
  <section class="section">
    <div class="container-x">
      <div class="blog-grid">
        {articles.map((article, i) => (
          <a
            href={`/blog/${article.slug}`}
            class="no-underline group trip-card-link blog-card"
            style="display: flex; flex-direction: column; background: white; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;"
          >
            <div style="aspect-ratio: 16/9; overflow: hidden; background: var(--cream);">
              <img
                src={article.image}
                alt={article.imageAlt}
                class="trip-card-img"
                style="width: 100%; height: 100%; object-fit: cover;"
              loading="lazy" />
            </div>
            <div style="padding: 28px 28px 32px; display: flex; flex-direction: column; flex: 1; gap: 12px;">
              <p style="font-size: 0.8rem; color: var(--ink-soft); font-family: 'Montserrat', sans-serif; font-weight: 500;">{article.date} &middot; {article.author}</p>
              <h3 style="font-size: 1.1rem; line-height: 1.3; color: var(--ink);">{article.title}</h3>
              <p style="font-size: 0.95rem; color: var(--ink-soft); line-height: 1.6; flex: 1;">{article.excerpt}</p>
              <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 600; font-family: 'Montserrat', sans-serif; color: var(--green); margin-top: 8px;">
                Read article
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-tinted">
    <div class="container-x" style="max-width: 680px; text-align: center;">
      <p class="eyebrow eyebrow-dot mb-5">Ready to start?</p>
      <h2 class="mb-5">Confident English comes from using it</h2>
      <p style="color: var(--ink-soft); font-size: 1.05rem; margin-bottom: 32px;">Speaking-focused lessons in Sofia and an immersive summer programme in Dublin for teens aged 13–17.</p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a href="/lessons" class="btn btn-primary">
          View our lessons
        </a>
        <a href="/dublin-summer-2027" class="btn btn-ghost">Dublin Summer 2027</a>
      </div>
    </div>
  </section>

</BaseLayout>
