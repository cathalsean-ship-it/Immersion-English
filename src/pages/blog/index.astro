---

<BaseLayout title="Blog | Immersion English" description="Insights from Immersion English – teaching reflections, research, and perspectives on language learning and English education.">

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 44vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.2) 0%, rgba(20,32,26,0.65) 100%);"></div>
    <div class="container-x relative z-10 pt-[120px] pb-[80px]">
      <p class="eyebrow mb-4" style="color: var(--orange);">Immersion English</p>
      <h1 class="text-white mb-6" style="max-width: 16ch;">Insights &amp; ideas</h1>
      <p class="text-white/75 text-[1.15rem]" style="max-width: 52ch;">Reflections on language learning, teaching, and the role of real communication in building genuine confidence in English.</p>
    </div>
  </section>

  <!-- ARTICLES GRID -->
  <section class="section">
    <div class="container-x">
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 32px;">
        {articles.map((article, i) => (
          <a
            href={`/blog/${article.slug}`}
            class="no-underline group"
            style="display: flex; flex-direction: column; background: white; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;"
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 32px rgba(20,32,26,0.09)'; this.style.borderColor='rgba(0,128,55,0.2)'"
            onmouseout="this.style.transform=''; this.style.boxShadow=''; this.style.borderColor='var(--line)'"
          >
            <div style="aspect-ratio: 16/9; overflow: hidden; background: var(--cream);">
              <img
                src={article.image}
                alt={article.imageAlt}
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                onmouseover="this.style.transform='scale(1.03)'"
                onmouseout="this.style.transform=''"
              />
            </div>
            <div style="padding: 28px 28px 32px; display: flex; flex-direction: column; flex: 1; gap: 12px;">
              <p style="font-size: 0.8rem; color: var(--ink-soft); font-family: 'Montserrat', sans-serif; font-weight: 500;">{article.date} &middot; {article.author}</p>
              <h3 style="font-size: 1.1rem; line-height: 1.3; color: var(--ink);">{article.title}</h3>
              <p style="font-size: 0.95rem; color: var(--ink-soft); line-height: 1.6; flex: 1;">{article.excerpt}</p>
              <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 600; font-family: 'Montserrat', sans-serif; color: var(--green); margin-top: 8px;">
                Read article
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-tinted">
    <div class="container-x" style="max-width: 680px; text-align: center;">
      <p class="eyebrow eyebrow-dot mb-5">Ready to start?</p>
      <h2 class="mb-5">Confident English comes from using it</h2>
      <p style="color: var(--ink-soft); font-size: 1.05rem; margin-bottom: 32px;">Speaking-focused lessons in Sofia and an immersive summer programme in Dublin for teens aged 13–17.</p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/lessons" class="btn btn-primary">
          View our lessons
          <span class="btn-arrow"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
        </a>
        <a href="/dublin-summer-2027" class="btn btn-ghost">Dublin Summer 2027</a>
      </div>
    </div>
  </section>

</BaseLayout>
