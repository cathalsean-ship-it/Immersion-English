---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dublin } from '../data/dublin';
---

<BaseLayout ogImage="/og/contact.jpg" title="Contact Us | Free English Consultation | Immersion English" description={`Book a free 20-minute consultation with Immersion English in Sofia. Online English lessons for adults, and a summer group to an international English centre in Dublin for students aged ${dublin.ages.min}–${dublin.ages.max}.`}>

  <!-- HERO (compact) -->
  <section class="relative flex items-center text-white overflow-hidden isolate">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, var(--hero-top) 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        Contact
      </p>
      <h1 class="text-white mb-4">Get in touch.</h1>
      <p class="text-white/80 text-[1.15rem] max-w-[46ch] leading-[1.55]">
        Questions about lessons, the Dublin programme, or anything else – we're happy to hear from you.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Registration process</span>
        <h2>One step to get started.</h2>
        <p>Whether you're joining a course or enquiring about the Dublin Summer Programme, it starts the same way.</p>
      </div>
      <div class="max-w-[62ch] mx-auto">
        <div class="trust-card">
          <span class="font-heading font-bold text-[2rem] leading-none tracking-[-0.03em]" style="color: var(--orange-text);">01</span>
          <h3>Book a free online consultation</h3>
          <p>
            Fill in the booking form below and we'll arrange a 20-minute online meeting to talk
            through your goals, your experience and the options that suit you best. Everything
            else – course details, the registration form and payment instructions – follows by
            email afterwards. No tests, no paperwork before we've spoken.
          </p>
          <div class="mt-5">
            <a href="#booking-form" class="btn btn-primary">Book a free consultation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM + DETAILS -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[5fr_7fr] gap-10 md:gap-16 items-start">

        <!-- LEFT: details -->
        <div>
          <span class="eyebrow eyebrow-dot">How to reach us</span>
          <h2 class="mt-4 mb-6 text-[1.9rem]">We reply within one working day.</h2>

          <div class="flex flex-col gap-0 border-t border-line">
            <a href="mailto:immersionenglish.ie@gmail.com" class="flex gap-4 items-center py-5 border-b border-line no-underline group">
              <div class="w-9 h-9 rounded-full grid place-items-center flex-shrink-0 group-hover:opacity-80 transition-opacity" style="background: var(--green-soft); color: var(--green);"><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg></div>
              <div>
                <div class="text-ink font-medium text-[0.98rem] group-hover:text-brand-green transition-colors">immersionenglish.ie@gmail.com</div>
              </div>
            </a>

            {/* Phone — label + outlined WhatsApp / Viber buttons, same as the homepage */}
            {[
              { label: 'English', raw: '359893387464' },
              { label: 'Български', raw: '359889178100' },
            ].map(({ label, raw }) => (
              <div class="flex gap-4 items-center py-5 border-b border-line">
                <a href={`tel:+${raw}`} aria-label={`Call – ${label}`} title="Call" class="w-9 h-9 rounded-full grid place-items-center flex-shrink-0 no-underline transition-opacity hover:opacity-80" style="background: var(--green-soft); color: var(--green);">
                  <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
                </a>
                <div class="flex-1 min-w-0">
                  <div class="font-heading text-[0.72rem] uppercase tracking-[0.12em] font-semibold text-ink-soft whitespace-nowrap">{label}</div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <a href={`https://wa.me/${raw}`} target="_blank" rel="noopener" aria-label={`WhatsApp – ${label}`} title="WhatsApp"
                     class="w-10 h-10 rounded-full grid place-items-center no-underline transition-opacity hover:opacity-80"
                     style="border: 1.5px solid #25d366; background: transparent;">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 16 16" fill="#25d366">
                    <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
                  </svg>
                  </a>
                  <a href={`viber://chat?number=%2B${raw}`} aria-label={`Viber – ${label}`} title="Viber"
                     class="w-10 h-10 rounded-full grid place-items-center no-underline transition-opacity hover:opacity-80"
                     style="border: 1.5px solid #7360f2; background: transparent;">
                    <svg class="w-[19px] h-[19px]" viewBox="0 0 24 24" fill="#7360f2">
                    <path d="M11.4 0C9.473.028 5.333.344 3.02 2.467 1.302 4.187.696 6.7.633 9.817.57 12.933.488 18.776 6.12 20.36h.003l-.004 2.416s-.037.977.61 1.177c.777.242 1.234-.5 1.98-1.302.407-.44.972-1.084 1.397-1.58 3.85.326 6.812-.416 7.15-.525.776-.252 5.176-.816 5.892-6.657.74-6.02-.36-9.83-2.34-11.546-.596-.55-3.006-2.3-8.375-2.323 0 0-.395-.025-1.037-.017zm.058 1.693c.545-.004.88.017.88.017 4.542.02 6.717 1.388 7.222 1.846 1.675 1.435 2.53 4.868 1.906 9.897v.002c-.604 4.878-4.174 5.184-4.832 5.395-.28.09-2.882.737-6.153.524 0 0-2.436 2.94-3.197 3.704-.12.12-.26.167-.352.144-.13-.033-.166-.188-.165-.414l.02-4.018c-4.762-1.32-4.485-6.292-4.43-8.895.054-2.604.543-4.738 1.996-6.173 1.96-1.773 5.474-2.018 7.11-2.03zm.38 2.602c-.167 0-.303.135-.304.302 0 .167.133.303.3.305 1.624.01 2.946.537 4.028 1.592 1.073 1.046 1.62 2.468 1.633 4.334.002.167.14.3.307.3.166-.002.3-.138.3-.304-.014-1.984-.618-3.596-1.816-4.764-1.19-1.16-2.692-1.753-4.447-1.765zm-3.96.695c-.19-.032-.4.005-.616.117l-.01.002c-.43.247-.816.562-1.146.932-.002.004-.006.004-.008.008-.267.323-.42.638-.46.948-.008.046-.01.093-.007.14 0 .136.022.27.065.4l.013.01c.135.48.473 1.276 1.205 2.604.42.768.903 1.5 1.446 2.186.27.344.56.673.87.984l.132.132c.31.308.64.6.984.87.686.543 1.418 1.027 2.186 1.447 1.328.733 2.126 1.07 2.604 1.206l.01.014c.13.042.265.064.402.063.046.002.092 0 .138-.008.31-.036.627-.19.948-.46.004 0 .003-.002.008-.005.37-.33.683-.72.93-1.148l.003-.01c.225-.432.15-.842-.18-1.12-.004 0-.698-.58-1.037-.83-.36-.255-.73-.492-1.113-.71-.51-.285-1.032-.106-1.248.174l-.447.564c-.23.283-.657.246-.657.246-3.12-.796-3.955-3.955-3.955-3.955s-.037-.426.248-.656l.563-.448c.277-.215.456-.737.17-1.248-.217-.383-.454-.756-.71-1.115-.25-.34-.826-1.033-.83-1.035-.137-.165-.31-.265-.502-.297zm4.49.88c-.158.002-.29.124-.3.282-.01.167.115.312.282.324 1.16.085 2.017.466 2.645 1.15.63.688.93 1.524.906 2.57-.002.168.13.306.3.31.166.003.305-.13.31-.297.025-1.175-.334-2.193-1.067-2.994-.74-.81-1.777-1.253-3.05-1.346h-.024zm.463 1.63c-.16.002-.29.127-.3.287-.008.167.12.31.288.32.523.028.875.175 1.113.422.24.245.388.62.416 1.164.01.167.15.295.318.287.167-.008.295-.15.287-.317-.03-.644-.215-1.178-.58-1.557-.367-.378-.893-.574-1.52-.607h-.018z"/>
                  </svg>
                  </a>
                </div>
              </div>
            ))}

            <a href="https://facebook.com/immersionenglish.ie" target="_blank" rel="noopener noreferrer" class="flex gap-4 items-start py-5 border-b border-line no-underline group">
              <div class="w-9 h-9 rounded-full grid place-items-center flex-shrink-0 text-[1rem] group-hover:opacity-80 transition-opacity" style="background: var(--green-soft); color: var(--green);">f</div>
              <div>
                <div class="font-heading text-[0.72rem] uppercase tracking-[0.12em] mb-[3px] font-semibold text-ink-soft">Facebook</div>
                <div class="text-ink font-medium text-[0.98rem] group-hover:text-brand-green transition-colors">immersionenglish.ie</div>
              </div>
            </a>
          </div>

          {/* The box here promised a pre-departure evening in Sofia where parents meet
              the team in person. That is a UCD-era claim, not in the approved 2027 copy,
              and the offer was withdrawn — it survived on this page only because the
              removal never reached it. Do not reinstate it without confirming the event
              actually happens. It also duplicated supervision copy that the Dublin FAQs
              maintain properly, so this now links there rather than restating it. */}
          <div class="mt-8 bg-cream border border-line rounded-lg p-6">
            <p class="font-heading font-semibold text-ink mb-2">Sending a child to Dublin?</p>
            <p class="text-ink-soft text-[0.92rem] leading-relaxed mb-3">
              A {dublin.secondChaperone?.role.replace('Native ', 'native ')} is with the group
              throughout the stay, so there is always someone to talk to in Bulgarian – for you
              or your child. Supervision, travel and who to ring are all covered in the Dublin FAQs.
            </p>
            <a
              href="/dublin-summer-2027/faqs#supervision-and-safety"
              class="text-[0.9rem] font-heading font-semibold no-underline hover:underline"
              style="color: var(--green);"
            >
              Supervision and safety
            </a>
          </div>
        </div>

        <!-- RIGHT: form -->
        <div id="booking-form" class="bg-white border border-line rounded-lg p-5 md:p-9 shadow-lift" style="scroll-margin-top: 100px;">
          <h3 class="text-[1.45rem] mb-1">Book a free consultation</h3>
          <p class="text-ink-soft text-[0.95rem] mb-7">Tell us a bit about yourself and what you're looking for – we'll come back within one working day to arrange a time.</p>

          <div id="form-success" style="display:none; background: var(--green); color: white; border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 20px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.92rem;">✓ Message sent! We'll be in touch within one working day.</div>
          <form name="individual-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="grid grid-cols-1 sm:grid-cols-2 gap-[14px]">
            <input type="hidden" name="form-name" value="individual-enquiry" />
            <input type="hidden" name="subject" value="[Immersion English] New Individual Enquiry" />
            <!-- Filled from ?from= on the link that brought the visitor here, so each enquiry shows which page and button it came from. -->
            <input type="hidden" name="came-from" value="" />
            <p class="hidden"><input name="bot-field" /></p>
            <div class="flex flex-col gap-[6px]">
              <label for="first-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">First name</label>
              <input id="first-name" name="first-name" type="text" placeholder="Jana" required class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px]">
              <label for="last-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Last name</label>
              <input id="last-name" name="last-name" type="text" placeholder="Georgieva" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] sm:col-span-2">
              <label for="email" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Email</label>
              <input id="email" name="email" type="email" placeholder="jana@example.com" required class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] sm:col-span-2">
              <label for="interest" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">I'm interested in</label>
              <select id="interest" name="interest" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition appearance-none cursor-pointer">
                <option value="">Select a course or programme…</option>
                <option data-key="speak-up">Speak Up! (group speaking course)</option>
                <option data-key="general-english">General English (1:1)</option>
                <option data-key="business-english">Business English (1:1)</option>
                <option data-key="speaking-coach">Personal Speaking Coach (1:1)</option>
                <option data-key="exam-prep">Exam Prep (CAE / IELTS)</option>
                <option data-key="dublin">Dublin Summer 2027</option>
                <option data-key="corporate">Corporate Training</option>
                <option data-key="other">Something else</option>
              </select>
            </div>
            <div class="flex flex-col gap-[6px] sm:col-span-2">
              <label for="message" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us a bit about yourself and what you're looking for…" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition resize-none min-h-[100px]"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="btn btn-primary w-full justify-center">Send message</button>
              <p class="text-center text-ink-soft text-[0.82rem] mt-4">We reply within one working day.</p>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- CORPORATE SIGNPOST -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="rounded-xl overflow-hidden" style="background: linear-gradient(135deg, var(--blue) 0%, #0f5fa3 100%); box-shadow: 0 4px 24px rgba(26,133,214,0.25);">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-0">
          <div class="p-7 md:p-9">
            <span class="eyebrow" style="color: rgba(255,255,255,0.92); letter-spacing: 0.18em; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; font-family: 'Montserrat', sans-serif;">
              <span style="display:inline-block; width:6px; height:6px; background: rgba(255,255,255,0.7); border-radius:50%; margin-right:0.7em; vertical-align:middle; transform:translateY(-2px);"></span>
              Corporate enquiries
            </span>
            <h3 class="mt-3 mb-3" style="color: white;">Looking for Business English training for your team?</h3>
            <p style="color: rgba(255,255,255,0.8); font-size: 0.97rem; line-height: 1.6; max-width: 52ch;">
              We have a dedicated enquiry form for companies and organisations. Tell us about your team and goals – we'll be in touch within one working day to arrange a call.
            </p>
          </div>
          <div class="px-7 pb-7 md:px-9 md:pb-0 md:pr-9">
            <a href="/corporate-training#enquiry" class="btn whitespace-nowrap" style="background: white; color: #0f5fa3; border-color: white; font-weight: 700;">Corporate enquiry form</a>
          </div>
        </div>
      </div>
    </div>
  </section>

<script>
  // Pre-fill the enquiry from the button that brought the visitor here.
  // Links look like /contact?interest=exam-prep&from=lessons-exam-card#booking-form
  // `interest` matches an <option data-key>; `from` is stored in a hidden field.
  // Anything unrecognised is ignored, so the form always works without it.
  (function () {
    const params = new URLSearchParams(location.search);
    const interest = params.get('interest');
    if (interest) {
      const opt = document.querySelector(`#interest option[data-key="${CSS.escape(interest)}"]`);
      if (opt) opt.selected = true;
    }
    const from = params.get('from');
    const field = document.querySelector('input[name="came-from"]');
    if (field && from && /^[a-z0-9-]{1,60}$/.test(from)) field.value = from;
  })();

  // Handle all netlify forms on this page – prevent redirect, show success message
  document.querySelectorAll('form[data-netlify]').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString(),
        });
        // fetch only rejects on network failure, so a 404 or 500 from Netlify
        // would otherwise fall through and show "Message sent!" for a lost enquiry.
        if (!res.ok) throw new Error(`Form POST failed: ${res.status}`);
        // Hide form, show success
        form.style.display = 'none';
        const success = form.previousElementSibling;
        if (success && success.id && success.id.includes('success')) {
          success.style.display = 'block';
        } else {
          // Fallback – insert success message before form
          const msg = document.createElement('div');
          msg.style.cssText = 'background: var(--green); color: white; border-radius: 10px; padding: 16px 20px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.92rem;';
          msg.textContent = "✓ Message sent! We'll be in touch within one working day.";
          form.parentNode.insertBefore(msg, form);
        }
      } catch (err) {
        alert('Something went wrong. Please email us directly at immersionenglish.ie@gmail.com');
      }
    });
  });
</script>
</BaseLayout>
