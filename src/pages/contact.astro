---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dublin } from '../data/dublin';
---

<BaseLayout title="Contact Immersion English Sofia | Book a Free English Consultation" description={`Book a free 20-minute consultation with Immersion English in Sofia. Online English lessons for adults, and a summer group to an international English centre in Dublin for students aged ${dublin.ages.min}–${dublin.ages.max}.`}>

  <!-- HERO (compact) -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 40vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[56px] md:pb-[72px]">
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange-text);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        Contact
      </p>
      <h1 class="text-white mb-4">Get in touch.</h1>
      <p class="text-white/80 text-[1.15rem] max-w-[46ch] leading-[1.55]">
        Questions about lessons, the Dublin programme, or anything else – we're happy to hear from you.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Registration process</span>
        <h2>One step to get started.</h2>
        <p>Whether you're joining a course or enquiring about the Dublin Summer Programme, it starts the same way.</p>
      </div>
      <div class="max-w-[62ch] mx-auto">
        <div class="trust-card">
          <span class="font-heading font-bold text-[2rem] leading-none tracking-[-0.03em]" style="color: var(--orange-text);">01</span>
          <h3>Book a free online consultation</h3>
          <p>
            Fill in the booking form below and we'll arrange a 20-minute online meeting to talk
            through your goals, your experience and the options that suit you best. Everything
            else – course details, the registration form and payment instructions – follows by
            email afterwards. No tests, no paperwork before we've spoken.
          </p>
          <div class="mt-5">
            <a href="#booking-form" class="btn btn-primary">Book a free consultation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM + DETAILS -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[5fr_7fr] gap-10 md:gap-16 items-start">

        <!-- LEFT: details -->
        <div>
          <span class="eyebrow eyebrow-dot">How to reach us</span>
          <h2 class="mt-4 mb-6 text-[1.9rem]">We reply within one working day.</h2>

          <div class="flex flex-col gap-0 border-t border-line">
            {[
              { label: 'Email', value: 'immersionenglish.ie@gmail.com', icon: '✉', href: 'mailto:immersionenglish.ie@gmail.com' },
              { label: 'Phone (English)', value: '+359 893 387 464', icon: '📞', href: 'tel:+359893387464' },
              { label: 'Phone (Bulgarian)', value: '+359 889 178 100', icon: '📞', href: 'tel:+359889178100' },
              { label: 'Facebook', value: 'immersionenglish.ie', icon: 'f', href: 'https://facebook.com/immersionenglish.ie' },
            ].map(({ label, value, icon, href }) => (
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="flex gap-4 items-start py-5 border-b border-line no-underline group"
              >
                <div class="w-9 h-9 rounded-full grid place-items-center flex-shrink-0 text-[1rem] group-hover:opacity-80 transition-opacity" style="background: var(--green-soft); color: var(--green);">{icon}</div>
                <div>
                  <div class="font-heading text-[0.72rem] uppercase tracking-[0.12em] mb-[3px] font-semibold text-ink-soft">{label}</div>
                  <div class="text-ink font-medium text-[0.98rem] group-hover:text-brand-green transition-colors">{value}</div>
                </div>
              </a>
            ))}
          </div>

          <div class="mt-8 bg-cream border border-line rounded-lg p-6">
            <p class="font-heading font-semibold text-ink mb-2">Pastoral support for Dublin Summer 2027</p>
            <p class="text-ink-soft text-[0.92rem] leading-relaxed">Before departure, you'll meet Lenny and our Bulgarian-speaking team member in person at a pre-departure evening in Sofia. During the programme, our Bulgarian-speaking staff member is available throughout for any questions or concerns – from you or your child.</p>
          </div>
        </div>

        <!-- RIGHT: form -->
        <div id="booking-form" class="bg-white border border-line rounded-lg p-5 md:p-9 shadow-lift" style="scroll-margin-top: 100px;">
          <h3 class="text-[1.45rem] mb-1">Book a free consultation</h3>
          <p class="text-ink-soft text-[0.95rem] mb-7">Tell us a bit about yourself and what you're looking for – we'll come back within one working day to arrange a time.</p>

          <div id="form-success" style="display:none; background: var(--green); color: white; border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 20px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.92rem;">✓ Message sent! We'll be in touch within one working day.</div>
          <form name="individual-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="grid grid-cols-1 sm:grid-cols-2 gap-[14px]">
            <input type="hidden" name="form-name" value="individual-enquiry" />
            <input type="hidden" name="subject" value="[Immersion English] New Individual Enquiry" />
            <p class="hidden"><input name="bot-field" /></p>
            <div class="flex flex-col gap-[6px]">
              <label for="first-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">First name</label>
              <input id="first-name" name="first-name" type="text" placeholder="Jana" required class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px]">
              <label for="last-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Last name</label>
              <input id="last-name" name="last-name" type="text" placeholder="Georgieva" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] col-span-2">
              <label for="email" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Email</label>
              <input id="email" name="email" type="email" placeholder="jana@example.com" required class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] col-span-2">
              <label for="interest" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">I'm interested in</label>
              <select id="interest" name="interest" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition appearance-none cursor-pointer">
                <option value="">Select a course or programme…</option>
                <option>Speak Up! (group speaking course)</option>
                <option>General English (1:1)</option>
                <option>Business English (1:1)</option>
                <option>Personal Speaking Coach (1:1)</option>
                <option>Exam Prep (CAE / IELTS)</option>
                <option>Dublin Summer 2027</option>
                <option>Corporate Training</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="flex flex-col gap-[6px] col-span-2">
              <label for="message" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us a bit about yourself and what you're looking for…" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition resize-none min-h-[100px]"></textarea>
            </div>
            <div class="col-span-2">
              <button type="submit" class="btn btn-primary w-full justify-center">Send message</button>
              <p class="text-center text-ink-soft text-[0.82rem] mt-4">We reply within one working day.</p>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- CORPORATE SIGNPOST -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="rounded-xl overflow-hidden" style="background: linear-gradient(135deg, #1a85d6 0%, #0f5fa3 100%); box-shadow: 0 4px 24px rgba(26,133,214,0.25);">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-0">
          <div class="p-7 md:p-9">
            <span class="eyebrow" style="color: rgba(255,255,255,0.7); letter-spacing: 0.18em; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; font-family: 'Montserrat', sans-serif;">
              <span style="display:inline-block; width:6px; height:6px; background: rgba(255,255,255,0.7); border-radius:50%; margin-right:0.7em; vertical-align:middle; transform:translateY(-2px);"></span>
              Corporate enquiries
            </span>
            <h3 class="mt-3 mb-3" style="color: white;">Looking for Business English training for your team?</h3>
            <p style="color: rgba(255,255,255,0.8); font-size: 0.97rem; line-height: 1.6; max-width: 52ch;">
              We have a dedicated enquiry form for companies and organisations. Tell us about your team and goals – we'll put together a tailored programme proposal within one working day.
            </p>
          </div>
          <div class="px-7 pb-7 md:px-9 md:pb-0 md:pr-9">
            <a href="/corporate-training#enquiry" class="btn whitespace-nowrap" style="background: white; color: #0f5fa3; border-color: white; font-weight: 700;">Corporate enquiry form</a>
          </div>
        </div>
      </div>
    </div>
  </section>

<script>
  // Handle all netlify forms on this page – prevent redirect, show success message
  document.querySelectorAll('form[data-netlify]').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString(),
        });
        // fetch only rejects on network failure, so a 404 or 500 from Netlify
        // would otherwise fall through and show "Message sent!" for a lost enquiry.
        if (!res.ok) throw new Error(`Form POST failed: ${res.status}`);
        // Hide form, show success
        form.style.display = 'none';
        const success = form.previousElementSibling;
        if (success && success.id && success.id.includes('success')) {
          success.style.display = 'block';
        } else {
          // Fallback – insert success message before form
          const msg = document.createElement('div');
          msg.style.cssText = 'background: var(--green); color: white; border-radius: 10px; padding: 16px 20px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.92rem;';
          msg.textContent = "✓ Message sent! We'll be in touch within one working day.";
          form.parentNode.insertBefore(msg, form);
        }
      } catch (err) {
        alert('Something went wrong. Please email us directly at immersionenglish.ie@gmail.com');
      }
    });
  });
</script>
</BaseLayout>
