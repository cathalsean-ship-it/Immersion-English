---
import BaseLayout from '../layouts/BaseLayout.astro';
// Prices come from the data file so this page and /llms.txt cannot disagree.
// Do not type a figure into the markup below — change src/data/courses.ts.
import { courses } from '../data/courses';
---

<BaseLayout
  title="English Lessons in Sofia, Bulgaria | Online Speaking Courses | Immersion English"
  description="Online English lessons with a CELTA-qualified native teacher in Sofia, Bulgaria. Group speaking courses, 1:1 coaching, and Cambridge CAE & IELTS exam preparation. B1 and above. Онлайн уроци по английски език в София с носител на езика."
  ogImage="/lessons-hero.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 54vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
        <div>
          <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
            Online English lessons
          </p>
          <h1 class="text-white mb-5" style="max-width: 18ch;">
            English lessons that make you <span style="color: var(--orange-text);">speak</span> – from day one.
          </h1>
          <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55] mb-8">
            Taught online by a CELTA-qualified native teacher. Small groups or 1:1. Every lesson is built around real communication – not grammar drills.
          </p>
          <a href="/contact" class="btn btn-primary">Book a free consultation</a>
        </div>
        <!-- Quick stats -->
        <div class="hidden md:grid grid-cols-2 gap-4">
          <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px;">
            <p class="font-heading font-bold text-[1.6rem] text-white leading-none mb-1">10+</p>
            <p class="text-[0.82rem] text-white/65 font-heading font-semibold">Years of experience</p>
          </div>
          <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px;">
            <p class="font-heading font-bold text-[1.6rem] text-white leading-none mb-1">Native</p>
            <p class="text-[0.82rem] text-white/65 font-heading font-semibold">English teacher from Ireland</p>
          </div>
          <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px;">
            <p class="font-heading font-bold text-[1.6rem] text-white leading-none mb-1">Individual</p>
            <p class="text-[0.82rem] text-white/65 font-heading font-semibold">& group lessons</p>
          </div>
          <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px;">
            <p class="font-heading font-bold text-[1.6rem] text-white leading-none mb-1">B1+</p>
            <p class="text-[0.82rem] text-white/65 font-heading font-semibold"><a href="/blog/cefr-what-your-english-level-really-tells-you-and-what-it-doesnt" style="color: rgba(255,255,255,0.65); text-decoration: underline; text-underline-offset: 2px;">on the CEFR scale</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COURSES -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Our courses</span>
        <h2>Five ways to build confident English.</h2>
        <p>Group courses, 1:1 coaching, General English, Business English and exam preparation. <span style="color: var(--ink); font-weight: 600;">Every course is built around one goal: using English with real confidence.</span></p>
      </div>

      <!-- Featured card: Speak Up! -->
      <div class="mb-6 rounded-xl overflow-hidden shadow-lift" style="border: 2px solid var(--orange); background: white;">
        <div style="background: var(--orange); padding: 8px 20px; display: flex; align-items: center; gap: 10px;">
          <span style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: white;">★ Most popular</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr_auto] gap-8 p-8 md:p-10 items-start">
          <!-- Left: title + desc -->
          <div>
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full mb-4 inline-block" style="background: var(--green-soft); color: var(--green);">Groups of 8</span>
            <h2 class="text-[1.6rem] mb-2" style="margin-top: 8px;">Speak Up!</h2>
            <div style="width: 36px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 16px;"></div>
            <p class="text-ink-soft text-[1rem] leading-relaxed">
              Our structured group speaking programme. Express ideas clearly, interact confidently, and start <em>thinking</em> in English – not translating.
            </p>
          </div>
          <!-- Middle: what's included -->
          <ul class="flex flex-col gap-2 text-[0.9rem] text-ink-soft">
            {[
              '12 lessons over 6 weeks',
              '90-minute lessons, online',
              'Groups of 8 students',
              'Weekly skill focus: opinion, storytelling, debate',
              'End-of-programme feedback report',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[6px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
            <li class="flex items-start gap-2">
              <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[6px]" style="background: var(--orange);"></span>
              Level: B1 and above
            </li>
          </ul>
          <!-- Right: price + CTA -->
          <div class="flex flex-col gap-4 min-w-[180px]">
            <div style="background: var(--cream); border-radius: 10px; padding: 20px 24px; text-align: center;">
              <p class="font-heading font-bold text-[2rem] text-ink leading-none">€{courses.speakUp.total}</p>
              <p class="text-ink-soft text-[0.82rem] mt-1">per course</p>
              <p class="text-ink-soft text-[0.75rem] mt-1">€{courses.speakUp.perLesson} per lesson</p>
            </div>
            <a href="/contact" class="btn btn-primary text-center justify-center">Reserve a spot</a>
            <p class="text-[0.75rem] text-ink-soft text-center">All materials included</p>
          </div>
        </div>
      </div>

      <!-- Two smaller cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <!-- Personal Speaking Coach -->
        <div class="bg-white border border-line rounded-xl p-7 flex flex-col shadow-soft">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: #e8f0fe; color: #3b5bdb;">Individual</span>
          </div>
          <h3 class="text-[1.2rem] mb-2">Personal Speaking Coach</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            Personalised 1:1 coaching built around you – your goals, your schedule, your pace. Ideal for professionals, frequent travellers, or anyone who wants faster, focused progress.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              '90-minute online sessions',
              'Flexible schedule – book around your availability',
              'Targeted feedback every session',
              'Focus areas: confidence, fluency, business English, interviews',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
            <li class="flex items-start gap-2">
              <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[6px]" style="background: var(--orange);"></span>
              Level: B1 and above
            </li>
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">€{courses.personalSpeakingCoach.perLesson} <span class="text-[0.85rem] font-normal text-ink-soft">per lesson</span></p>
            <div class="flex gap-4 mt-2 flex-wrap">
              <p class="text-[0.82rem] text-ink-soft">5 lessons: <strong class="text-ink">€{courses.personalSpeakingCoach.bundles[0].price}</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]"> save {courses.personalSpeakingCoach.bundles[0].savePercent}%</span></p>
              <p class="text-[0.82rem] text-ink-soft">10 lessons: <strong class="text-ink">€{courses.personalSpeakingCoach.bundles[1].price}</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]"> save {courses.personalSpeakingCoach.bundles[1].savePercent}%</span></p>
            </div>
          </div>
        </div>

        <!-- Exam Prep -->
        <div class="bg-white border border-line rounded-xl p-7 flex flex-col shadow-soft">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: #e8f0fe; color: #3b5bdb;">Individual</span>
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: var(--green-soft); color: var(--green);">Group</span>
          </div>
          <h3 class="text-[1.2rem] mb-2">Exam Preparation</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            For students who know English but need to perform under exam conditions. <strong style="color: var(--ink);">Cambridge CAE</strong> and <strong style="color: var(--ink);">IELTS</strong> specialists. We focus on how to answer – not what to memorise.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              'Real speaking and writing tasks – not drills',
              'Clear exam strategy and structure',
              'Targeted, personalised feedback',
              'Build confidence and natural fluency',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
            <li class="flex items-start gap-2">
              <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[6px]" style="background: var(--orange);"></span>
              Level: B1 and above
            </li>
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">€{courses.examPreparation.perLesson} <span class="text-[0.85rem] font-normal text-ink-soft">per lesson</span></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- GENERAL ENGLISH + BUSINESS ENGLISH -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">1:1 lessons</span>
        <h2>Focused. Flexible. <span style="color: var(--orange-text);">Personal.</span></h2>
        <p>Can't find a group course that fits your schedule or goals? Our 1:1 lessons are built entirely around you – your level, your pace, your priorities.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <!-- General English -->
        <div class="bg-white border border-line rounded-xl p-7 flex flex-col shadow-soft">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: #e8f0fe; color: #3b5bdb;">Individual</span>
          </div>
          <h3 class="text-[1.2rem] mb-2">General English</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            Well-rounded 1:1 lessons that build real confidence across all four skills – speaking, listening, reading, and writing. Tailored entirely to your level, pace, and goals.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              '90-minute online sessions',
              'All skills: speaking, listening, reading, writing',
              'Grammar and vocabulary in context – not in isolation',
              'Flexible schedule – book around your availability',
              'Targeted feedback every session',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
            <li class="flex items-start gap-2">
              <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[6px]" style="background: var(--orange);"></span>
              Level: B1 and above
            </li>
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">€{courses.generalEnglish.perLesson} <span class="text-[0.85rem] font-normal text-ink-soft">per lesson</span></p>
            <div class="flex gap-4 mt-2 flex-wrap">
              <p class="text-[0.82rem] text-ink-soft">5 lessons: <strong class="text-ink">€{courses.generalEnglish.bundles[0].price}</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]"> save {courses.generalEnglish.bundles[0].savePercent}%</span></p>
              <p class="text-[0.82rem] text-ink-soft">10 lessons: <strong class="text-ink">€{courses.generalEnglish.bundles[1].price}</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]"> save {courses.generalEnglish.bundles[1].savePercent}%</span></p>
            </div>
          </div>
        </div>

        <!-- Business English — Individual -->
        <div class="bg-white border border-line rounded-xl p-7 flex flex-col shadow-soft">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: var(--green-soft); color: var(--green);">Individual</span>
          </div>
          <h3 class="text-[1.2rem] mb-2">Business English</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            For professionals investing in themselves. You choose the focus, the pace, and what you want to improve. Practical and communicative – every lesson is immediately useful at work.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              'Meetings, presentations, and negotiations',
              'Professional writing: emails, reports, proposals',
              'CV and interview preparation',
              'Industry-specific vocabulary and communication',
              'Flexible – book around your own schedule',
              'Level: B1 and above',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">€{courses.businessEnglish.perLesson} <span class="text-[0.85rem] font-normal text-ink-soft">per lesson</span></p>
            <div class="flex gap-4 mt-2 flex-wrap">
              <p class="text-[0.82rem] text-ink-soft">5 lessons: <strong class="text-ink">€{courses.businessEnglish.bundles[0].price}</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]"> save {courses.businessEnglish.bundles[0].savePercent}%</span></p>
              <p class="text-[0.82rem] text-ink-soft">10 lessons: <strong class="text-ink">€{courses.businessEnglish.bundles[1].price}</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]"> save {courses.businessEnglish.bundles[1].savePercent}%</span></p>
            </div>
          </div>
        </div>

        <!-- Business English — Corporate -->
        <div class="bg-white rounded-xl p-7 flex flex-col shadow-soft" style="border: 1.5px solid #1a85d6;">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: #e8f0fe; color: #1a85d6;">Corporate</span>
          </div>
          <h3 class="text-[1.2rem] mb-2">Business English for Teams</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            Tailored Business English programmes for companies and teams in Sofia. Built around your industry, your goals, and the real situations your people face every day – 1:1 or small groups.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              '1:1 coaching for senior employees and managers',
              'Small group training for teams (up to 6)',
              "Built around your team's actual roles and goals",
              'Real workplace scenarios and role plays',
              'Monthly invoicing and flexible scheduling',
              'Native teacher with British Council background',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">Custom pricing</p>
            <p class="text-[0.82rem] text-ink-soft mt-1">Based on format, group size, and programme length.</p>
            <a href="/corporate-training" class="btn mt-4 inline-flex" style="background: #1a85d6; color: white; border: none; font-size: 0.88rem; padding: 10px 20px; border-radius: 8px; font-family: Montserrat, sans-serif; font-weight: 700; text-decoration: none;">View corporate training</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">

        <!-- Left: content -->
        <div>
          <span class="eyebrow eyebrow-dot">How it works</span>
          <h2 class="mt-4 mb-3">Simple to start.<br/><span style="color: var(--orange-text);">Effective</span> from lesson one.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-10">
            No placement tests. No lengthy forms. Just a free 20-minute conversation – and you're on your way.
          </p>
          <ol class="flex flex-col gap-8">
            {[
              { n: '01', title: 'Free consultation', body: 'We meet online to understand your goals, level, and which course suits you best. No pressure, no obligation – just an honest conversation.' },
              { n: '02', title: 'Choose your course', body: 'We recommend the best fit and confirm your place once the registration form and course fee are received.' },
              { n: '03', title: 'Start speaking', body: 'From your very first lesson, you\'ll be using English – not just studying it. Progress you can feel from day one.' },
            ].map(({ n, title, body }) => (
              <li class="flex gap-5 items-start">
                <span class="font-heading font-bold text-[1.5rem] leading-none flex-shrink-0 mt-1" style="color: var(--orange-text);">{n}</span>
                <div>
                  <p class="font-heading font-semibold text-[1.05rem] text-ink mb-1">{title}</p>
                  <p class="text-ink-soft text-[0.95rem] leading-relaxed">{body}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="mt-10">
            <a href="/contact" class="btn btn-primary">Book a free consultation</a>
          </div>
        </div>

        <!-- Right: photo -->
        <div class="rounded-xl overflow-hidden relative" style="min-height: 400px;">
          <img
            src="/lessons-hero.webp"
            alt="English lesson in progress"
            class="img-greyscale no-hover-reveal w-full h-full object-cover"
            id="lessons-hero-img"
            style="min-height: 400px;"
            loading="lazy"
          />
          <!-- Subtle orange tint overlay -->
          <div class="absolute inset-0 rounded-xl pointer-events-none" style="background: rgba(200, 90, 10, 0.08); mix-blend-mode: multiply;"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY IMMERSION ENGLISH – horizontal list instead of card grid -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-8 md:gap-20 items-start">
        <div class="md:sticky md:top-[90px]">
          <span class="eyebrow eyebrow-dot">Why choose us</span>
          <h2 class="mt-4 mb-5">Not another English course.</h2>
          <p class="text-ink-soft leading-relaxed mb-6">Every lesson is built around real communication – because that's the only way to build real confidence.</p>
          <a href="/about" class="inline-flex items-center gap-3 no-underline group" style="color: var(--ink-soft);">
            <span class="w-8 h-[1.5px] inline-block" style="background: var(--orange);"></span>
            <span class="font-heading font-semibold text-[0.9rem] tracking-wide group-hover:text-brand-green transition-colors">Meet the teacher</span>
          </a>

          <!-- Lenny bio -->
          <div class="mt-8 pt-8 border-t border-line">
            <div class="flex items-center gap-4 mb-4">
              <img src="/team-lenny.webp" alt="Cathal (Lenny) Leonard" class="rounded-full object-cover flex-shrink-0" style="width: 64px; height: 64px;" />
              <div>
                <p class="font-heading font-bold text-ink text-[1rem] mb-0.5">Cathal (Lenny) Leonard</p>
                <p class="text-[0.82rem] font-heading font-semibold tracking-wide uppercase" style="color: var(--orange-text);">Founder & Teacher</p>
              </div>
            </div>
            <p class="text-ink-soft text-[0.9rem] leading-relaxed">
              Lenny is a native English speaker from Ireland, Cambridge CELTA-qualified, with over 10 years of teaching experience. He has taught General English and Business English at the British Council Sofia, and led international summer programmes in Oxford and Cambridge.
            </p>
            <p class="text-ink-soft text-[0.9rem] leading-relaxed mt-3">
              With a diverse educational background and broad life experience, Lenny brings genuine range to every lesson – so conversation never feels forced or repetitive.
            </p>
            <p class="text-ink-soft text-[0.9rem] leading-relaxed mt-3">
              His teaching philosophy is simple: the fastest way to improve your English is to use it – from lesson one.
            </p>
          </div>
        </div>
        <div class="flex flex-col divide-y divide-line">
          {[
            { title: 'Built around you', body: 'Every lesson is tailored to your level, goals, and interests – whether that\'s career progression, exam prep, or simply feeling more confident in everyday English.' },
            { title: 'Wide conversational range', body: "Lenny's diverse educational background and life experience mean lessons can go wherever your interests take them – from business and current affairs to culture, travel, and beyond." },
            { title: 'Speaking from day one', body: 'Every lesson prioritises active speaking. You leave each session having used English – not just studied it.' },
