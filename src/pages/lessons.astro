---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="English Lessons" description="Speaking-focused online English lessons in small groups or 1-to-1. Speak Up, Personal Coaching, and Exam Prep courses.">

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 54vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[120px] pb-[80px]">
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        Our lessons
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Speaking-focused English<br />for confident,
        <span style="color: var(--orange);">real-life</span> communication.
      </h1>
      <p class="text-white/80 text-[1.15rem] max-w-[52ch] leading-[1.55]">
        All sessions are taught online, in small groups or individually, with a strong focus on speaking. Fees include all learning materials.
      </p>
    </div>
  </section>

  <!-- COURSES -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Our courses</span>
        <h2>The right programme for your level and goals.</h2>
        <p>Every course focuses on speaking with accuracy and confidence, developing natural fluency, and using English for real purposes.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

        <!-- Speak Up! -->
        <div class="trust-card relative">
          <span class="absolute top-5 right-5 text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: var(--green-soft); color: var(--green);">
            Most popular
          </span>
          <div class="trust-icon text-[1.4rem]">◉</div>
          <h3>Speak Up!</h3>
          <p>Our structured group speaking programme is focused on expressing ideas clearly, interacting confidently, and thinking in English.</p>
          <ul class="flex flex-col gap-2 mt-2 text-[0.88rem] text-ink-soft">
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> 12 lessons over 6 weeks</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> 90-minute lessons</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Online, Tuesdays & Thursdays 19:00–20:30</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Maximum 8 students</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Weekly skill focus (opinion, storytelling, debate…)</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> B2 and above</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> End-of-programme feedback report</li>
          </ul>
          <p class="text-[0.82rem] font-heading font-bold tracking-[0.06em] pt-5 mt-auto border-t border-line text-ink text-[1.1rem]">
            €290 per course
          </p>
        </div>

        <!-- Personal Speaking Coach -->
        <div class="trust-card relative">
          <div class="trust-icon text-[1.4rem]">◈</div>
          <h3>Personal Speaking Coach</h3>
          <p>Personalised 1:1 speaking coaching for learners who need faster progress tailored to their individual goals and needs.</p>
          <ul class="flex flex-col gap-2 mt-2 text-[0.88rem] text-ink-soft">
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> 90-minute online sessions</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Minimum 3 lessons</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Flexible schedule around your availability</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Personal speaking diagnosis</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Targeted feedback and coaching</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Flexible focus: confidence, fluency, interviews</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> B2 and above</li>
          </ul>
          <div class="pt-5 mt-auto border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.1rem]">€45 per lesson</p>
            <p class="text-[0.82rem] text-ink-soft mt-1">5 lessons: €215 <span class="text-brand-green font-semibold">(save 5%)</span></p>
            <p class="text-[0.82rem] text-ink-soft">10 lessons: €405 <span class="text-brand-green font-semibold">(save 10%)</span></p>
          </div>
        </div>

        <!-- Exam Prep -->
        <div class="trust-card">
          <div class="trust-icon text-[1.4rem]">◎</div>
          <h3>Exam Prep</h3>
          <p>1:1 speaking-focused exam preparation for students who know English but need to perform confidently under exam conditions – Cambridge CAE, IELTS, and more.</p>
          <ul class="flex flex-col gap-2 mt-2 text-[0.88rem] text-ink-soft">
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> 12 lessons over 6 weeks</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> 90-minute online lessons</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Real speaking tasks + targeted feedback</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Exam strategy, not memorised scripts</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> Lots of speaking practice – natural fluency, less fear</li>
            <li class="flex items-start gap-2"><span style="color:var(--green); flex-shrink:0;">✓</span> B2 and above</li>
          </ul>
          <p class="text-[0.82rem] font-heading font-bold tracking-[0.06em] pt-5 mt-auto border-t border-line text-ink text-[1.1rem]">
            €45 per lesson
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot">Our approach</span>
          <h2 class="mt-4 mb-5">Speaking with confidence starts on day one.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-10">
            We focus on clear communication, natural fluency, and effective strategies – not memorised scripts or passive grammar drills. You'll leave every lesson having actually used English.
          </p>
          <ol class="flex flex-col gap-8">
            {[
              { n: '01', title: 'Free consultation', body: 'We meet online to discuss your goals, experience, and which course suits you best. No pressure, no obligation.' },
              { n: '02', title: 'Level check (Exam Prep)', body: 'For Exam Prep students, we send a short online level check to place you accurately and personalise the programme.' },
              { n: '03', title: 'Start your course', body: "Your place is confirmed once we've received your registration form and course fee. Then we get started." },
            ].map(({ n, title, body }) => (
              <li class="flex gap-6 items-start">
                <span class="font-heading font-bold text-[1.5rem] leading-none tracking-[-0.03em] flex-shrink-0 mt-1" style="color: var(--orange);">{n}</span>
                <div>
                  <p class="font-heading font-semibold text-[1.08rem] text-ink mb-1">{title}</p>
                  <p class="text-ink-soft text-[0.97rem] leading-relaxed">{body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div
          class="rounded-md overflow-hidden shadow-lift aspect-[4/5]"
          style="background: repeating-linear-gradient(135deg, rgba(20,32,26,0.04) 0 2px, transparent 2px 14px), #d6e0d9;"
        ></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="eyebrow eyebrow-dot">Ready to start?</span>
          <h2 class="mt-4 mb-4">Not sure which course is right for you?</h2>
          <p style="color: rgba(254,255,254,0.74);">Book a free 20-minute online consultation with Lenny and we'll help you find the perfect fit.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 md:justify-end">
          <a href="/contact" class="btn btn-primary">
            Book a free consultation
            <span class="btn-arrow">→</span>
          </a>
          <a href="/dublin-summer-2027" class="btn btn-ghost text-white border-white/30 hover:border-white">
            Dublin Summer 2027
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
