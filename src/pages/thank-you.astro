---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank you | Immersion English"
  description="We've received your enquiry and will be in touch within one working day."
>
  <section class="relative flex items-center justify-center text-white overflow-hidden isolate" style="min-height: 80vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="container-x relative z-10 text-center py-20">
      <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h1 class="text-white mb-5" style="max-width: 18ch; margin-left: auto; margin-right: auto;">Thank you – we'll be in touch.</h1>
      <p class="text-white/75 text-[1.05rem] leading-relaxed mb-10" style="max-width: 44ch; margin-left: auto; margin-right: auto;">
        We've received your enquiry and will get back to you within one working day.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/lessons" class="btn btn-ghost text-white border-white/30 hover:border-white">View our courses</a>
      </div>
    </div>
  </section>
</BaseLayout>
