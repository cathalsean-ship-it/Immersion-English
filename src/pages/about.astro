---
import BaseLayout from '../layouts/BaseLayout.astro';

const testimonials = [
  {
    quote: "Lenny is the most motivational English teacher I've ever met! His way of teaching involves so many kinds of innovative methods that you'll be studying in an atmosphere of fun, professionalism and individual attention on your own needs. I strongly recommend!",
    name: 'Natalya Baleva',
  },
  {
    quote: "Lenny is a great teacher and he helped me to learn and start using English as I wanted. I like his style of teaching – he involves grammar, vocabulary and exercises while we are chatting, reading and discussing daily topics. Highly recommend!",
    name: 'Dobromira Kozhuharova',
  },
  {
    quote: "If you can read this – perhaps you know some English. But if you want to experience the real beauty and pleasure of being fluent, you need Lenny! With his professionalism and charm he can easily turn this educational journey into a pure joy.",
    name: 'Petia Aranudova',
  },
  {
    quote: "I always knew my puzzle of English knowledge had missing pieces, but was sure I was too old to add them. Lenny's teaching not only helped me to learn and remember without knowing how, but also to become more confident in conversations. Very fast, attending the course became a breath of fresh air after a long working day.",
    name: 'Zornitsa Dermendzhieva-Stoynova',
  },
];
---

<BaseLayout
  title="About Us | CELTA-qualified Teacher in Sofia | Immersion English"
  description="Meet the team behind Immersion English: an Irish CELTA-qualified teacher based in Sofia, Bulgaria, and the people who take a summer group of teenagers from Sofia to Dublin."

  ogImage="/og/about.jpg"
  ogTitle="Meet the team behind Immersion English"
  ogImageAlt="Cathal (Lenny) Leonard, Irish CELTA-qualified English teacher and founder of Immersion English"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, var(--hero-top) 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        About us
      </p>
      {/* No dash between the two lines. It read "Immersion English –" with a
          <br /> after it, and at phone widths the line wrapped before the dash
          got there, stranding it alone on its own line. The break and the
          colour change already separate the name from the tagline. */}
      <h1 class="text-white mb-5 max-w-[16ch]">
        Immersion English<br />
        <span style="color: var(--orange);">English. For Living.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[52ch] leading-[1.55]">
        We're a small team in Sofia, and we teach English the way people actually use it: by speaking it.
      </p>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20 items-center">
        {/* Decorative only: hidden on phones so the team bios come up sooner,
            and cropped wide on larger screens to match the text height. */}
        <div class="hidden md:block rounded-md overflow-hidden shadow-lift">
          <img
            src="/teens-cafe.webp"
            alt="Two students chatting and laughing over drinks in a café"
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 16/9; object-position: center; display: block;"
          loading="lazy" />
        </div>
        <div>
          <span class="eyebrow eyebrow-dot">Who we are</span>
          {/* No heading here on purpose. This section used to carry "Where
              learning connects with your life." — a "where" sentence under a
              "who" label — and the paragraph below already answers the eyebrow
              directly and better than a heading did. The mt-5 on that paragraph
              replaces the spacing the h2 used to provide. */}
          <p class="mt-5 text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Immersion English was set up in Sofia by Lenny, an Irish CELTA-qualified teacher, and Lina, who has worked in international education for over a decade. We started it because we both believe the same thing: you get better at English by using it.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch]">
            We teach adults and teenagers who need English for exams, for work or for life abroad. Every course is planned around the student's goals and level.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Our team</span>
        <h2>Who you'll <span style="color: var(--orange-text);">work with</span>.</h2>
        <p>There are three of us.</p>
      </div>

      <!-- Lenny – featured founder layout -->
      <div class="grid grid-cols-1 md:grid-cols-[340px_1fr] gap-8 md:gap-16 items-start mb-16">
        <div style="position: relative;">
          <div class="rounded-lg overflow-hidden shadow-lift" style="border: 1px solid var(--line);">
            <img
              src="/team-lenny.webp"
              alt="Cathal Leonard – Founder and Senior English Teacher at Immersion English"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            loading="lazy" />
          </div>
          <!-- Founder badge -->
          <div style="position: absolute; bottom: -16px; left: 24px; background: var(--green); color: white; border-radius: 8px; padding: 8px 16px; box-shadow: 0 4px 16px rgba(20,32,26,0.2);">
            <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">Founder</p>
          </div>
        </div>
        <div class="pt-2 md:pt-4">
          <p class="font-heading font-bold text-[1.5rem] text-ink mb-1">Cathal (Lenny) Leonard</p>
          <p class="text-[0.9rem] font-semibold mb-6" style="color: var(--green);">Founder · Senior English Teacher · CELTA-qualified · British Council ESAT-J Examiner</p>
          <div style="width: 40px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 24px;"></div>
          <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
            Lenny is a native English speaker from Ireland and CELTA-qualified teacher with over ten years of experience working with teenage and adult learners. He is the founder of Immersion English and taught General English and Business English at the British Council in Sofia for 10 years. He has also led international summer programmes in Oxford and Cambridge.
          </p>
          <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
            Lenny specialises in exam preparation, particularly Cambridge C1 Advanced (CAE) and IELTS, as well as speaking-focused general English and professional communication. He holds a BA in History, Sociology and Politics from the National University of Ireland, Galway (NUI Galway) and an MA in International Relations from Queen's University Belfast.
          </p>
          <p class="text-ink-soft text-[1.02rem] leading-relaxed">
            His lessons are lively and focused, and there's usually a good bit of laughing.
          </p>
        </div>
      </div>

      <!-- Lina & Lia – same layout as Lenny but smaller -->
      <div class="flex flex-col gap-12" style="padding-top: 48px; border-top: 1px solid var(--line);">

        <!-- Lina -->
        <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-6 md:gap-10 items-start">
          <div class="rounded-lg overflow-hidden shadow-soft flex-shrink-0" style="border: 1px solid var(--line);">
            <img
              src="/team-lina.webp"
              alt="Lina Georgieva – Co-founder of the Immersion English Dublin Summer Programme"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            loading="lazy" />
          </div>
          <div class="min-w-0 overflow-hidden">
            <p class="font-heading font-bold text-[1.2rem] text-ink mb-1">Lina Georgieva</p>
            <p class="text-[0.85rem] font-semibold mb-3" style="color: var(--green);">Co-founder, Dublin Summer Programme · Marketing & Business Development Manager</p>
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 16px;"></div>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              Lina is the co-founder of the Immersion English Dublin Summer Programme. She has over a decade of international experience in education, communications and marketing, and has shaped the programme from the start.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              A graduate of Hunter College, City University of New York (BA in Film and Media Studies), Lina works as Global Capability Development Manager at the British Council.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed">
              A native speaker of both Bulgarian and English, Lina is also a certified yoga teacher. The Dublin programme brings together her interests in language, culture and travel.
            </p>
          </div>
        </div>

        <!-- Lia -->
        <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-6 md:gap-10 items-start">
          <div class="rounded-lg overflow-hidden shadow-soft flex-shrink-0" style="border: 1px solid var(--line);">
            <img
              src="/team-lia.webp"
              alt="Liana Zheleva – Teaching Assistant at Immersion English"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center 15%; display: block;"
            loading="lazy" />
          </div>
          <div class="min-w-0 overflow-hidden">
            <p class="font-heading font-bold text-[1.2rem] text-ink mb-1">Liana (Lia) Zheleva</p>
            <p class="text-[0.85rem] font-semibold mb-3" style="color: var(--green);">Teaching Assistant · Bilingual EN / BG</p>
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 16px;"></div>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              Lia is a final-year student at the National Fine Arts High School in Sofia, and is bilingual in English and Bulgarian.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              She has been to Dublin for The Lir Academy's Young Actors Summer Programme, so she knows the city first-hand.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed">
              She loves theatre and music, and as our teaching assistant she supports both teachers and students.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- HOW WE TEACH -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">How we teach</span>
        <h2><span style="color: var(--orange-text);">Speaking</span> comes first.</h2>
        <p>We use real-world materials, plenty of conversation and honest feedback.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          {
            title: 'Authentic materials',
            body: 'We work with books, TV series, podcasts and the news: the English people actually read and listen to, which is far more interesting than a textbook dialogue.',
          },
          {
            title: 'Personal to you',
            body: 'Every course is planned around the student: what they need English for, what they\'re interested in, and how fast they want to go.',
          },
          {
            title: 'Communication over memorisation',
            body: 'Grammar matters, but we teach it through use rather than drills. The goal is always to get you speaking and thinking in English without translating.',
          },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section id="testimonials" class="section" style="background: var(--ink); scroll-margin-top: 80px;">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot" style="color: var(--orange);">What students say</span>
        <h2 class="text-white">In their <span style="color: var(--orange);">own words</span>.</h2>
        <p style="color: rgba(255,255,255,0.6);">Every quote below is from a real student – unedited and unprompted.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {testimonials.map(({ quote, name }) => (
          <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-left: 4px solid var(--orange); border-radius: var(--radius-md); padding: 32px 32px 28px; display: flex; flex-direction: column; gap: 16px;">
            <!-- Stars -->
            <div style="display: flex; gap: 3px;">
              {[1,2,3,4,5].map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--orange)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <!-- Quote -->
            <p style="color: rgba(255,255,255,0.88); font-size: 1rem; line-height: 1.7; font-style: italic; flex: 1;">"{quote}"</p>
            <!-- Name -->
            <div style="display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1);">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--orange); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <span style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.8rem; color: white;">{name.charAt(0)}</span>
              </div>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.88rem; color: rgba(255,255,255,0.7); margin: 0;">{name}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <span class="eyebrow eyebrow-dot">Get in touch</span>
      <h2 class="mt-4 mb-5">Ready to get started?</h2>
      <p class="max-w-[46ch] mx-auto mb-8 text-[1.05rem]" style="color: rgba(254,255,254,0.74);">
        Talk to us about lessons, Dublin, or anything else on your mind – no obligation.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center flex-wrap">
        <a href="/contact?from=about#booking-form" class="btn btn-primary">Talk to us</a>
        <a href="/lessons" class="btn btn-ghost text-white border-white/30 hover:border-white">Choose your lessons</a>
        <a href="/dublin-summer-2027" class="btn btn-ghost text-white border-white/30 hover:border-white">Dublin Summer 2027</a>
      </div>
    </div>
  </section>

</BaseLayout>
