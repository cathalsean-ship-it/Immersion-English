---
import BaseLayout from '../layouts/BaseLayout.astro';

const testimonials = [
  {
    quote: "Lenny is the most motivational English teacher I've ever met! His way of teaching involves so many kinds of innovative methods that you'll be studying in an atmosphere of fun, professionalism and individual attention on your own needs. I strongly recommend!",
    name: 'Natalya Baleva',
  },
  {
    quote: "Lenny is a great teacher and he helped me to learn and start using English as I wanted. I like his style of teaching – he involves grammar, vocabulary and exercises while we are chatting, reading and discussing daily topics. Highly recommend!",
    name: 'Dobromira Kozhuharova',
  },
  {
    quote: "If you can read this – perhaps you know some English. But if you want to experience the real beauty and pleasure of being fluent, you need Lenny! With his professionalism and charm he can easily turn this educational journey into a pure joy.",
    name: 'Petia Aranudova',
  },
  {
    quote: "I always knew my puzzle of English knowledge had missing pieces, but was sure I was too old to add them. Lenny's teaching not only helped me to learn and remember without knowing how, but also to become more confident in conversations. Very fast, attending the course became a breath of fresh air after a long working day.",
    name: 'Zornitsa Dermendzhieva-Stoynova',
  },
];
---

<BaseLayout
  title="About Immersion English | CELTA-qualified English Teachers in Sofia & Dublin"
  description="Meet the team behind Immersion English – a CELTA-qualified Irish teacher, an international education expert, and a bilingual teaching assistant. Based in Sofia, teaching in Dublin."
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 54vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        About us
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Immersion English –<br />
        <span style="color: var(--orange);">English for Life.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[52ch] leading-[1.55]">
        We're a small, experienced team with one goal: to help you use English with real confidence. Not just study it.
      </p>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20 items-center">
        <div class="rounded-md overflow-hidden shadow-lift">
          <img
            src="/about-who-we-are.jpg"
            alt="Abstract composition – where learning connects with life"
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 4/3; object-position: center; display: block;"
          />
        </div>
        <div>
          <span class="eyebrow eyebrow-dot">Who we are</span>
          <h2 class="mt-4 mb-5">Where learning connects with your life.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Immersion English was founded in Sofia by a CELTA-qualified Irish teacher and an international education expert with a shared belief: that real progress in English comes from using it, not memorising it.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch]">
            We work with adult learners and teenagers who want to communicate clearly and confidently – in exams, in work, in life. Our lessons are built around you: your goals, your level, your world.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE TEACH -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">How we teach</span>
        <h2>Progress you can <span style="color: var(--orange);">feel</span> from day one.</h2>
        <p>We use real-world materials, communicative methods, and honest feedback – so every lesson moves you forward.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          {
            title: 'Authentic materials',
            body: 'Books, drama series, podcasts, and current news – we use rich, real-world English that turns language learning from a chore into something you actually look forward to.',
          },
          {
            title: 'Personal to you',
            body: 'Your interests, your goals, your pace. We tailor every course to the individual – because no two learners follow exactly the same path.',
          },
          {
            title: 'Communication over memorisation',
            body: 'We go beyond grammar drills. Speaking, thinking, and communicating in English naturally and independently is always the goal.',
          },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Our team</span>
        <h2>Small team. <span style="color: var(--orange);">Big</span> expertise.</h2>
        <p>Three people who care deeply about language, learning, and the confidence that comes from both.</p>
      </div>

      <!-- Lenny — featured founder layout -->
      <div class="grid grid-cols-1 md:grid-cols-[340px_1fr] gap-8 md:gap-16 items-start mb-16">
        <div style="position: relative;">
          <div class="rounded-lg overflow-hidden shadow-lift" style="border: 1px solid var(--line);">
            <img
              src="/team-lenny.jpg"
              alt="Cathal Leonard – Founder and Senior English Teacher at Immersion English"
              class="w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            />
          </div>
          <!-- Founder badge -->
          <div style="position: absolute; bottom: -16px; left: 24px; background: var(--green); color: white; border-radius: 8px; padding: 8px 16px; box-shadow: 0 4px 16px rgba(20,32,26,0.2);">
            <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">Founder</p>
          </div>
        </div>
        <div class="pt-2 md:pt-4">
          <p class="font-heading font-bold text-[1.5rem] text-ink mb-1">Cathal (Lenny) Leonard</p>
          <p class="text-[0.9rem] font-semibold mb-6" style="color: var(--green);">Senior English Teacher · CELTA-qualified · British Council ESAT-J Examiner</p>
          <div style="width: 40px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 24px;"></div>
          <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
            Cathal – known to students as Lenny – is a native Irish, CELTA-qualified English teacher with over ten years of experience working with teenage and adult learners. He has taught at the British Council in Sofia and led international summer programmes in Oxford and Brighton.
          </p>
          <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
            Lenny specialises in exam preparation – with a strong track record of guiding students to success in Cambridge C1 Advanced (CAE) and IELTS – as well as speaking-focused general English and professional communication. He holds a BA from NUI Galway and an MA in Political Science from Queen's University Belfast.
          </p>
          <p class="text-ink-soft text-[1.02rem] leading-relaxed">
            His lessons are lively, focused, and full of humour. Students leave not just with better English, but with the confidence to use it. When he's not teaching, he's usually playing (or attempting to play) his guitar.
          </p>
        </div>
      </div>

      <!-- Lina & Lia — same layout as Lenny but smaller -->
      <div class="flex flex-col gap-12" style="padding-top: 48px; border-top: 1px solid var(--line);">

        <!-- Lina -->
        <div class="grid grid-cols-1 md:grid-cols-[160px_1fr] gap-6 md:gap-10 items-start">
          <div class="rounded-lg overflow-hidden shadow-soft flex-shrink-0" style="border: 1px solid var(--line); max-width: 160px;">
            <img
              src="/team-lina.jpg"
              alt="Lina Georgieva – Co-founder of the Immersion English Dublin Summer Programme"
              class="w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            />
          </div>
          <div>
            <p class="font-heading font-bold text-[1.2rem] text-ink mb-1">Lina Georgieva</p>
            <p class="text-[0.85rem] font-semibold mb-3" style="color: var(--green);">Co-founder, Dublin Summer Programme · Marketing & Business Development Manager</p>
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 16px;"></div>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              Lina is the co-founder of the Immersion English Dublin Summer Programme. With over a decade of international experience in education, communications, and marketing, she brings the strategic vision and creative energy that shaped the programme from the ground up.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              A graduate of Hunter College, City University of New York (BA in Film and Media Studies), Lina currently works as Global Capability Development Manager at the British Council – leading initiatives that connect learners, teachers, and institutions across the world.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed">
              Bilingual in English and Bulgarian and fluent in several other languages, Lina is also a certified yoga teacher. The Dublin Summer Programme is her way of bringing together her passions for language, culture, travel, and meaningful learning experiences for young people.
            </p>
          </div>
        </div>

        <!-- Lia -->
        <div class="grid grid-cols-1 md:grid-cols-[160px_1fr] gap-6 md:gap-10 items-start">
          <div class="rounded-lg overflow-hidden shadow-soft flex-shrink-0" style="border: 1px solid var(--line); max-width: 160px;">
            <img
              src="/team-lia.jpg"
              alt="Liana Zheleva – Teaching Assistant at Immersion English"
              class="w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            />
          </div>
          <div>
            <p class="font-heading font-bold text-[1.2rem] text-ink mb-1">Liana (Lia) Zheleva</p>
            <p class="text-[0.85rem] font-semibold mb-3" style="color: var(--green);">Teaching Assistant · Bilingual EN / BG</p>
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 16px;"></div>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              Lia is a final-year student at the National Fine Arts High School in Sofia, where she has developed a passion for creativity, expression, and human connection. Bilingual in English and Bulgarian, she brings a warm, grounded presence to the Immersion English team.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed mb-3">
              Having attended The Lir Academy's Young Actors Summer Programme in Dublin, Lia knows the city and its culture first-hand – giving her a genuine connection to everything the Immersion English Summer Programme offers its students.
            </p>
            <p class="text-ink-soft text-[0.97rem] leading-relaxed">
              Passionate about theatre, music, and working with people, Lia supports both teachers and students on the programme – helping create an environment where learning feels natural, fun, and genuinely memorable.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">What students say</span>
        <h2>Real results. Real students.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
        {testimonials.map(({ quote, name }) => (
          <div class="bg-white border border-line rounded-lg p-6 md:p-8 flex flex-col gap-5">
            <p class="text-[1.35rem] text-brand-green font-heading font-bold leading-none">"</p>
            <p class="text-ink text-[1.02rem] leading-relaxed italic flex-1">{quote}</p>
            <p class="font-heading font-semibold text-[0.9rem] text-ink-soft pt-4 border-t border-line">– {name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <span class="eyebrow eyebrow-dot">Get in touch</span>
      <h2 class="mt-4 mb-5">Ready to get started?</h2>
      <p class="max-w-[46ch] mx-auto mb-8 text-[1.05rem]" style="color: rgba(254,255,254,0.74);">
        Book a free consultation and we'll find the right course or programme for your goals – no obligation.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center flex-wrap">
        <a href="/contact" class="btn btn-primary">Book a free consultation</a>
        <a href="/dublin-summer-2027" class="btn btn-ghost text-white border-white/30 hover:border-white">Dublin Summer 2027</a>
      </div>
    </div>
  </section>

</BaseLayout>
