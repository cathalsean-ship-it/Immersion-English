---
import BaseLayout from '../layouts/BaseLayout.astro';

const testimonials = [
  {
    quote: "Lenny is the most motivational English teacher I've ever met! His way of teaching involves so many kinds of innovative methods that you'll be studying in an atmosphere of fun, professionalism and individual attention on your own needs. I strongly recommend!",
    name: 'Natalya Baleva',
  },
  {
    quote: "Lenny is a great teacher and he helped me to learn and start using English as I wanted. I like his style of teaching – he involves grammar, vocabulary and exercises while we are chatting, reading and discussing daily topics. Highly recommend!",
    name: 'Dobromira Kozhuharova',
  },
  {
    quote: "If you can read this – perhaps you know some English. But if you want to experience the real beauty and pleasure of being fluent, you need Lenny! With his professionalism and charm he can easily turn this educational journey into a pure joy.",
    name: 'Petia Aranudova',
  },
  {
    quote: "I always knew my puzzle of English knowledge had missing pieces, but was sure I was too old to add them. Lenny's teaching not only helped me to learn and remember without knowing how, but also to become more confident in conversations. Very fast, attending the course became a breath of fresh air after a long working day.",
    name: 'Zornitsa Dermendzhieva-Stoynova',
  },
];
---

<BaseLayout title="About Us" description="Meet the team behind Immersion English – CELTA-qualified teachers in Sofia with over 10 years of experience.">

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 54vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        About us
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Immersion English –<br />
        <span style="color: var(--orange);">English for Life.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[52ch] leading-[1.55]">
        Based in Sofia, we move beyond traditional textbook methods to offer a dynamic and personalised approach to English language education.
      </p>
    </div>
  </section>

  <!-- STORY -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20 items-center">
        <div class="rounded-md overflow-hidden shadow-lift">
          <img
            src="/team-lina.jpg"
            alt="Lina Georgieva – Co-founder of Immersion English"
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 3/4; object-position: center top; display: block;"
          />
        </div>
        <div>
          <span class="eyebrow eyebrow-dot">Who we are</span>
          <h2 class="mt-4 mb-5">Where learning connects with your life.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Welcome to Immersion English. We believe true language mastery happens when learning connects with your life. Our lessons are designed for ambitious learners who want to communicate with confidence and clarity within different contexts and environments.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch]">
            Our expertise is focused on helping you achieve your specific goals – whether you're preparing for IELTS or CAE, refining your professional communication, or mastering effective writing. For General English learners, we make progress both effective and engaging by connecting English to your world.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">How we teach</span>
        <h2>The most sustainable progress comes from connecting English to your world.</h2>
        <p>We incorporate your personal interests and needs with rich, varied, and current sources of authentic English – books, drama series, podcasts, and real conversation.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          {
            icon: '●',
            title: 'Authentic materials',
            body: 'Compelling books, gripping drama series, insightful podcasts – we use rich, real-world English that transforms language learning from a task into a passion.',
          },
          {
            icon: '●',
            title: 'Personal to you',
            body: 'Your interests, your goals, your pace. We tailor every learning journey to the individual – no two students follow exactly the same path.',
          },
          {
            icon: '●',
            title: 'Communication over memorisation',
            body: 'We go beyond traditional methods. Speaking, thinking, and communicating in English – naturally and independently – is always the goal.',
          },
        ].map(({ icon, title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Our team</span>
        <h2>Expert teachers. Dedicated mentors.</h2>
        <p>Our teachers are not just instructors – they are mentors who guide you, challenge you, and curate a learning journey that is uniquely yours.</p>
      </div>
      <div class="flex flex-col gap-16">

        <!-- Lenny -->
        <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 md:gap-12 items-start">
          <div class="rounded-md overflow-hidden shadow-soft">
            <img
              src="/team-lenny.jpg"
              alt="Cathal (Lenny) Leonard – Founder & Senior English Teacher"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            />
          </div>
          <div>
            <p class="font-heading font-bold text-[1.3rem] text-ink">Cathal (Lenny) Leonard</p>
            <p class="text-[0.9rem] font-semibold mt-1 mb-5" style="color: var(--green);">Founder & Senior English Teacher · CELTA-qualified · British Council ESAT-J Examiner</p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
              Cathal – "Lenny" to his friends and students – is a CELTA-qualified English teacher with over ten years of experience helping teenage and adult learners achieve their language goals. He has taught at prestigious institutions including the British Council in Sofia and international summer programmes in Oxford and Brighton.
            </p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
              A specialist in exam preparation, Lenny has an extensive track record of guiding students to success in Cambridge C1 Advanced (CAE) and IELTS. He holds a BA from NUI Galway and an MA in Political Science from Queen's University Belfast.
            </p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed">
              Lenny's classes are lively, engaging, and full of humour – helping students build confidence and find their voice in English. When he's not teaching, he's usually playing (or trying to play!) his guitar.
            </p>
          </div>
        </div>

        <div class="border-t border-line"></div>

        <!-- Lina -->
        <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 md:gap-12 items-start">
          <div class="rounded-md overflow-hidden shadow-soft">
            <img
              src="/team-lina.jpg"
              alt="Lina Georgieva – Co-founder"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            />
          </div>
          <div>
            <p class="font-heading font-bold text-[1.3rem] text-ink">Lina Georgieva</p>
            <p class="text-[0.9rem] font-semibold mt-1 mb-5" style="color: var(--green);">Co-founder · Marketing & Business Development Manager</p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
              Lina is the co-founder and business development lead behind the Immersion English summer programme. With over a decade of international experience in education, communications, and marketing, she brings both strategic insight and creative energy.
            </p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
              A graduate of Hunter College, City University of New York (BA in Film and Media Studies), Lina currently works as Global Capability Development Manager at the British Council, leading initiatives that connect learners, teachers, and partners across the world.
            </p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed">
              Bilingual in English and Bulgarian and fluent in several other languages, Lina is a certified yoga teacher and mother of a teenage daughter. Through the Immersion English Summer Programme, she brings together her love for language, culture, and wellbeing.
            </p>
          </div>
        </div>

        <div class="border-t border-line"></div>

        <!-- Lia -->
        <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 md:gap-12 items-start">
          <div class="rounded-md overflow-hidden shadow-soft">
            <img
              src="/team-lia.jpg"
              alt="Liana Zheleva – Teaching Assistant"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 3/4; object-position: center top; display: block;"
            />
          </div>
          <div>
            <p class="font-heading font-bold text-[1.3rem] text-ink">Liana Zheleva</p>
            <p class="text-[0.9rem] font-semibold mt-1 mb-5" style="color: var(--green);">Teaching Assistant · Bilingual EN / BG</p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
              Lia is a student at the National Fine Arts High School in Sofia, where she combines her love for creativity, expression, and connection. Bilingual in English and Bulgarian, she brings a warm, approachable energy to the Immersion English team.
            </p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-4">
              Her experience at The Lir Academy's Young Actors Summer Programme in Dublin gave her a genuine familiarity with the city and its culture – something she loves sharing with students.
            </p>
            <p class="text-ink-soft text-[1.02rem] leading-relaxed">
              Passionate about music, theatre, the performing arts and working with people, Lia supports teachers and students alike – creating a positive, engaging space for learning, laughter, and cultural discovery.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">What students say</span>
        <h2>Real results. Real students.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
        {testimonials.map(({ quote, name }) => (
          <div class="bg-white border border-line rounded-lg p-8 flex flex-col gap-5">
            <p class="text-[1.35rem] text-brand-green font-heading font-bold leading-none">"</p>
            <p class="text-ink text-[1.02rem] leading-relaxed italic flex-1">{quote}</p>
            <p class="font-heading font-semibold text-[0.9rem] text-ink-soft pt-4 border-t border-line">– {name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <span class="eyebrow eyebrow-dot">Get in touch</span>
      <h2 class="mt-4 mb-5">Ready to get started?</h2>
      <p class="max-w-[46ch] mx-auto mb-8 text-[1.05rem]" style="color: rgba(254,255,254,0.74);">
        Book a free consultation and we'll help you find the right course or programme for your goals.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center flex-wrap">
        <a href="/contact" class="btn btn-primary">
          Book a free consultation
        </a>
        <a href="/dublin-summer-2027" class="btn btn-ghost text-white border-white/30 hover:border-white">
          Dublin Summer 2027
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
