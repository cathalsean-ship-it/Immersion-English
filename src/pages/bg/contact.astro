---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactMethods from '../../components/ContactMethods.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { dublin } from '../../data/dublin';

// Bulgarian contact page (10 Nov 2026). A shorter mirror of src/pages/contact.astro:
// same form and contact rows (shared components), without the "getting started"
// and corporate sections. If the English page's form changes, this one follows
// automatically; if its copy changes, check this page too.
---

<BaseLayout ogImage="/og/contact.jpg" title="Контакти | Immersion English" description={`Свържете се с Immersion English за лятната програма в Дъблин за ученици на ${dublin.ages.min}–${dublin.ages.max} години или за уроци по английски. Отговаряме до един работен ден.`}>

  <!-- HERO (compact) -->
  <section class="relative flex items-center text-white overflow-hidden isolate">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, var(--hero-top) 0%, #14201a 60%, #0a3f25 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        Контакти
      </p>
      <h1 class="text-white mb-4">Да се запознаем.</h1>
      <p class="text-white/80 text-[1.15rem] max-w-[46ch] leading-[1.55]">
        Уроци по английски, подготовка за изпити, лятната програма в Дъблин или просто въпрос – ще се радваме да ни пишете. Можем да се срещнем онлайн или на живо в София.
      </p>
    </div>
  </section>

  <!-- CONTACT FORM + DETAILS -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[5fr_7fr] gap-10 md:gap-16 items-start">
        <div>
          <span class="eyebrow eyebrow-dot">Как да се свържете с нас</span>
          <h2 class="mt-4 mb-6 text-[1.9rem]">Отговаряме до един работен ден.</h2>
          <ContactMethods lang="bg" />
        </div>
        <EnquiryForm lang="bg" />
      </div>
    </div>
  </section>
</BaseLayout>
