---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="Immersion English – speaking-focused English lessons in Sofia and a summer programme in Dublin for teens aged 13–17.">
  <!-- HERO -->
  <section class="relative min-h-[80vh] flex items-stretch text-white overflow-hidden isolate pb-10">
    <div
      class="absolute inset-0 -z-[2] bg-[#1a2a20] bg-cover bg-[center_40%]"
      style="background-image: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"
    ></div>
    <div
      class="absolute inset-0 -z-[1] pointer-events-none"
      style="background:
        linear-gradient(180deg, rgba(20,32,26,0.35) 0%, rgba(20,32,26,0.55) 45%, rgba(20,32,26,0.92) 100%),
        linear-gradient(95deg, rgba(0,80,40,0.45) 0%, rgba(20,32,26,0.15) 50%, rgba(20,32,26,0) 100%);"
    ></div>

    <div class="container-x relative z-10 w-full flex items-end pt-[116px] pb-[56px]">
      <div class="max-w-[760px]">
        <span
          class="inline-flex items-center gap-[10px] py-[7px] pr-[14px] pl-2 rounded-full bg-white/[.12] backdrop-blur-md border border-white/[.18] text-white font-heading font-semibold text-[0.78rem] tracking-[0.04em] mb-6"
        >
          <span class="bg-white text-brand-green px-[10px] py-[3px] rounded-full text-[0.7rem] tracking-[0.08em] uppercase">
            Dublin Summer 2027
          </span>
          <span>Sofia & Dublin · July 2027</span>
        </span>

        <h1 class="text-white">
          Confident English<br />
          comes from using it –<br />
          not <span style="color: var(--orange);">memorising</span> it.
        </h1>

        <p class="mt-6 text-[1.18rem] text-white/85 max-w-[56ch] leading-[1.55]">
          Immersion English is a speaking-focused English school in Sofia. We offer year-round courses online and an immersive summer programme in Dublin for teens aged 13–17.
        </p>

        <div class="mt-8 flex gap-4 items-center flex-wrap">
          <a href="/dublin-summer-2027" class="btn btn-primary">
            Explore Dublin Summer 2027
            <span class="btn-arrow">→</span>
          </a>
          <a href="/lessons" class="btn btn-ghost text-white border-white/30 hover:border-white">
            View our lessons
          </a>
        </div>


      </div>
    </div>


  </section>

  <!-- CREDENTIALS BAND -->
  <section style="background: var(--ink); border-bottom: none;">
    <div class="container-x py-5">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center">
        {[
          'CELTA-qualified teachers',
          '10+ years of experience',
          'Communicative lessons',
          'Cambridge & IELTS specialists',
          'Small groups, max 8',
        ].map((item, i, arr) => (
          <>
            <span class="font-heading font-semibold text-[0.9rem] text-white tracking-wide">{item}</span>
            {i < arr.length - 1 && (
              <span class="w-[7px] h-[7px] rounded-full flex-shrink-0" style="background: var(--orange);"></span>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Why Immersion English</span>
        <h2>English is learned best when it's used meaningfully.</h2>
        <p>
          Our lessons are designed for ambitious learners who want to communicate with confidence and clarity. We go beyond the textbook.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { title: 'Speaking-first teaching', body: 'Every lesson prioritises active speaking and real communication over passive learning. You leave each class having used English, not just studied it.' },
          { title: 'Small groups, real attention', body: 'Maximum 8 students in our online Speak Up courses. You get individual feedback, more time to speak, and a teacher who knows your goals.' },
          { title: 'Experience that counts', body: 'Lenny is CELTA-qualified with over 10 years of experience teaching at the British Council in Sofia and international summer programmes in Oxford and Brighton.' },
        ].map(({ title, body }) => (
          <div class="trust-card" style="justify-content: space-between;">
            <h3 style="margin: 0;">{title}</h3>
            <div class="w-[10px] h-[10px] rounded-full flex-shrink-0" style="background: var(--orange);"></div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAMME -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.05fr] gap-10 md:gap-20 items-center">
        <div
          class="rounded-lg overflow-hidden shadow-lift aspect-[5/6]"
          style="background:
            repeating-linear-gradient(135deg, rgba(20,32,26,0.04) 0 2px, transparent 2px 14px),
            #c8d8cc;"
        ></div>

        <div>
          <span class="eyebrow eyebrow-dot">Dublin Summer 2027</span>
          <h2 class="mt-4 mb-2">English. Beyond the classroom.</h2>
          <p class="text-ink-soft text-[1.08rem] max-w-[56ch] mb-3">
            Our flagship immersive English programme takes Bulgarian teenagers to Dublin, Ireland – where English becomes part of daily life.
          </p>
          <p class="font-heading font-semibold text-[1.18rem] leading-snug mb-0" style="color: var(--orange);">
            Real conversations.<br/>Real confidence.<br/>One unforgettable week.
          </p>

          <dl class="grid grid-cols-2 gap-7 my-10 py-8 border-y border-line">
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Duration</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">7 days</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Ages</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">13–17</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Group size</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">Max 13 students</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Programme fee</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">€1,350</dd>
            </div>
          </dl>

          <ul class="list-none p-0 m-0 flex flex-col gap-3">
            {[
              { label: 'Daily guided English practice', detail: 'with a native, CELTA-qualified teacher' },
              { label: 'Accommodation at UCD campus', detail: 'University College Dublin' },
              { label: 'Real-world communication skills', detail: 'through cultural activities and city trips across Dublin' },
              { label: 'Small groups of max 13 students', detail: 'structured days with clear daily schedule' },
              { label: 'Full supervision from arrival to departure', detail: 'with a Bulgarian speaker available at all times' },
              { label: 'Book your own direct Ryanair flight', detail: 'Sofia–Dublin · we send you a step-by-step guide' },
            ].map(({ label, detail }) => (
              <li class="flex items-start gap-3 rounded-lg px-4 py-3" style="background: var(--cream); border: 1px solid var(--line);">
                <span class="flex-shrink-0 mt-[5px] w-[10px] h-[10px] rounded-full" style="background: var(--orange);"></span>
                <span class="text-[0.95rem]">
                  <strong class="font-semibold text-ink">{label}</strong>
                  <span class="text-ink-soft"> – {detail}</span>
                </span>
              </li>
            ))}
          </ul>

          <div class="flex gap-3 mt-8 flex-wrap">
            <a href="/dublin-summer-2027" class="btn btn-primary">
              Explore the programme
              <span class="btn-arrow"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
            </a>
            <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- DUBLIN TRIPS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Trips &amp; Activities</span>
        <h2>Explore Dublin and beyond.</h2>
        <p>Six unforgettable experiences included in the programme – from ancient castles to coastal cliff walks.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {[
          { title: 'Trinity College', desc: "Walk the same paths as Oscar Wilde and Samuel Beckett at one of Ireland's most iconic universities.", tag: 'Cultural', color: '#c8d5dd' },
          { title: 'Dublin Castle', desc: 'History meets imagination at Dublin Castle – the heart of the city for over 800 years.', tag: 'History', color: '#c8d8cc' },
          { title: 'The Book of Kells', desc: "Ireland's greatest cultural treasure – a world-famous illuminated manuscript and the stunning Long Room library.", tag: 'Cultural', color: '#d6d2c5' },
          { title: 'Howth Cliff Walk', desc: 'Fresh air, sea views, and endless photo moments! Stunning coastal cliffs, a lighthouse, and seals along the way.', tag: 'Nature', color: '#c2d0dc' },
          { title: "St Stephen's Green", desc: "A quiet escape in the heart of the city – Dublin's most beautiful park, calm, green, and full of character.", tag: 'Nature', color: '#c8d8cc' },
          { title: 'Glendalough', desc: 'Discover the breathtaking 6th-century monastic site and twin lakes in the Wicklow Mountains. Ancient Ireland at its finest.', tag: 'History', color: '#d7c3b0' },
        ].map(({ title, desc, tag, color }) => (
          <a href="/dublin-summer-2027/trips-and-activities" class="no-underline group">
            <div class="bg-white border border-line rounded-lg overflow-hidden transition-all duration-200 group-hover:shadow-md group-hover:-translate-y-[3px] flex flex-col h-full">
              <div class="aspect-video w-full" style={`background: repeating-linear-gradient(135deg, rgba(20,32,26,0.05) 0 2px, transparent 2px 14px), ${color};`}></div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <h3 class="text-[1.05rem]">{title}</h3>
                  <span class="text-[0.65rem] font-heading font-semibold uppercase tracking-[0.1em] px-[8px] py-[3px] rounded-full flex-shrink-0" style="background: var(--green-soft); color: var(--green);">{tag}</span>
                </div>
                <p class="text-ink-soft text-[0.9rem] leading-relaxed flex-1">{desc}</p>
                <span class="inline-flex items-center gap-2 mt-4 text-[0.85rem] font-heading font-semibold" style="color: var(--green);">
                  See all trips →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="section" style="background: linear-gradient(135deg, #008037 0%, #006a2d 100%);">
    <div class="container-x">
      <div class="max-w-[840px] mx-auto text-center">
        <span class="block font-heading font-bold text-[3.5rem] leading-none text-brand-orange">&ldquo;</span>
        <p class="text-white text-[1.6rem] md:text-[1.95rem] font-heading font-semibold leading-[1.32] tracking-[-0.01em] -mt-2 mb-7 text-balance">
          Lenny is the most motivational English teacher I've ever met – fun, professional, and focused on exactly what I needed.
        </p>
        <p class="text-white/75 font-heading font-semibold text-[0.92rem] tracking-[0.04em]">– Natalya Baleva</p>
        <a href="/about" class="inline-flex items-center gap-2 mt-7 text-white/90 hover:text-white font-heading font-semibold text-[0.9rem] no-underline border-b border-white/30 hover:border-white pb-[2px] transition-colors">
          Read more student stories →
        </a>
      </div>
    </div>
  </section>


  <!-- CONTACT -->
  <section class="section section-dark">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start">
        <div>
          <span class="eyebrow eyebrow-dot" style="color: var(--green);">Contact</span>
          <h2 class="mt-4 mb-4"><span class="text-white">Got a </span><span style="color: var(--orange);">question?</span><span class="text-white"> We're here.</span></h2>
          <p>Book a free consultation and we'll help you find the right programme or course.</p>

          <div class="flex flex-col gap-6 mt-8">
            {[
              { label: 'Email', value: 'immersionenglish.ie@gmail.com', icon: '✉' },
              { label: 'Phone (English)', value: '+359 893 387 464', icon: '📞' },
              { label: 'Phone (Bulgarian)', value: '+359 889 178 100', icon: '📞' },
            ].map(({ label, value, icon }) => (
              <div class="flex gap-4 items-start py-4 border-b border-white/10">
                <div class="w-9 h-9 rounded-full bg-brand-green/20 text-brand-green grid place-items-center flex-shrink-0">{icon}</div>
                <div>
                  <div class="font-heading text-[0.78rem] uppercase tracking-[0.12em] text-white/55 mb-[2px] font-semibold">{label}</div>
                  <div class="font-heading font-medium text-white text-[1.02rem]">{value}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white text-ink rounded-lg p-9 shadow-lift">
          <h3 class="text-[1.35rem] mb-[6px]">Book a free consultation</h3>
          <p class="text-ink-soft text-[0.95rem] mb-6">Tell us about your goals and we'll help you find the right course or programme. We reply within one working day.</p>

          <div class="grid grid-cols-2 gap-[14px] mb-[14px]">
            <div class="flex flex-col gap-[6px]">
              <label class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">First name</label>
              <input type="text" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px]">
              <label class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Last name</label>
              <input type="text" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] col-span-2">
              <label class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Email</label>
              <input type="email" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] col-span-2">
              <label class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Message</label>
              <textarea rows="3" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition resize-y min-h-[90px]"></textarea>
            </div>
          </div>

          <a href="mailto:immersionenglish.ie@gmail.com" class="btn btn-primary w-full justify-center mt-2">
            Send message
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
