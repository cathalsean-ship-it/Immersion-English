---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import studentsWalking from '../assets/students-walking.jpg';
---

<BaseLayout title="Immersion English | English Lessons in Sofia & Dublin Summer School for Teens" description="CELTA-qualified English teacher in Sofia, Bulgaria. Speaking-focused online lessons for adults and an immersive summer school in Dublin for teenagers aged 13–17. Летен езиков курс в Дъблин за тийнейджъри от България.">
  <!-- HERO -->
  <section class="relative min-h-[80vh] flex items-stretch text-white overflow-hidden isolate pb-10">
    <div
      class="absolute inset-0 -z-[2] bg-[#1a2a20] bg-cover bg-[center_40%]"
      style="background-image: linear-gradient(135deg, #1f6b4d 0%, #14201a 60%, #0a3f25 100%);"
    ></div>
    <div
      class="absolute inset-0 -z-[1] pointer-events-none"
      style="background:
        linear-gradient(180deg, rgba(20,32,26,0.35) 0%, rgba(20,32,26,0.55) 45%, rgba(20,32,26,0.92) 100%),
        linear-gradient(95deg, rgba(0,80,40,0.45) 0%, rgba(20,32,26,0.15) 50%, rgba(20,32,26,0) 100%);"
    ></div>

    <div class="container-x relative z-10 w-full flex items-end pt-[100px] md:pt-[116px] pb-[48px] md:pb-[56px]">
      <div class="max-w-[760px]">
        <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
          Dublin, Ireland · July 2027
        </p>

        <h1 class="text-white">
          Confident English<br />
          comes from <span style="color: var(--orange-text);">using</span> it.<br />
          Not <span style="color: var(--orange-text);">memorising</span> it.
        </h1>

        <p class="mt-5 text-[1rem] md:text-[1.18rem] text-white/85 max-w-[56ch] leading-[1.55]">
          Immersion English is a speaking-focused English school in Sofia. We offer individual and corporate English lessons online, and an immersive summer programme in Dublin for teens aged 13–17.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-center">
          <a href="/dublin-summer-2027" class="btn btn-primary">
            Explore Dublin Summer 2027
          </a>
          <a href="/lessons" class="btn btn-ghost text-white border-white/30 hover:border-white">
            View our lessons
          </a>
        </div>


      </div>
    </div>


  </section>

  <!-- CREDENTIALS BAND -->
  <section style="background: var(--ink); border-bottom: none;">
    <div class="container-x py-5">
      <div class="flex flex-wrap items-center justify-start md:justify-center gap-x-5 gap-y-3">
        {[
          'CELTA-qualified teachers',
          '10+ years of experience',
          'Communicative lessons',
          'Cambridge & IELTS specialists',
        ].map((item) => (
          <span class="flex items-center gap-2 flex-shrink-0">
            <span class="w-[7px] h-[7px] rounded-full flex-shrink-0" style="background: var(--orange);"></span>
            <span class="font-heading font-semibold text-[0.88rem] text-white tracking-wide">{item}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Why Immersion English</span>
        <h2>English is learned best when it's used meaningfully.</h2>
        <p>
          Our lessons are designed for ambitious learners who want to communicate with confidence and clarity. We go beyond the textbook.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { title: 'Speaking-first teaching', body: 'Every lesson prioritises active speaking and real communication over passive learning. You leave each class having used English, not just studied it.' },
          { title: 'Small groups, big attention', body: '8 students per group in our online Speak Up courses. You get individual feedback, more time to speak, and a teacher who knows your goals.' },
          { title: 'Experience that counts', body: 'Lenny is a native English speaker from Ireland, CELTA-qualified, and the founder of Immersion English — with 10 years teaching General English and Business English at the British Council Sofia, and international summer programmes in Oxford and Cambridge.' },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0; min-height: 2.6em;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>

      <div class="flex justify-center mt-10">
        <a
          href="/about"
          class="inline-flex items-center gap-3 no-underline group"
          style="color: var(--ink-soft);"
        >
          <span class="w-8 h-[1.5px]" style="background: var(--orange); display: inline-block; transition: width 0.2s ease;"></span>
          <span class="font-heading font-semibold text-[0.9rem] tracking-wide group-hover:text-brand-green transition-colors">
            Learn more about how we teach
          </span>
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="transition: transform 0.2s ease;" class="group-hover:translate-x-1">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- PROGRAMME -->
  <section class="section" style="padding-left: 0; padding-right: 0; overflow: hidden;">
    <div style="display: grid; grid-template-columns: 1fr 1.05fr; gap: 0; align-items: center;" class="programme-grid">
      <!-- Image: bleeds to left edge -->
      <div class="homepage-hero-img-wrap relative" style="overflow: hidden; min-height: 480px;">
        <Image
          src={studentsWalking}
          alt="Students exploring Dublin"
          class="homepage-hero-img w-full h-full object-cover"
          style="position: absolute; inset: 0;"
          loading="lazy"
          widths={[640, 1024, 1440]}
          sizes="(max-width: 768px) 100vw, 50vw"
        />
        <!-- Gradient overlay -->
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,26,0) 50%, rgba(20,32,26,0.55) 100%); pointer-events: none; z-index: 1;"></div>
        <!-- Badge – bottom left, small, unobtrusive -->
        <div style="position: absolute; bottom: 24px; left: 24px; z-index: 2; display: flex; align-items: center; gap: 8px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--orange); flex-shrink: 0; display: inline-block;"></span>
          <span style="font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.82rem; color: white; letter-spacing: 0.06em; text-shadow: 0 1px 4px rgba(0,0,0,0.4);">Dublin, Ireland · July 2027</span>
        </div>
      </div>

      <!-- Content: normal container padding on right side -->
      <div style="padding: 40px 24px 40px 24px;" class="programme-content md-pad-programme">

        <div>
          <span class="eyebrow eyebrow-dot">Dublin Summer 2027</span>
          <h2 class="mt-4 mb-2">English. Beyond the classroom.</h2>
          <p class="text-ink-soft text-[1.08rem] max-w-[56ch] mb-3">
            Our flagship immersive English programme takes Bulgarian teenagers to Dublin, Ireland – where English becomes part of daily life.
          </p>
          <p class="font-heading font-semibold text-[1.18rem] leading-snug mb-0" style="color: #c05c00;">
            Real conversations.<br/>Real confidence.<br/>One unforgettable week.
          </p>

          <dl class="grid grid-cols-2 gap-7 my-10 py-8 border-y border-line">
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Duration</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">7 days</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Ages</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">13–17</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Small groups</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">13 students</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Programme fee</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">€1,350</dd>
            </div>
          </dl>

          <ul class="list-none p-0 m-0 flex flex-col gap-3">
            {[
              { label: 'Daily guided English practice', detail: 'with a native, CELTA-qualified teacher' },
              { label: 'Accommodation at UCD campus', detail: 'University College Dublin' },
              { label: 'Real-world communication skills', detail: 'through cultural activities and city trips across Dublin' },
              { label: 'Small groups of 13 students', detail: 'structured days with clear daily schedule' },
              { label: 'Full supervision from arrival to departure', detail: 'with a Bulgarian speaker available at all times' },
              { label: 'Book your own direct Ryanair flight', detail: 'Sofia–Dublin · we send you a step-by-step guide' },
            ].map(({ label, detail }) => (
              <li class="flex items-start gap-3 rounded-lg px-4 py-3" style="background: var(--cream); border: 1px solid var(--line);">
                <span class="flex-shrink-0 mt-[5px] w-[10px] h-[10px] rounded-full" style="background: var(--orange);"></span>
                <span class="text-[0.88rem] md:text-[0.95rem]">
                  <strong class="font-semibold text-ink">{label}</strong>
                  <span class="text-ink-soft"> – {detail}</span>
                </span>
              </li>
            ))}
          </ul>

          <div class="flex gap-3 mt-8 flex-wrap">
            <a href="/dublin-summer-2027" class="btn btn-primary">
              Explore the programme
            </a>
            <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- DUBLIN TRIPS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Trips &amp; Activities</span>
        <h2>Explore Dublin and beyond.</h2>
        <p>Six unforgettable experiences included in the programme – from ancient castles to coastal cliff walks.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {[
          { title: 'Trinity College', desc: "Walk the same paths as Oscar Wilde and Samuel Beckett at one of Ireland's most iconic universities.", tag: 'Cultural', color: '#c8d5dd', img: '/trinity-college.webp' },
          { title: 'Dublin Castle', desc: 'History meets imagination at Dublin Castle – the heart of the city for over 800 years.', tag: 'History', color: '#c8d8cc', img: '/dublin-castle.webp' },
          { title: 'The Book of Kells', desc: "Ireland's greatest cultural treasure – a world-famous illuminated manuscript and the stunning Long Room library.", tag: 'Cultural', color: '#d6d2c5', img: '/book-of-kells.webp' },
          { title: 'Howth Cliff Walk', desc: 'Fresh air, sea views, and endless photo moments! Stunning coastal cliffs, a lighthouse, and seals along the way.', tag: 'Nature', color: '#c2d0dc', img: '/howth.webp' },
          { title: "St Stephen's Green", desc: "A quiet escape in the heart of the city – Dublin's most beautiful park, calm, green, and full of character.", tag: 'Nature', color: '#c8d8cc', img: '/st-stephens-green.webp' },
          { title: 'Glendalough', desc: 'Discover the breathtaking 6th-century monastic site and twin lakes in the Wicklow Mountains. Ancient Ireland at its finest.', tag: 'History', color: '#d7c3b0', img: '/glendalough.webp' },
        ].map(({ title, desc, tag, color, img = null }) => (
          <a href="/dublin-summer-2027/trips-and-activities" class="no-underline group trip-card-link">
            <div class="bg-white border border-line rounded-lg overflow-hidden trip-card flex flex-col h-full">
              <div class="trip-card-img-wrap aspect-video w-full overflow-hidden">
                {img
                  ? <img src={img} alt={title} class="trip-card-img w-full h-full object-cover" loading="lazy" />
                  : <div class="w-full h-full" style={`background: repeating-linear-gradient(135deg, rgba(20,32,26,0.05) 0 2px, transparent 2px 14px), ${color};`}></div>
                }
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <h3 class="text-[1.05rem]">{title}</h3>
                  <span class="trip-tag text-[0.65rem] font-heading font-semibold uppercase tracking-[0.1em] px-[8px] py-[3px] rounded-full flex-shrink-0">{tag}</span>
                </div>
                <p class="text-ink-soft text-[0.9rem] leading-relaxed flex-1">{desc}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="flex justify-center mt-10">
        <a
          href="/dublin-summer-2027/trips-and-activities"
          class="inline-flex items-center gap-3 no-underline group"
          style="color: var(--ink-soft);"
        >
          <span class="w-8 h-[1.5px]" style="background: var(--orange); display: inline-block;"></span>
          <span class="font-heading font-semibold text-[0.9rem] tracking-wide group-hover:text-brand-green transition-colors">
            See all trips &amp; activities
          </span>
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="group-hover:translate-x-1 transition-transform">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="section" style="background: linear-gradient(135deg, #008037 0%, #006a2d 100%);">
    <div class="container-x">
      <div class="max-w-[840px] mx-auto text-center">
        <span class="block font-heading font-bold text-[3.5rem] leading-none text-brand-orange">&ldquo;</span>
        <p class="text-white text-[1.25rem] md:text-[1.95rem] font-heading font-semibold leading-[1.35] tracking-[-0.01em] -mt-2 mb-7 text-balance">
          Lenny is the most motivational English teacher I've ever met – fun, professional, and focused on exactly what I needed.
        </p>
        <p class="text-white/75 font-heading font-semibold text-[0.92rem] tracking-[0.04em]">– Natalya Baleva</p>
        <a href="/about" class="inline-flex items-center gap-2 mt-7 text-white/90 hover:text-white font-heading font-semibold text-[0.9rem] no-underline border-b border-white/30 hover:border-white pb-[2px] transition-colors">
          Read more student stories →
        </a>
      </div>
    </div>
  </section>


  <!-- CONTACT -->
  <section class="section section-dark">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start">
        <div>
          <span class="eyebrow eyebrow-dot" style="color: #00a84a;">Contact</span>
          <h2 class="mt-4 mb-4"><span class="text-white">Got a </span><span style="color: var(--orange-text);">question?</span><span class="text-white"> We're here.</span></h2>
          <p>Book a free consultation and we'll help you find the right programme or course.</p>

          <div class="flex flex-col gap-6 mt-8">
            {[
              { label: 'Email', value: 'immersionenglish.ie@gmail.com', icon: '✉' },
              { label: 'Phone (English)', value: '+359 893 387 464', icon: '📞' },
              { label: 'Phone (Bulgarian)', value: '+359 889 178 100', icon: '📞' },
            ].map(({ label, value, icon }) => (
              <div class="flex gap-4 items-start py-4 border-b border-white/10">
                <div class="w-9 h-9 rounded-full bg-brand-green/20 text-brand-green grid place-items-center flex-shrink-0">{icon}</div>
                <div>
                  <div class="font-heading text-[0.78rem] uppercase tracking-[0.12em] text-white/55 mb-[2px] font-semibold">{label}</div>
                  <div class="font-heading font-medium text-white text-[1.02rem]">{value}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white text-ink rounded-lg p-6 md:p-9 shadow-lift">
          <h3 class="text-[1.35rem] mb-[6px]" style="color: var(--ink);">Book a free consultation</h3>
          <p class="text-[0.95rem] mb-6" style="color: var(--ink-soft);">Tell us about your goals and we'll help you find the right course or programme. We reply within one working day.</p>

          <div id="home-form-success" style="display:none; background: var(--green); color: white; border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 20px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.92rem;">✓ Message sent! We'll be in touch within one working day.</div>

          <form name="homepage-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="grid grid-cols-1 sm:grid-cols-2 gap-[14px]">
            <input type="hidden" name="form-name" value="homepage-enquiry" />
            <p class="hidden"><input name="bot-field" /></p>
            <div class="flex flex-col gap-[6px]">
              <label for="home-first-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">First name</label>
              <input id="home-first-name" name="first-name" type="text" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px]">
              <label for="home-last-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Last name</label>
              <input id="home-last-name" name="last-name" type="text" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] sm:col-span-2">
              <label for="home-email" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Email</label>
              <input id="home-email" name="email" type="email" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
            </div>
            <div class="flex flex-col gap-[6px] sm:col-span-2">
              <label for="home-message" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Message</label>
              <textarea id="home-message" name="message" rows="3" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition resize-y min-h-[90px]"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="btn btn-primary w-full justify-center">Send message</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector('form[name="homepage-enquiry"]') as HTMLFormElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });
        form.style.display = 'none';
        const success = document.getElementById('home-form-success');
        if (success) success.style.display = 'block';
      } catch {
        alert('Something went wrong. Please email us directly at immersionenglish.ie@gmail.com');
      }
    });
  </script>
</BaseLayout>
