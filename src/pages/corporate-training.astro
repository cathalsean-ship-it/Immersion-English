---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<style>
  .eyebrow { color: #5BB8F5; }
  .eyebrow-dot::before { background: #5BB8F5; }
</style>

<BaseLayout
  title="Corporate English Training Sofia | Business English for Teams | Immersion English"
  description="Tailored Business English training for companies and teams in Sofia. CELTA-qualified native teacher with British Council experience. 1:1 and small group programmes built around your industry and goals."
  ogImage="/corporate-hero.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 54vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #0d2d1f 0%, #14201a 60%, #1a3a28 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.2) 0%, rgba(20,32,26,0.65) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
        <div>
          <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-6" style="color: #5BB8F5;">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: #5BB8F5;"></span>
            Corporate English Training
          </p>
          <h1 class="text-white mb-5" style="max-width: 20ch;">
            <span style="color: var(--orange-text);">Corporate English</span> training your team will actually <span style="color: var(--orange-text);">use.</span>
          </h1>
          <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55] mb-8">
            Tailored Business English programmes for companies and teams in Sofia. Built around your industry, your goals, and the real situations your people face every day.
          </p>
          <a href="#enquiry" class="btn btn-primary">Make an enquiry</a>
        </div>
        <div class="hidden md:grid grid-cols-2 gap-4">
          {[
            { n: '10+', label: 'Years of experience' },
            { n: 'CELTA', label: 'Qualified native teacher' },
            { n: 'British Council', label: 'Background & experience' },
            { n: '1:1 & Group', label: 'Trainings available' },
          ].map(({ n, label }) => (
            <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px;">
              <p class="font-heading font-bold text-[1.6rem] text-white leading-none mb-1">{n}</p>
              <p class="text-[0.82rem] text-white/65 font-heading font-semibold">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-12 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot" style="color: #5BB8F5;">Why it matters</span>
          <h2 class="mt-4 mb-5">Your team's English is a business asset.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-5">
            In international meetings, client calls, and written correspondence, how confidently your people communicate in English directly affects how your company is perceived — and how deals are won.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed">
            Generic language courses teach grammar. We teach your team to perform — in the specific situations that matter most to your business.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          {[
            { title: 'Client-facing communication', body: 'Presentations, negotiations, calls, and meetings with international clients and partners.' },
            { title: 'Internal reporting & correspondence', body: 'Emails, reports, proposals, and written communication that reflect well on your organisation.' },
            { title: 'CV and interview preparation', body: 'For employees preparing for international roles or internal promotions requiring English proficiency.' },
            { title: 'Confidence under pressure', body: 'Speaking in a second language in high-stakes situations is a skill. We build it deliberately.' },
          ].map(({ title, body }) => (
            <div class="flex gap-4 items-start p-5 bg-white rounded-xl shadow-soft" style="border: 1px solid var(--line);">
              <span class="flex-shrink-0 mt-[7px] w-[8px] h-[8px] rounded-full" style="background: var(--orange);"></span>
              <div>
                <p class="font-heading font-semibold text-ink text-[1rem] mb-1">{title}</p>
                <p class="text-ink-soft text-[0.93rem] leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PHOTO BREAK -->
  <div style="height: 480px; overflow: hidden;">
    <img
      src="/corporate-hero.webp"
      alt="Corporate English training — direction and clarity"
      class="img-greyscale no-hover-reveal w-full h-full object-cover"
      style="object-position: center 20%;"
      loading="lazy"
    />
  </div>

  <!-- PROGRAMMES -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot" style="color: #5BB8F5;">Our programmes</span>
        <h2>Two ways to train your team.</h2>
        <p>Whether you need targeted coaching for one employee or a structured programme for a whole team, we build it around you.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- 1:1 -->
        <div class="bg-white border border-line rounded-xl p-7 flex flex-col shadow-soft">
          <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full mb-4 inline-block" style="background: #e8f0fe; color: #3b5bdb;">Individual</span>
          <h3 class="text-[1.2rem] mb-2">1:1 Business English Coaching</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            Intensive, personalised coaching for senior employees, managers, or anyone who needs to perform in English at a high level. Sessions are built entirely around their role, their goals, and their specific challenges.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              'Tailored to the employee\'s industry and role',
              'Meetings, presentations, negotiations, emails',
              'CV and interview preparation',
              'Flexible scheduling around working hours',
              'Regular progress feedback',
              'Monthly invoicing available',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">€60 <span class="text-[0.85rem] font-normal text-ink-soft">per session</span></p>
            <p class="text-[0.82rem] text-ink-soft mt-1">10-session package: <strong class="text-ink">€540</strong> <span style="color: var(--green);" class="font-semibold text-[0.78rem]">save 10%</span></p>
          </div>
        </div>

        <!-- Small group -->
        <div class="bg-white rounded-xl p-7 flex flex-col shadow-soft" style="border: 1.5px solid var(--green);">
          <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full mb-4 inline-block" style="background: var(--green-soft); color: var(--green);">Team</span>
          <h3 class="text-[1.2rem] mb-2">Small Group Team Training</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-5">
            Structured group sessions for teams who work together in English — sales, client services, operations, or any department with shared communication needs. Up to 6 participants per group.
          </p>
          <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
            {[
              'Up to 6 participants per group',
              'Built around your team\'s shared context',
              'Real workplace scenarios and role plays',
              'Speaking, listening, and professional writing',
              'Flexible scheduling around working hours',
              'Monthly invoicing available',
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                {item}
              </li>
            ))}
          </ul>
          <div class="pt-5 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.3rem]">Custom pricing</p>
            <p class="text-[0.82rem] text-ink-soft mt-1">Based on group size and programme length. Get in touch for a quote.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY IMMERSION ENGLISH -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-8 md:gap-20 items-start">

        <!-- Sticky left: heading + Lenny profile -->
        <div class="md:sticky md:top-[90px]">
          <span class="eyebrow eyebrow-dot" style="color: #5BB8F5;">Why choose us</span>
          <h2 class="mt-4 mb-5">Serious credentials. Personal approach.</h2>
          <p class="text-ink-soft leading-relaxed mb-8">We're not a language school with a roster of teachers. Every corporate programme is delivered by the same person — consistently, personally, and with full accountability.</p>

          <!-- Lenny mini profile -->
          <div class="rounded-xl overflow-hidden shadow-soft" style="border: 1px solid var(--line); background: white;">
            <img
              src="/team-lenny.webp"
              alt="Cathal (Lenny) Leonard – Senior English Teacher"
              class="w-full object-cover"
              style="aspect-ratio: 4/3; object-position: center top;"
              loading="lazy"
            />
            <div class="p-5">
              <p class="font-heading font-bold text-ink text-[1.05rem] mb-1">Cathal (Lenny) Leonard</p>
              <p class="text-[0.82rem] font-semibold mb-3" style="color: var(--green);">Founder · Senior English Teacher</p>
              <ul class="flex flex-col gap-1 text-[0.82rem] text-ink-soft">
                {[
                  'Native English speaker from Ireland',
                  'CELTA-qualified (Cambridge Certificate in Teaching English to Speakers of Other Languages)',
                  '10+ years teaching adults & professionals',
                  'General English & Business English teacher at the British Council Sofia (10 years)',
                  'Founder, Immersion English',
                  'BA in History, Sociology & Politics — NUI Galway, Ireland',
                  'MA in International Relations — Queen\'s University Belfast',
                  'Led international summer programmes in Oxford & Cambridge',
                ].map(item => (
                  <li class="flex items-start gap-2">
                    <span class="w-[6px] h-[6px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Right: credentials list -->
        <div class="flex flex-col divide-y divide-line">
          {[
            { title: 'CELTA-qualified native teacher', body: 'The CELTA (Cambridge Certificate in Teaching English to Speakers of Other Languages) is the internationally recognised gold standard in English language teaching, awarded by Cambridge Assessment English. Lenny holds a CELTA qualification alongside over 10 years of experience teaching adults and professionals.' },
            { title: 'British Council background', body: 'Lenny taught General English and Business English at the British Council Sofia for 10 years. He also led international summer programmes in Oxford and Cambridge — corporate clients get that depth of experience in a fully personalised format.' },
            { title: 'Built around your business', body: 'Every programme starts with a consultation to understand your team\'s roles, goals, and working context. No off-the-shelf syllabi — everything is tailored.' },
            { title: 'Consistent delivery', body: 'One teacher, one approach, full continuity. Your team builds a relationship with their teacher — which is how real progress happens.' },
            { title: 'Flexible and streamlined', body: 'Sessions scheduled around your team\'s working hours. Monthly invoicing available for companies. No lengthy onboarding process.' },
          ].map(({ title, body }) => (
            <div class="py-6 flex gap-4 items-start">
              <span class="flex-shrink-0 mt-[7px] w-[8px] h-[8px] rounded-full" style="background: var(--orange);"></span>
              <div>
                <p class="font-heading font-semibold text-ink text-[1.02rem] mb-1">{title}</p>
                <p class="text-ink-soft text-[0.95rem] leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ENQUIRY FORM -->
  <section class="section section-dark" id="enquiry">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-start">

        <!-- Left: context -->
        <div>
          <span class="eyebrow eyebrow-dot" style="color: #5BB8F5;">Corporate enquiry</span>
          <h2 class="mt-4 mb-5 text-white">Tell us about your team.</h2>
          <p style="color: rgba(254,255,254,0.74);" class="text-[1.05rem] leading-relaxed mb-8">
            Fill in the form and we'll get back to you within one working day with a programme proposal tailored to your team's needs.
          </p>
          <div class="flex flex-col gap-4">
            {[
              { n: '01', text: 'You fill in the enquiry form below' },
              { n: '02', text: 'We prepare a tailored programme proposal' },
              { n: '03', text: 'We schedule a call to discuss and finalise' },
            ].map(({ n, text }) => (
              <div class="flex gap-4 items-center">
                <span class="font-heading font-bold text-[1.3rem] leading-none flex-shrink-0" style="color: var(--orange-text);">{n}</span>
                <p class="text-[0.95rem]" style="color: rgba(254,255,254,0.74);">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-white border border-line rounded-xl p-7 md:p-9 shadow-lift">
          <h3 class="text-[1.3rem] mb-1">Corporate Enquiry</h3>
          <p class="text-ink-soft text-[0.93rem] mb-6">We reply within one working day.</p>

          <form name="corporate-enquiry" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-4">
            <input type="hidden" name="form-name" value="corporate-enquiry" />
            <input type="hidden" name="subject" value="[Immersion English] New Corporate Enquiry" />
            <p class="hidden"><input name="bot-field" /></p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-[6px]">
                <label for="corp-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Full name</label>
                <input id="corp-name" name="full-name" type="text" placeholder="Jana Georgieva" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
              </div>
              <div class="flex flex-col gap-[6px]">
                <label for="corp-company" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Company</label>
                <input id="corp-company" name="company" type="text" placeholder="Acme Ltd." class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-[6px]">
                <label for="corp-email" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Email</label>
                <input id="corp-email" name="email" type="email" placeholder="jana@company.com" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
              </div>
              <div class="flex flex-col gap-[6px]">
                <label for="corp-phone" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Phone</label>
                <input id="corp-phone" name="phone" type="tel" placeholder="+359 88 000 0000" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition" />
              </div>
            </div>

            <div class="flex flex-col gap-[6px]">
              <label for="corp-team-size" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Team size</label>
              <select id="corp-team-size" name="team-size" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition appearance-none cursor-pointer">
                <option value="">Select team size…</option>
                <option>1 person (individual coaching)</option>
                <option>2–3 people</option>
                <option>4–6 people</option>
                <option>7+ people</option>
              </select>
            </div>

            <div class="flex flex-col gap-[6px]">
              <label for="corp-goals" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Primary goal</label>
              <select id="corp-goals" name="primary-goal" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition appearance-none cursor-pointer">
                <option value="">Select primary goal…</option>
                <option>Meetings & presentations</option>
                <option>Client communication & negotiations</option>
                <option>Professional writing (emails, reports)</option>
                <option>CV & interview preparation</option>
                <option>General Business English</option>
                <option>Other</option>
              </select>
            </div>

            <div class="flex flex-col gap-[6px]">
              <label for="corp-message" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Anything else we should know?</label>
              <textarea id="corp-message" name="message" rows="3" placeholder="Industry, current English level, preferred schedule, budget…" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-brand-green focus:shadow-[0_0_0_3px_rgba(0,128,55,0.12)] transition resize-none"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-full justify-center mt-1">Submit enquiry</button>
            <p class="text-center text-ink-soft text-[0.82rem]">We reply within one working day.</p>

          </form>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
