---
import BaseLayout from '../layouts/BaseLayout.astro';
// Corporate rates come from the data file. They used to be literals on this
// page — once in the visible price block and again in the JSON-LD below — so
// the page could quote one figure to visitors and a different one to Google
// with nothing to catch it.
import { courses } from '../data/courses';

const corp = courses.corporateTraining;
const corpUnit = `${corp.lessonMinutes}-minute ${corp.unitNoun}`;
const corpBundle = corp.bundles[0];
---

<style>
  /* This page runs on the blue accent instead of the site's orange, on purpose.
     Owner's decision, 29 Aug 2026 — corporate training should not look like the
     rest of the site. See the --blue comment in global.css before "fixing" it.
     Use --blue-on-dark over the hero and any .section-dark; --blue is for light
     grounds only. */
  .eyebrow { color: var(--blue); }
  .eyebrow-dot::before { background: var(--blue); }
</style>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Immersion English",
  "url": "https://immersion-english.com",
  "address": { "@type": "PostalAddress", "addressLocality": "Sofia", "addressCountry": "BG" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Corporate English Training Sofia – Корпоративно обучение по английски",
    "itemListElement": [
      {
        "@type": "Course",
        "name": "1:1 Business English Coaching Sofia",
        "description": `Personalised Business English coaching for professionals and senior employees in Sofia. Native CELTA-qualified teacher with British Council experience. Meetings, presentations, negotiations, emails, CV and interview preparation. Sessions are ${corp.lessonMinutes} minutes.`,
        "provider": { "@type": "EducationalOrganization", "name": "Immersion English", "url": "https://immersion-english.com" },
        "courseMode": ["online", "onsite"],
        "educationalLevel": "B2-C2",
        "timeRequired": `PT${corp.lessonMinutes}M`,
        "audience": { "@type": "Audience", "audienceType": "Business professionals, corporate teams, Sofia-based companies" },
        "inLanguage": "en",
        "offers": { "@type": "Offer", "price": String(corp.perLesson), "priceCurrency": "EUR", "availability": "https://schema.org/InStock", "description": `€${corp.perLesson} per ${corpUnit}. ${corpBundle.lessons}-${corp.unitNoun} package €${corpBundle.price}.` }
      },
      {
        "@type": "Course",
        "name": "Small Group Business English Training Sofia",
        "description": `Structured group Business English training for corporate teams in Sofia. Up to 6 participants per group. Built around your team's industry, roles and communication goals. Native teacher with British Council background. Sessions are ${corp.lessonMinutes} minutes.`,
        "provider": { "@type": "EducationalOrganization", "name": "Immersion English", "url": "https://immersion-english.com" },
        "courseMode": ["online", "onsite"],
        "educationalLevel": "B2-C2",
        "timeRequired": `PT${corp.lessonMinutes}M`,
        "audience": { "@type": "Audience", "audienceType": "Corporate teams, HR managers, Sofia-based companies" },
        "inLanguage": "en",
        "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "description": "Custom pricing based on group size and programme length." }
      }
    ]
  }
}, null, 2)} />

<BaseLayout
  title="Corporate English Training Sofia | Бизнес английски за екипи | Immersion English"
  description="Tailored Business English training for companies and teams in Sofia. Корпоративно обучение по английски за екипи – CELTA-qualified native teacher, British Council background. 1:1 and small group programmes built around your industry and goals."
  ogImage="/corporate-hero.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 54vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #0d2d1f 0%, #14201a 60%, #1a3a28 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.2) 0%, rgba(20,32,26,0.65) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
        <div>
          <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-6" style="color: var(--blue-on-dark);">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--blue-on-dark);"></span>
            Corporate English Training
          </p>
          <h1 class="text-white mb-5" style="max-width: 20ch;">
            <span style="color: var(--orange);">Corporate English</span> training your team will actually <span style="color: var(--orange);">use.</span>
          </h1>
          <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55] mb-8">
            Tailored Business English programmes for companies and teams in Sofia. Built around your industry, your goals, and the real situations your people face every day.
          </p>
          <a href="#enquiry" class="btn btn-primary" style="background: var(--blue); border-color: var(--blue); color: #fff; box-shadow: 0 6px 20px rgba(255,255,255,0.25);">Make an enquiry</a>
        </div>
        <div class="hidden md:grid grid-cols-2 gap-4">
          {[
            { n: '10+', label: 'Years of experience' },
            { n: 'CELTA', label: 'Qualified native teacher' },
            { n: 'British Council', label: 'Background & experience' },
            { n: '1:1 & Group', label: 'Trainings available' },
          ].map(({ n, label }) => (
            <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 20px 24px;">
              <p class="font-heading font-bold text-[1.6rem] text-white leading-none mb-1">{n}</p>
              <p class="text-[0.82rem] text-white/65 font-heading font-semibold">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-12 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot" style="color: var(--blue);">Why it matters</span>
          <h2 class="mt-4 mb-5">Your team's English is a business asset – and a competitive advantage.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-5">
            In international meetings, client calls, and written correspondence, the way your team communicates in English shapes how your company is perceived – and how deals are won.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed">
            Our Business English training in Sofia goes beyond grammar. We focus on real performance – the presentations, negotiations, and workplace situations that matter most to your business.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          {[
            { title: 'Client-facing communication', body: 'Presentations, negotiations, calls, and meetings with international clients and partners.' },
            { title: 'Internal reporting & correspondence', body: 'Emails, reports, proposals, and written communication that reflect well on your organisation.' },
            { title: 'CV and interview preparation', body: 'For employees preparing for international roles or internal promotions requiring English proficiency.' },
            { title: 'Confidence under pressure', body: 'Speaking in a second language in high-stakes situations is a skill. We build it deliberately.' },
          ].map(({ title, body }) => (
            <div class="flex gap-4 items-start p-5 bg-white rounded-xl shadow-soft" style="border: 1px solid var(--line);">
              <span class="flex-shrink-0 mt-[7px] w-[8px] h-[8px] rounded-full" style="background: var(--orange);"></span>
              <div>
                <p class="font-heading font-semibold text-ink text-[1rem] mb-1">{title}</p>
                <p class="text-ink-soft text-[0.93rem] leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PHOTO BREAK -->
  <div style="height: 480px; overflow: hidden;">
    <img
      src="/corporate-hero.webp"
      alt="Corporate English training – direction and clarity"
      class="img-greyscale w-full h-full object-cover"
      style="object-position: center 20%;"
      loading="lazy"
    />
  </div>

  <!-- PROGRAMMES -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot" style="color: var(--blue);">Our programmes</span>
        <h2>Business English Training in Sofia – Tailored programmes for professionals and teams.</h2>
        <p>Whether you need targeted coaching for one employee or a structured programme for a whole team, we build it around you.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- 1:1 Communication & English Coaching -->
        <div class="bg-white border border-line rounded-xl overflow-hidden flex flex-col shadow-soft">
          <div style="background: var(--orange); height: 4px;"></div>
          <div class="p-7 flex flex-col flex-1">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: var(--blue-soft); color: var(--blue);">Individual</span>
              <span class="text-[0.72rem] font-heading font-semibold text-ink-soft">1 employee</span>
            </div>
            <h3 class="text-[1.2rem] mb-1">1:1 Communication & English Coaching</h3>
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
            <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-4">
              More than English lessons – this is <strong class="text-ink">professional communication coaching</strong> for high-performers. Built around the employee's role, goals, and the specific situations where they need to perform at their best.
            </p>
            <div class="rounded-lg px-4 py-3 mb-5" style="background: #f0f4ff; border-left: 3px solid var(--blue); min-height: 80px;">
              <p class="font-heading font-semibold text-[0.78rem] uppercase tracking-wide mb-1" style="color: var(--blue);">Best for</p>
              <p class="text-[0.85rem] text-ink-soft">Senior managers, executives, and high-performers who represent the company externally and need to project confidence, clarity, and authority in English.</p>
            </div>
            <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
              {[
                'Meetings, negotiations, and client presentations',
                'Executive presence – voice, pace, and authority',
                'Presentation skills: structure, delivery, Q&A',
                'Body language and non-verbal communication',
                'Storytelling for business and stakeholder communication',
                'Cross-cultural communication and international confidence',
                'Progress reports available for HR on request',
                'Monthly invoicing – no admin burden',
                'Level: B2 and above',
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-5 border-t border-line">
              <p class="font-heading font-bold text-ink text-[1.3rem]">€{corp.perLesson}{' '}<span class="text-[0.85rem] font-normal text-ink-soft">per {corpUnit}</span></p>
              <p class="text-[0.82rem] text-ink-soft mt-1">{corpBundle.lessons} sessions: <strong class="text-ink">€{corpBundle.price}</strong> <span style="color: var(--blue);" class="font-semibold">&nbsp;– save {corpBundle.savePercent}%</span></p>
            </div>
          </div>
        </div>

        <!-- Small Group Team Training -->
        <div class="rounded-xl overflow-hidden flex flex-col shadow-soft" style="border: 2px solid var(--blue); background: white;">
          <div style="background: var(--blue); height: 4px;"></div>
          <div class="p-7 flex flex-col flex-1">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[0.68rem] font-heading font-semibold uppercase tracking-[0.1em] px-[10px] py-[4px] rounded-full" style="background: var(--blue-soft); color: var(--blue);">Team</span>
              <span class="text-[0.72rem] font-heading font-semibold text-ink-soft">Up to 6 people</span>
            </div>
            <h3 class="text-[1.2rem] mb-1">Small Group Business English Training</h3>
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
            <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-4">
              Structured sessions for <strong class="text-ink">teams who work together</strong> – built around your shared context, your industry, and the real situations your people face every day.
            </p>
            <div class="rounded-lg px-4 py-3 mb-5" style="background: #f0f4ff; border-left: 3px solid var(--blue); min-height: 80px;">
              <p class="font-heading font-semibold text-[0.78rem] uppercase tracking-wide mb-1" style="color: var(--blue);">Best for</p>
              <p class="text-[0.85rem] text-ink-soft">Sales teams, client services, operations – any group with shared communication goals who need to perform in English together.</p>
            </div>
            <ul class="flex flex-col gap-2 text-[0.88rem] text-ink-soft mb-6 flex-1">
              {[
                'Up to 6 participants per group',
                "Built around your team's shared industry and context",
                'Real workplace scenarios, role plays, and case studies',
                'Speaking, listening, and professional writing',
                'Flexible scheduling around working hours',
                'Monthly invoicing available',
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="pt-5 border-t border-line">
              <p class="font-heading font-bold text-ink text-[1.3rem]">Custom pricing</p>
              <p class="text-[0.82rem] text-ink-soft mt-1">Based on group size and programme length. Get in touch for a tailored quote.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY IMMERSION ENGLISH -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-8 md:gap-20 items-start">

        <!-- Sticky left: heading + Lenny profile -->
        <div>
          <span class="eyebrow eyebrow-dot" style="color: var(--blue);">Why choose us</span>
          <h2 class="mt-4 mb-5">Why choose a native English teacher for your corporate training in Sofia.</h2>
          <p class="text-ink-soft leading-relaxed mb-8">We're not a language school with a roster of teachers. Every corporate programme is delivered by the same person – consistently, personally, and with full accountability.</p>

          <!-- Lenny mini profile — float layout so text wraps around photo -->
          <div style="border: 1px solid var(--line); background: white; border-radius: 12px; padding: 24px; overflow: hidden;">
            <div style="float: left; width: 140px; margin: 0 20px 12px 0; border-radius: 8px; overflow: hidden; flex-shrink: 0;">
              <img
                src="/team-lenny.webp"
                alt="Cathal (Lenny) Leonard – Senior English Teacher"
                class="w-full object-cover"
                style="aspect-ratio: 3/4; object-position: center top; display: block;"
                loading="lazy"
              />
            </div>
            <p class="font-heading font-bold text-ink text-[1.05rem] mb-1">Cathal (Lenny) Leonard</p>
            <p class="text-[0.82rem] font-semibold mb-3" style="color: var(--blue);">Founder · Senior English Teacher</p>
            <ul class="flex flex-col gap-1 text-[0.82rem] text-ink-soft">
              {[
                'From Dublin, Ireland – native English speaker',
                'Founder of Immersion English',
                'Teaches every corporate programme personally',
                'Known for making complex ideas feel simple',
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="w-[6px] h-[6px] rounded-full flex-shrink-0 mt-[5px]" style="background: var(--orange);"></span>
                  {item}
                </li>
              ))}
            </ul>
            <div style="clear: both;"></div>
          </div>
        </div>

        <!-- Right: credentials list -->
        <div class="flex flex-col divide-y divide-line">
          {[
            { title: 'Gold-standard teaching qualification', body: 'CELTA (Cambridge Certificate in Teaching English to Speakers of Other Languages) is the internationally recognised benchmark for English language teaching. It means your team gets structured, evidence-based teaching – not improvised conversation practice.' },
            { title: 'Proven with professionals', body: '10 years teaching Business English at the British Council Sofia – working with professionals across sectors who needed to perform in English at a high level. That experience informs every corporate programme we deliver.' },
            { title: 'Built around your business', body: 'Every programme starts with a consultation to understand your team\'s roles, goals, and working context. No off-the-shelf syllabi – everything is tailored.' },
            { title: 'Consistent delivery', body: 'One teacher, one approach, full continuity. Your team builds a relationship with their teacher – which is how real progress happens.' },
            { title: 'Flexible and streamlined', body: 'Sessions scheduled around your team\'s working hours. Monthly invoicing available for companies. No lengthy onboarding process.' },
          ].map(({ title, body }) => (
            <div class="py-6 flex gap-4 items-start">
              <span class="flex-shrink-0 mt-[7px] w-[8px] h-[8px] rounded-full" style="background: var(--orange);"></span>
              <div>
                <p class="font-heading font-semibold text-ink text-[1.02rem] mb-1">{title}</p>
                <p class="text-ink-soft text-[0.95rem] leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ENQUIRY FORM -->
  <section class="section section-dark" id="enquiry">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-start">

        <!-- Left: context -->
        <div>
          <span class="eyebrow eyebrow-dot" style="color: var(--blue-on-dark);">Corporate enquiry</span>
          <h2 class="mt-4 mb-5 text-white">Start your corporate English training programme today.</h2>
          <p style="color: rgba(254,255,254,0.74);" class="text-[1.05rem] leading-relaxed mb-8">
            Fill in the form and we'll get back to you within one working day to arrange a call about your team's needs.
          </p>
          <div class="flex flex-col gap-4">
            {[
              { n: '01', text: 'You fill in the enquiry form below' },
              { n: '02', text: 'We schedule a call to discuss your needs' },
              { n: '03', text: 'We design a programme and finalise with you' },
            ].map(({ n, text }) => (
              <div class="flex gap-4 items-center">
                <span class="font-heading font-bold text-[1.3rem] leading-none flex-shrink-0" style="color: var(--orange);">{n}</span>
                <p class="text-[0.95rem]" style="color: rgba(254,255,254,0.74);">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: form -->
        <div class="surface-light bg-white border border-line rounded-xl p-7 md:p-9 shadow-lift">
          <div id="corp-form-success" style="display:none; background: var(--blue); color: white; border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 20px; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.92rem;">✓ Enquiry sent! We'll be in touch within one working day to arrange a call.</div>
          <h3 class="text-[1.3rem] mb-1">Corporate Enquiry</h3>
          <p class="text-ink-soft text-[0.93rem] mb-6">We reply within one working day.</p>

          <form name="corporate-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-4">
            <input type="hidden" name="form-name" value="corporate-enquiry" />
            <input type="hidden" name="subject" value="[Immersion English] New Corporate Enquiry" />
            <p class="hidden"><input name="bot-field" /></p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-[6px]">
                <label for="corp-name" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Full name</label>
                <input id="corp-name" name="full-name" type="text" placeholder="Jana Georgieva" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition" />
              </div>
              <div class="flex flex-col gap-[6px]">
                <label for="corp-company" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Company</label>
                <input id="corp-company" name="company" type="text" placeholder="Acme Ltd." class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-[6px]">
                <label for="corp-email" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Email</label>
                <input id="corp-email" name="email" type="email" required placeholder="jana@company.com" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition" />
              </div>
              <div class="flex flex-col gap-[6px]">
                <label for="corp-phone" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Phone</label>
                <input id="corp-phone" name="phone" type="tel" placeholder="+359 88 000 0000" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition" />
              </div>
            </div>

            <div class="flex flex-col gap-[6px]">
              <label for="corp-team-size" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Team size</label>
              <select id="corp-team-size" name="team-size" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition appearance-none cursor-pointer">
                <option value="">Select team size…</option>
                <option>1 person (individual coaching)</option>
                <option>2–3 people</option>
                <option>4–6 people</option>
                <option>7+ people</option>
              </select>
            </div>

            <div class="flex flex-col gap-[6px]">
              <label for="corp-goals" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Primary goal</label>
              <select id="corp-goals" name="primary-goal" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition appearance-none cursor-pointer">
                <option value="">Select primary goal…</option>
                <option>Meetings & presentations</option>
                <option>Client communication & negotiations</option>
                <option>Professional writing (emails, reports)</option>
                <option>CV & interview preparation</option>
                <option>General Business English</option>
                <option>Other</option>
              </select>
            </div>

            <div class="flex flex-col gap-[6px]">
              <label for="corp-message" class="font-heading text-[0.75rem] uppercase tracking-[0.1em] text-ink-soft font-semibold">Anything else we should know?</label>
              <textarea id="corp-message" name="message" rows="3" placeholder="Industry, current English level, preferred schedule, budget…" class="font-body text-[0.98rem] px-[14px] py-3 border border-line-strong rounded-[10px] bg-white text-ink focus:outline-none focus:border-[var(--blue)] focus:shadow-[0_0_0_3px_rgba(26,133,214,0.18)] transition resize-none"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-full justify-center mt-1" style="background: var(--blue); border-color: var(--blue); color: #fff; box-shadow: 0 6px 20px rgba(255,255,255,0.25);">Submit enquiry</button>
            <p class="text-center text-ink-soft text-[0.82rem]">We reply within one working day.</p>

          </form>
        </div>

      </div>
    </div>
  </section>


<script>
  const corpForm = document.querySelector('form[name="corporate-enquiry"]');
  const corpSuccess = document.getElementById('corp-form-success');
  if (corpForm) {
    corpForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(corpForm);
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString(),
        });
        // fetch only rejects on network failure. Without this, a 404 or 500 from
        // Netlify still showed the success message and the enquiry was lost.
        if (!res.ok) throw new Error(`Form POST failed: ${res.status}`);
        corpForm.style.display = 'none';
        if (corpSuccess) corpSuccess.style.display = 'block';
      } catch (err) {
        alert('Something went wrong. Please email us directly at immersionenglish.ie@gmail.com');
      }
    });
  }
</script>
</BaseLayout>
