---
/**
 * Dublin Summer FAQs — rebuilt for the MLA / NCI arrangement.
 *
 * SOURCING RULE FOR THIS PAGE:
 * Every answer below comes from one of exactly two places —
 *   1. dublin-overview-copy.md (the approved 2027 copy), or
 *   2. MLA "Junior Programmes 2026" catalogue, p.44 (the Dublin / NCI centre).
 * Nothing here is invented, and nothing is carried over from the cancelled UCD
 * programme. Where 2027 figures are unconfirmed (price, dates, deposit terms)
 * the answer says so and routes to a consultation — it does NOT guess.
 *
 * The previous UCD-era FAQ set was removed because it was false or
 * self-contradictory throughout: EUR 1,350 fee, a EUR 350 deposit in one answer
 * and a EUR 650 deposit two answers later, "meals are not included" against the
 * new full-board arrangement, "the majority of rooms are not en suite" against
 * en-suite, "All students will be Bulgarian" against an international centre,
 * "maximum of 13 students" against 13 average / 18 maximum, UCD as the venue,
 * "Our teachers have CELTA" when MLA's centre staff teach, and a reference to an
 * unrelated provider called ICE.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dublin, durationLabel } from '../../data/dublin';

const { provider, venue, ages, classSize, lessonsPerWeek, hoursPerWeek, durationsWeeks, startDates, price, excursions, groupLeader, securityDeposit, airportTransferFrom, visaRequired } = dublin;

const fullDay = (excursions ?? []).filter(e => e.duration === 'full-day');
const halfDay = (excursions ?? []).filter(e => e.duration === 'half-day');

const sections = [
  {
    id: 'who-runs-it',
    heading: 'Who Runs the Programme',
    faqs: [
      {
        q: 'Who actually runs this programme?',
        a: `${provider.brand} runs it. Immersion English is a booking agent: we enrol your child, handle the documentation and pre-departure support, and travel with the group from Sofia and back. The teaching, accommodation, activities and on-site supervision in Dublin are all provided by MLA at their summer centre.`,
      },
      {
        q: 'Who is my contract with?',
        a: `Your booking contract is with ${provider.legalEntity}, MLA's Irish operating company, under MLA's terms and conditions. We will give you those terms in full before you pay anything.`,
      },
      {
        q: 'Does Immersion English teach the classes?',
        a: `No. Classes are taught by the centre's own qualified native-speaker teachers. ${groupLeader.name} travels as group leader, and his job is everything around the classes – settling students in, checking in every day, sorting out whatever comes up, and being the person parents can ring.`,
      },
      {
        q: 'Is this the same as the previous programme at UCD?',
        a: 'No. That programme is cancelled. This is a different venue, a different provider, a different age range and a different format – an international summer centre rather than a group of Bulgarian students travelling on their own.',
      },
    ],
  },
  {
    id: 'the-centre',
    heading: 'The Centre and the Classes',
    faqs: [
      {
        q: 'Where is the centre?',
        a: `The ${venue.name} in ${venue.area}, right in the heart of the city and about ten minutes' walk from Temple Bar and the main attractions. Lessons, accommodation and activities all take place on the campus.`,
      },
      {
        q: 'How many lessons are there each week?',
        a: `${lessonsPerWeek} lessons every week, which is ${hoursPerWeek} hours of classroom instruction, taught by the centre's qualified native-speaker teachers. An online placement test before departure puts every student in the right class.`,
      },
      {
        q: 'How big are the classes?',
        a: `Classes average ${classSize.average} students, with a maximum of ${classSize.maximum}.`,
      },
      {
        // Careful: ages here is OUR group's range, not the centre's. MLA's
        // catalogue lists the NCI centre as 12-20. Do not reword this to claim
        // the centre only takes our range — that would be false.
        q: 'What ages is this for?',
        a: `Our group is for students aged ${ages.min} to ${ages.max}. The centre itself takes a slightly wider range, so there will be some students older than ${ages.max} on site from other groups. Students are grouped with others their own age for classes.`,
      },
      {
        q: 'Are students grouped by age?',
        // Confirmed for classes only. See dublin.ts ageGroupingScope — MLA has not
        // confirmed in writing whether this extends to residence and evening
        // activities. Do not broaden this answer until they do.
        a: 'Students are grouped with others their own age for classes, and the placement test sorts them by level as well. We have asked MLA to confirm in writing how age grouping works in the residence and during evening activities, and we will tell you exactly what they say before you book.',
      },
      {
        q: 'What nationalities will be there?',
        a: 'It is an international centre – students come from across Europe and beyond. That is the point of it. English stops being the subject and becomes how you order lunch, argue about football, and make a friend by Wednesday.',
      },
      {
        q: 'Will anyone there speak Bulgarian?',
        a: 'Yes. A Bulgarian speaker is available throughout the stay.',
      },
    ],
  },
  {
    id: 'accommodation-and-meals',
    heading: 'Accommodation and Meals',
    faqs: [
      {
        q: 'Where do students sleep?',
        a: `In full-board, en-suite accommodation on the ${venue.shortName} campus, in single or twin rooms. Everything takes place within the campus.`,
      },
      {
        q: 'Are meals included?',
        a: 'Yes. Full board is included, from dinner on the day of arrival to breakfast on the day of departure. The centre also provides a prepaid meal card for excursion days.',
      },
      {
        q: 'What if my child has a dietary requirement or an allergy?',
        a: 'Tell us at the point of enrolment and we will pass it to MLA in writing before departure so the centre can cater for it. Bring it up at the free consultation and we will make sure nothing gets lost.',
      },
    ],
  },
  {
    id: 'trips-and-activities',
    heading: 'Trips and Activities',
    faqs: [
      {
        q: 'What excursions are included?',
        a: `MLA's published Dublin programme includes ${fullDay.length} full-day excursions – ${fullDay.map(e => e.title).join(' and ')} – and ${halfDay.length} half-day excursions in Dublin: ${halfDay.map(e => e.title).join('; ')}. Transport and entry tickets are included, with nothing extra to pay on the day. Excursions are run by MLA's local staff.`,
        link: { href: '/dublin-summer-2027/trips-and-activities', label: 'See the full excursion programme →' },
      },
      {
        q: 'Do I have to pay extra for trips?',
        a: 'No. The full excursion programme is built into the price – transport and entry tickets included.',
      },
      {
        q: 'What happens in the evenings?',
        a: "Evening and weekend activities are run by the centre's own activity team – discos, karaoke, quiz and games nights, a talent show and a graduation ceremony among them.",
      },
    ],
  },
  {
    id: 'supervision-and-safety',
    heading: 'Supervision and Safety',
    faqs: [
      {
        q: 'Who is looking after my child?',
        a: `On site, MLA. Their centre staff run the residence, the classes and the activities, and MLA provide a welfare manager responsible for students' wellbeing and 24-hour on-site medical assistance. Travelling with the group, ${groupLeader.name} goes from the gate in Sofia to the arrivals hall on the way home and is there for the whole stay.`,
      },
      {
        q: 'Does my child travel alone?',
        a: 'No. Nobody gets handed over at the airport. The group flies together from Sofia with the group leader and comes home together.',
      },
      {
        q: 'Who do I call if something happens?',
        a: `You call ${groupLeader.name} directly. Being the person parents can ring is a large part of the job, and a Bulgarian speaker is available throughout.`,
      },
    ],
  },
  {
    id: 'dates-prices-booking',
    heading: 'Dates, Prices and Booking',
    faqs: [
      {
        q: 'How much does it cost?',
        // TODO: awaiting MLA 2027 confirmation — retail price pending 2027 net rates.
        // Do NOT restate the old EUR 1,350, or quote a figure from the 2026 catalogue.
        a: price.fromAmount === null
          ? 'MLA have not yet published their 2027 rates, so we are not quoting a price we would have to change. Book a free consultation and we will tell you exactly where things stand, and contact you the moment the 2027 price is confirmed.'
          : `From €${price.fromAmount.toLocaleString('en-IE')}.`,
        link: { href: '/contact', label: 'Book a free consultation →' },
      },
      {
        q: 'When are the 2027 dates?',
        // TODO: awaiting MLA 2027 confirmation — 2027 start dates not published.
        // The 2026 dates must NOT be presented as 2027 dates.
        a: startDates === null
          ? 'MLA have not published their 2027 start dates yet. As soon as they do we will publish them here and contact anyone who has registered an interest.'
          : `Departures begin ${startDates[0]}.`,
      },
      {
        q: 'How long can my child stay?',
        a: `${durationLabel(durationsWeeks)}. Other durations are sometimes available on request – ask us at the consultation.`,
      },
      {
        q: 'How do I hold a place?',
        // TODO: awaiting MLA 2027 confirmation — deposit percentage and payment
        // dates against 2027 terms. Do not restate the old EUR 350 / EUR 1,000 / 31 May.
        a: 'Places are limited and confirmed first come, first served. A deposit holds the place and the balance is due in the spring. The exact deposit and payment dates come from MLA\'s 2027 terms, which are not published yet, so we will confirm them in writing before you pay anything.',
      },
      {
        q: 'What is not included?',
        a: `Flights, airport transfers (from €${airportTransferFrom.amount} each way), travel and medical insurance, and personal spending. A refundable €${securityDeposit.amount} security deposit is collected on arrival.`,
      },
      {
        q: 'Do students need a visa?',
        a: visaRequired
          ? 'Yes — see below for what is required.'
          : 'No. Bulgaria is an EU member state, and Ireland grants free movement to EU citizens for tourism and study stays like this one. No visa is required for Bulgarian passport holders.',
      },
      {
        q: 'Are flights included?',
        a: 'No. Flights are booked separately. We send a step-by-step guide with the exact travel dates once the 2027 dates are confirmed, and the group travels together with the group leader.',
      },
    ],
  },
];
---

<BaseLayout
  title={`FAQs – Dublin Summer ${dublin.year} | Immersion English`}
  description={`Questions parents ask about the Immersion English group to MLA's summer centre at the National College of Ireland, Dublin – who runs it, supervision, accommodation, excursions, and what is and is not confirmed for ${dublin.year}.`}
  ogImage="/students-walking.webp"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": sections.flatMap(({ faqs }) => faqs.map(({ q, a }) => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": { "@type": "Answer", "text": a }
    })))
  })} />

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange-text);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        FAQs
      </p>
      <h1 class="text-white mb-5 max-w-[14ch]">
        Your questions,<br />
        <span style="color: var(--orange-text);">answered.</span>
      </h1>
      <p class="text-white/80 text-[1.15rem] max-w-[52ch] leading-[1.55]">
        Including the ones we can't answer yet – and exactly why.
      </p>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-10 md:gap-16 items-start">

        <nav class="hidden md:flex flex-col gap-1 sticky top-[90px]">
          {sections.map(({ id, heading }) => (
            <a
              href={`#${id}`}
              class="text-[0.9rem] font-heading font-semibold text-ink-soft hover:text-brand-green transition-colors no-underline py-2 px-3 rounded-md hover:bg-cream"
            >
              {heading}
            </a>
          ))}
          <div class="mt-6 pt-6 border-t border-line">
            <a href="/contact" class="btn btn-primary text-[0.88rem] py-3 px-5 justify-center w-full">
              Still have questions?
            </a>
          </div>
        </nav>

        <div class="flex flex-col gap-14">
          {sections.map(({ id, heading, faqs }) => (
            <div id={id}>
              <div class="flex items-center gap-3 rounded-lg px-5 py-4 mb-2" style="background: var(--green);">
                <svg width="18" height="18" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" style="opacity:0.7;flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                <h2 class="text-[1.1rem] m-0 text-white font-heading tracking-wide">{heading}</h2>
              </div>
              <div class="flex flex-col">
                {faqs.map(({ q, a, link }) => (
                  <div class="faq-item border-b border-line last:border-0">
                    <button class="faq-trigger w-full flex items-center justify-between gap-4 py-5 text-left bg-transparent border-0 cursor-pointer" aria-expanded="false">
                      <span class="font-heading font-semibold text-[1rem] text-ink leading-snug">{q}</span>
                      <span class="faq-icon flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center transition-colors duration-200" style="background: var(--cream);">
                        <svg class="faq-chevron w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </span>
                    </button>
                    <div class="faq-body" style="display:none;">
                      <div class="pb-5 pr-2 md:pr-10">
                        <p class="text-ink-soft text-[0.97rem] leading-relaxed max-w-[66ch]">{a}</p>
                        {link && (
                          <a
                            href={link.href}
                            class="inline-block mt-3 text-[0.92rem] font-heading font-semibold no-underline hover:underline"
                            style="color: var(--green);"
                          >
                            {link.label}
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <h2 class="mb-5">Still have a question?</h2>
      <p class="max-w-[44ch] mx-auto mb-8" style="color: rgba(254,255,254,0.74);">
        We're happy to answer anything, big or small. Get in touch and we'll reply within one working day.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center flex-wrap">
        <a href="/contact" class="btn btn-primary">Contact us</a>
        <a href="/dublin-summer-2027" class="btn btn-ghost text-white border-white/30 hover:border-white">
          Back to programme
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = item.querySelector('.faq-body');
      const icon = trigger.querySelector('.faq-icon');
      const chevron = trigger.querySelector('.faq-chevron');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        body.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
        icon.style.background = 'var(--cream)';
        chevron.style.transform = 'rotate(0deg)';
      } else {
        body.style.display = 'block';
        trigger.setAttribute('aria-expanded', 'true');
        icon.style.background = 'var(--green-soft)';
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
