---
/**
 * HOLDING PAGE.
 *
 * The previous version answered 20+ questions about the cancelled UCD programme.
 * Every one of the following was false or unverifiable under the MLA/NCI
 * arrangement, and several contradicted the approved 2027 copy outright:
 *
 *   - "The programme fee is €1,350"                  → 2027 price unconfirmed
 *   - "€350 deposit / €1,000 balance by 31 May 2027" → 2027 terms unconfirmed
 *   - "The €650 deposit is non-refundable"           → also contradicted the €350 answer
 *   - "meals are not included ... UCD food court"    → 2027 is FULL BOARD
 *   - "majority of rooms are not en suite"           → 2027 is EN-SUITE
 *   - "All students will be Bulgarian, aged 13–17"   → international centre, ages 12–20
 *   - "maximum of 13 students per group"             → 13 average, 18 maximum
 *   - "staying at the University College Dublin"     → National College of Ireland
 *   - "Our teachers have CELTA ..."                  → MLA's centre teaches, not us
 *   - "All of the programmes at ICE ..."             → unrelated provider, copy-paste residue
 *
 * No replacement FAQ copy has been approved. Rewriting these answers would mean
 * inventing 2027 terms, so the page is held.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderBlock from '../../components/ProviderBlock.astro';
import { dublin } from '../../data/dublin';
---

<BaseLayout
  title={`FAQs – Dublin Summer ${dublin.year} | Immersion English`}
  description={`Questions about the Immersion English group to MLA's summer centre in Dublin. Updated answers for Summer ${dublin.year} coming soon — book a free consultation in the meantime.`}
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange-text);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        FAQs
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Ask us <span style="color: var(--orange-text);">anything.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[48ch] leading-[1.55]">
        Updated answers for Summer {dublin.year} are coming soon. Until then, a free
        consultation is the fastest way to get a straight answer.
      </p>
    </div>
  </section>

  <!-- HOLDING -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-[62ch] mx-auto">
        <p class="text-ink-soft text-[1.08rem] leading-relaxed mb-8">
          Details for Summer {dublin.year} coming soon. If you have a question in the
          meantime, book a free consultation and we'll answer it directly.
        </p>

        {/* TODO: awaiting MLA 2027 confirmation — rewrite the FAQ set against MLA's
            2027 terms and conditions once dates, net rates, deposit terms, the NCI
            excursion list and the age-grouping scope are confirmed in writing.
            Do not restore any answer from the UCD-era set: see the header comment
            for the specific false and self-contradictory claims removed. */}

        <div class="flex gap-3 flex-wrap">
          <a href="/contact" class="btn btn-primary">Book a free consultation</a>
          <a href="/dublin-summer-2027" class="btn btn-ghost">Back to the programme</a>
        </div>
      </div>
    </div>
  </section>

  <ProviderBlock />

</BaseLayout>
