---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  {
    id: 'programme',
    heading: 'The programme',
    faqs: [
      {
        q: 'What will the timetable be?',
        a: 'Students are busy all day long and will have a balanced educational timetable, daily trips, and free time between activities.',
        link: { href: '/dublin-summer-2027/weekly-programme', label: 'View the weekly timetable →' },
      },
      {
        q: 'How many students will be in the group?',
        a: 'There is a maximum of 13 students per group so that we can ensure individual attention, safety, and close supervision.',
      },
      {
        q: 'What qualifications do your teachers have?',
        a: 'Our teachers have CELTA (Certificate in English Language Teaching to Speakers of Other Languages) qualifications, as well as Young Learner teaching qualifications.',
      },
      {
        q: 'Will you accept a 12 year old or an 18 year old?',
        a: 'No, our age range is from 13 to 17 years of age. However, under certain circumstances, if a child turns 13 or 18 and is still in high school up until the summer of the camp, we may accept them on the programme.',
      },
      {
        q: 'What happens on the first day of school?',
        a: 'On arrival, students will be shown to their room and given a tour of the campus and relevant information regarding living on campus, classes, and activities. They will also be shown their classroom and activity meeting point for the next day. They will then join in scheduled activities.',
      },
      {
        q: 'What is the nationality mix of the group?',
        a: 'Your child will be with other Bulgarian students between the age of 13 to 17, but the group leaders and teaching assistant are English speakers. Be assured, there will be a Bulgarian speaker available at all times, but Bulgarian will only be used for special circumstances.',
      },
      {
        q: "What will my child's end-of-course certificate say?",
        a: 'Absolutely! Your child\'s end-of-course certificate will record the number of hours they have studied and will note your child\'s strengths and weaknesses with a recommendation for the next English level. E.g. Sofia Dimitrova has attended an English Language Course for 20 hours and has progressed with reference to the CEFR descriptors at Upper Intermediate Level (B2).',
      },
      {
        q: 'What is the CEFR, and how do I understand the levels – A2, B1, B2, C1?',
        a: 'The CEFR is the Common European Framework of Reference for Languages, which was developed to provide a common basis for the explicit description of objectives, content and methods in second/foreign language education. All of the programmes at Immersion English are aligned to this scale; we run classes from A2 to C1.',
        link: { href: 'https://www.coe.int/en/web/common-european-framework-reference-languages/level-descriptions', label: 'For more information on the CEFR please click here →', external: true },
      },
      {
        q: 'Is the Immersion English summer programme aligned to the CEFR?',
        a: 'Yes, our programme is aligned to the CEFR and our focus is on communicative competence in real-life, everyday situations.',
      },
    ],
  },
  {
    id: 'logistics',
    heading: 'Logistics & travel',
    faqs: [
      {
        q: 'Does the price include the flights?',
        a: 'Yes, the programme price includes flight costs and a 20kg check-in. Additional fees apply for additional checked-in luggage.',
      },
      {
        q: 'What should my child bring?',
        a: 'You will receive a packing list no later than two weeks before departure. We will provide all learning materials, a branded raincoat, and a notebook for your child.',
      },
      {
        q: 'Can my child leave the UCD campus and go to Dublin City Centre alone?',
        a: 'No, students are not allowed to leave campus without supervision, but we will explore Dublin City Centre and notable landmarks as a group.',
        link: { href: '/dublin-summer-2027/weekly-programme', label: 'See the full programme →' },
      },
    ],
  },
  {
    id: 'accommodation',
    heading: 'Accommodation & campus',
    faqs: [
      {
        q: 'Where will my child stay?',
        a: 'Students stay at the University College Dublin (UCD) campus. Each child will have their own single bedroom within a private apartment with 4 bedrooms and two shared bathrooms. There is 24/7 reception and security, on-site laundry facilities (at an extra cost), and it is located within walking distance to all campus amenities including restaurants and the gym, and a short walk to the Dublin Bus campus terminus which serves 16 different routes.',
        link: { href: '/dublin-summer-2027/accommodation', label: 'See more about the accommodation →' },
      },
      {
        q: 'Are the rooms en suite?',
        a: 'The majority of rooms are not en suite – students share toilets and shower areas within their apartment.',
      },
      {
        q: 'Are boys and girls placed in different areas of the residence?',
        a: 'Yes, boys and girls are in different areas of the residence.',
      },
      {
        q: 'Is there free Wi-Fi on campus?',
        a: 'Yes, there is free Wi-Fi throughout the UCD campus.',
      },
      {
        q: 'Are meals included in the price?',
        a: 'No, meals are not included. There are many meal options available for breakfast, lunch, and dinner at the UCD campus food court.',
        link: { href: 'https://thefoodhallatucdvillage.ie/', label: 'See the UCD food hall →', external: true },
      },
    ],
  },
  {
    id: 'safety',
    heading: 'Safety & welfare',
    faqs: [
      {
        q: 'How is the residence supervised at night?',
        a: 'Group leaders sleep in rooms next to each student area and are on call. In addition, there is 24-hour security at the UCD campus accommodation.',
      },
      {
        q: 'Are mobile phones allowed?',
        a: 'Yes, but during classes, activities, and lights-out, mobile phones must be turned off.',
      },
    ],
  },
  {
    id: 'costs',
    heading: 'Costs & booking',
    faqs: [
      {
        q: 'Are there any additional costs and how much pocket money does a student need?',
        a: 'Please note that the package cost of €1,700 covers flights with 20kg check-in, transport costs, city trips, and activities, but does not include food. We realise teenagers have different food preferences and they will have many food options to choose from at the UCD food hall and during the daily excursions. We recommend you provide a €20–25 daily allowance for food. Most students bring an additional €50 pocket money per week for souvenirs, sweets, etc.',
      },
      {
        q: 'When do I pay the deposit and fees?',
        a: 'A non-refundable deposit of €650 is required to reserve a spot for your child. The remaining balance of €1,100 is due no later than 31 May 2027. We will send you the bank details once we have had the free online consultation and after you have reserved a spot for your child.',
      },
      {
        q: 'What is the refund policy?',
        a: 'The €650 deposit is non-refundable and ensures a flight for your child. In the unlikely event that the programme does not go ahead, all payments made will be fully refunded. Important notes: all cancellations must be made in writing to immersionenglish.ie@gmail.com; refunds will be processed within 7–10 business days of the cancellation confirmation; no refunds will be given for no-shows or early departures.',
      },
    ],
  },
];
---

<BaseLayout title="FAQs – Dublin Summer 2027" description="Frequently asked questions about the Immersion English Dublin Summer Programme 2027 for teens aged 13–17.">

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[120px] pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer 2027
      </a>
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        FAQs
      </p>
      <h1 class="text-white mb-5 max-w-[14ch]">
        Your questions,<br />
        <span style="color: var(--orange);">answered.</span>
      </h1>
      <p class="text-white/80 text-[1.15rem] max-w-[50ch] leading-[1.55]">
        Everything parents and students want to know before booking the Dublin Summer Programme.
      </p>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-10 md:gap-16 items-start">

        <!-- Sticky sidebar nav -->
        <nav class="hidden md:flex flex-col gap-1 sticky top-[90px]">
          {sections.map(({ id, heading }) => (
            <a
              href={`#${id}`}
              class="text-[0.9rem] font-heading font-semibold text-ink-soft hover:text-brand-green transition-colors no-underline py-2 px-3 rounded-md hover:bg-cream"
            >
              {heading}
            </a>
          ))}
          <div class="mt-6 pt-6 border-t border-line">
            <a href="/contact" class="btn btn-primary text-[0.88rem] py-3 px-5 justify-center w-full">
              Still have questions?
            </a>
          </div>
        </nav>

        <!-- FAQ accordion content -->
        <div class="flex flex-col gap-14">
          {sections.map(({ id, heading, faqs }) => (
            <div id={id}>
              <h2 class="text-[1.5rem] mb-6 pb-5 border-b-2 border-brand-green">{heading}</h2>
              <div class="flex flex-col">
                {faqs.map(({ q, a, link }) => (
                  <div class="faq-item border-b border-line last:border-0">
                    <button class="faq-trigger w-full flex items-center justify-between gap-4 py-5 text-left bg-transparent border-0 cursor-pointer" aria-expanded="false">
                      <span class="font-heading font-semibold text-[1rem] text-ink leading-snug">{q}</span>
                      <span class="faq-icon flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center transition-colors duration-200" style="background: var(--cream);">
                        <svg class="faq-chevron w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </span>
                    </button>
                    <div class="faq-body" style="display:none;">
                      <div class="pb-6 pr-2 md:pr-10">
                        <p class="text-ink-soft text-[0.97rem] leading-relaxed max-w-[66ch]">{a}</p>
                        {link && (
                          <a
                            href={link.href}
                            target={link.external ? '_blank' : undefined}
                            rel={link.external ? 'noopener noreferrer' : undefined}
                            class="inline-block mt-3 text-[0.92rem] font-heading font-semibold no-underline hover:underline"
                            style="color: var(--green);"
                          >
                            {link.label}
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <h2 class="mb-5">Still have a question?</h2>
      <p class="max-w-[44ch] mx-auto mb-8" style="color: rgba(254,255,254,0.74);">
        We're happy to answer anything, big or small. Get in touch and we'll reply within one working day.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/contact" class="btn btn-primary">
          Contact us
          <span class="btn-arrow">→</span>
        </a>
        <a href="/dublin-summer-2027" class="btn btn-ghost text-white border-white/30 hover:border-white">
          Back to programme
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = item.querySelector('.faq-body');
      const icon = trigger.querySelector('.faq-icon');
      const chevron = trigger.querySelector('.faq-chevron');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        body.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
        icon.style.background = 'var(--cream)';
        chevron.style.transform = 'rotate(0deg)';
      } else {
        body.style.display = 'block';
        trigger.setAttribute('aria-expanded', 'true');
        icon.style.background = 'var(--green-soft)';
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
