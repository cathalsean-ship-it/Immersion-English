---
/**
 * HOLDING PAGE.
 *
 * The previous version listed nine self-chosen excursions (Trinity College, the
 * Book of Kells, Dublin Castle, St Patrick's Cathedral, St Stephen's Green,
 * Grafton Street, Dublin Zoo, Dundrum Town Centre, Howth Cliff Walk) plus
 * Kilkenny, the Wicklow Mountains and Glendalough, and claimed "1 full-day and
 * 5 half-day trips" and "seven evening activities".
 *
 * NONE of that is MLA's programme. Those excursions were chosen by Immersion
 * English for the cancelled UCD programme. MLA's NCI excursion list has not been
 * supplied (catalogue p.44). Nothing may be named on this page until it is.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dublin } from '../../data/dublin';

const { excursions } = dublin;
---

<BaseLayout
  title={`Trips & Activities – Dublin Summer ${dublin.year} | Immersion English`}
  description={`The excursion and activity programme at an international summer centre in Dublin, run by the centre's own activity team, with transport and entry included. Details for Summer ${dublin.year} coming soon.`}
  ogImage="/dublin-street.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Trips & activities
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Transport and tickets <span style="color: var(--orange);">included.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[48ch] leading-[1.55]">
        The full excursion programme is included in the price, with nothing extra
        to pay. Cooking, art and games fill the daytime; talent shows, karaoke,
        discos and movie nights take over once the sun goes down.
      </p>
    </div>
  </section>

  {/* Excursions render ONLY from dublin.ts, which transcribes MLA's published
      Dublin programme (Junior Programmes 2026 catalogue, p.44). The UCD-era trips
      were self-chosen by Immersion English and must never be reinstated here. */}
  {excursions === null && (
    <section class="section">
      <div class="container-x">
        <div class="max-w-[62ch] mx-auto">
          <p class="text-ink-soft text-[1.08rem] leading-relaxed mb-8">
            The excursion programme for Summer {dublin.year} is set by the centre.
            Details coming soon.
          </p>
          <div class="rounded-md overflow-hidden shadow-lift mb-8">
            <img
              src="/dublin-street.webp"
              alt="A street in Dublin city centre"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 16/9; display: block;"
              loading="lazy" />
          </div>
        </div>
      </div>
    </section>
  )}

  {excursions !== null && (
    <>
      {[
        { key: 'full-day', eyebrow: 'Full-day excursions', heading: 'Out of the city.' },
        { key: 'half-day', eyebrow: 'Half-day excursions', heading: 'Dublin, properly.' },
      ].map(({ key, eyebrow, heading }, groupIndex) => {
        const items = excursions.filter(e => e.duration === key);
        if (items.length === 0) return null;
        return (
          <section class={groupIndex === 1 ? 'section section-tinted' : 'section'}>
            <div class="container-x">
              <div class="section-head">
                <span class="eyebrow eyebrow-dot">{eyebrow}</span>
                <h2>{heading}</h2>
                <p>
                  {items.length} {key === 'full-day' ? 'full-day' : 'half-day'}
                  {items.length === 1 ? ' excursion' : ' excursions'}, run by the centre's local staff.
                  Transport and entry tickets included.
                </p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
                {items.map(({ title, description, image }) => (
                  <div class="bg-white border border-line rounded-lg overflow-hidden trip-card flex flex-col h-full">
                    <div class="trip-card-img-wrap aspect-video w-full overflow-hidden">
                      {/* alt="" — the card's own h3 names it immediately below, so
                          repeating the title here makes a screen reader say it twice. */}
                      {image
                        ? <img src={image} alt="" class="trip-card-img w-full h-full object-cover" loading="lazy" />
                        : <div class="w-full h-full" style="background: repeating-linear-gradient(135deg, rgba(20,32,26,0.05) 0 2px, transparent 2px 14px), var(--cream);"></div>
                      }
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                      <h3 class="text-[1.05rem] mb-3">{title}</h3>
                      <p class="text-ink-soft text-[0.9rem] leading-relaxed flex-1">{description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        );
      })}

      <section class="section">
        <div class="container-x">
          <div class="max-w-[62ch] mx-auto text-center">
            <p class="text-ink-soft text-[1.02rem] leading-relaxed mb-8">
              Excursions are set by the centre and confirmed before departure.
              Evening and weekend activities run alongside them, organised by the
              centre's own activity team.
            </p>
            <div class="flex gap-3 flex-wrap justify-center">
              <a href="/dublin-summer-2027" class="btn btn-primary">Back to the programme</a>
              <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
            </div>
          </div>
        </div>
      </section>
    </>
  )}

</BaseLayout>
