---
import BaseLayout from '../../layouts/BaseLayout.astro';

const activities = [
  {
    title: 'Trinity College',
    desc: "One of Ireland's most iconic universities — and one of the most filmed locations in Dublin. We'll explore its world-famous campus and walk the same paths once taken by literary greats like Oscar Wilde and Samuel Beckett.",
    tag: 'Cultural',
    color: '#c8d5dd',
  },
  {
    title: 'The Book of Kells',
    desc: "Ireland's greatest cultural treasure — a world-famous illuminated manuscript at Trinity College Dublin. Students explore the stunning Long Room library, bringing history, art, and storytelling to life.",
    tag: 'Cultural',
    color: '#d6d2c5',
  },
  {
    title: 'Dublin Castle',
    desc: 'History meets imagination at Dublin Castle — the heart of the city for over 800 years. We discover the stories of kings, queens, and intrigue as we explore the grand halls and cobbled courtyards.',
    tag: 'History',
    color: '#c8d8cc',
  },
  {
    title: "St Patrick's Cathedral",
    desc: "One of Ireland's most breathtaking landmarks. St Patrick's Cathedral is filled with beauty, history, and inspiration — where architecture, music, and storytelling come together.",
    tag: 'History',
    color: '#d7c3b0',
  },
  {
    title: "St Stephen's Green",
    desc: "A quiet escape in the heart of the city. We relax by the pond, stroll through flower-filled paths, or enjoy a picnic between adventures. Dublin's most beautiful park — calm, green, and full of character.",
    tag: 'Nature',
    color: '#c8d8cc',
  },
  {
    title: 'Grafton Street',
    desc: "Lined with cafés, flower stalls, and street performers, Grafton Street is Dublin's most famous and vibrant street. From talented buskers to the Molly Malone statue — a must-see stop on every visit to Dublin.",
    tag: 'City',
    color: '#e2d4c1',
  },
  {
    title: 'Dublin Zoo',
    desc: 'A fun, educational experience where students explore wildlife from around the world while practising English naturally through observation, discussion, and shared discovery.',
    tag: 'Fun',
    color: '#c7cfd8',
  },
  {
    title: 'Howth Cliff Walk',
    desc: 'Fresh air, sea views, and endless photo moments! Just a short trip from the city, Howth offers stunning coastal cliffs and lighthouse views. Keep an eye out for seals along the way!',
    tag: 'Nature',
    color: '#c2d0dc',
  },
  {
    title: 'Dundrum Town Centre',
    desc: 'With over 160 stores across three floors, Dundrum has something for everyone. Grab a snack, browse the latest fashion, or find unique souvenirs — the perfect spot to unwind after a busy day of exploring.',
    tag: 'Shopping',
    color: '#d9d6e0',
  },
];
---

<BaseLayout title="Trips & Activities — Dublin Summer 2027" description="Day trips, cultural visits, and evening activities for the Immersion English Dublin Summer Programme 2027.">

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[120px] pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer 2027
      </a>
      <p class="font-heading font-semibold text-[0.72rem] tracking-[0.18em] uppercase mb-5 flex items-center gap-3" style="color: var(--orange);">
        <span class="inline-block w-6 h-[1.5px]" style="background: var(--orange);"></span>
        Trips & activities
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Explore Ireland<br />and make
        <span style="color: var(--orange);">memories.</span>
      </h1>
      <p class="text-white/80 text-[1.15rem] max-w-[52ch] leading-[1.55]">
        Every afternoon and evening is packed with excursions, cultural experiences, and social events. 1 full day trip and 5 half-day trips — all included in the programme fee.
      </p>
    </div>
  </section>

  <!-- DUBLIN INTRO -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot">Dublin</span>
          <h2 class="mt-4 mb-5">A city where every conversation is an adventure.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Dublin — the heart of Ireland — is a city known for its warmth, charm, and character. Here, every conversation is a chance to connect, and every street feels like a story waiting to be told.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            From the cobbled lanes of Temple Bar and the historic beauty of Trinity College to the peaceful green spaces of St Stephen's Green, Dublin offers the perfect balance of culture, history, and fun.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch]">
            Dublin's culture is rich and alive — a blend of literature, music, art, and laughter. It's the birthplace of world-famous writers like James Joyce, Oscar Wilde, and Samuel Beckett, yet also a modern, creative city filled with festivals, street art, and stories around every corner.
          </p>
        </div>
        <div
          class="rounded-md overflow-hidden shadow-lift aspect-[4/3]"
          style="background: repeating-linear-gradient(135deg, rgba(20,32,26,0.04) 0 2px, transparent 2px 14px), #c8d5dd;"
        ></div>
      </div>
    </div>
  </section>

  <!-- FULL DAY TRIP -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Full day trip</span>
        <h2>Kilkenny, the Wicklow Mountains & Glendalough.</h2>
        <p>One full day away from Dublin — exploring medieval streets, dramatic mountain landscapes, and ancient Irish history.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { title: 'Kilkenny', desc: "We explore medieval streets and local culture in one of Ireland's most charming cities.", color: '#d6d2c5' },
          { title: 'Wicklow Mountains', desc: 'Travel through the dramatic landscapes of the Wicklow Mountains National Park — some of Ireland\'s most stunning scenery.', color: '#c8d8cc' },
          { title: 'Glendalough', desc: 'Discover the breathtaking 6th-century monastic site and twin lakes of Glendalough. Ancient Ireland at its most awe-inspiring.', color: '#c2d0dc' },
        ].map(({ title, desc, color }) => (
          <div class="trust-card">
            <div
              class="w-full -mt-10 -mx-9 mb-6 rounded-t-md overflow-hidden aspect-video"
              style={`width: calc(100% + 72px); background: repeating-linear-gradient(135deg, rgba(20,32,26,0.05) 0 2px, transparent 2px 14px), ${color}; margin-top: -40px; margin-left: -36px; border-radius: 14px 14px 0 0;`}
            ></div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HALF-DAY TRIPS & CITY -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Half-day trips & city visits</span>
        <h2>Something new every day.</h2>
        <p>Five half-day trips covering the best of Dublin's landmarks, culture, and natural beauty.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {activities.map(({ title, desc, tag, color }) => (
          <div class="bg-white border border-line rounded-lg overflow-hidden hover:shadow-md transition-shadow flex flex-col">
            <div
              class="aspect-video w-full"
              style={`background: repeating-linear-gradient(135deg, rgba(20,32,26,0.05) 0 2px, transparent 2px 14px), ${color};`}
            ></div>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center justify-between gap-3 mb-3">
                <h3 class="text-[1.05rem]">{title}</h3>
                <span class="text-[0.65rem] font-heading font-semibold uppercase tracking-[0.1em] px-[8px] py-[3px] rounded-full flex-shrink-0" style="background: var(--green-soft); color: var(--green);">{tag}</span>
              </div>
              <p class="text-ink-soft text-[0.9rem] leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EVENING ACTIVITIES -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot">Evenings</span>
          <h2 class="mt-4 mb-5">The fun doesn't stop at 5pm.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[52ch] mb-10">
            Seven evening activities mix nationalities, build friendships, and keep students using English in a social context — naturally and enjoyably.
          </p>
          <ul class="flex flex-col gap-0 border-t border-line">
            {[
              { title: 'Sports night', desc: 'Football, basketball, volleyball. Teams are mixed across nationalities.' },
              { title: 'Talent show', desc: 'A highlight of the programme. Students perform and vote for their favourites.' },
              { title: 'Quiz night', desc: 'General knowledge quiz in English. A great way to practise and have fun.' },
              { title: 'Games evening', desc: 'Board games, team games, and social mixing — full of laughter.' },
            ].map(({ title, desc }) => (
              <li class="flex gap-5 items-start py-5 border-b border-line">
                <span class="flex-shrink-0 w-8 h-8 rounded-full grid place-items-center text-sm mt-[2px]" style="background: var(--orange); color: white;">✦</span>
                <div>
                  <p class="font-heading font-semibold text-ink text-[1.02rem] mb-1">{title}</p>
                  <p class="text-ink-soft text-[0.95rem] leading-relaxed">{desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div
          class="rounded-md overflow-hidden shadow-lift aspect-[3/4]"
          style="background: repeating-linear-gradient(135deg, rgba(20,32,26,0.04) 0 2px, transparent 2px 14px), #d6d2c5;"
        ></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <h2 class="mb-5">See what a typical week looks like.</h2>
      <p class="max-w-[44ch] mx-auto mb-8" style="color: rgba(254,255,254,0.74);">
        Check the weekly programme timetable or apply for Dublin Summer 2027 now.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/dublin-summer-2027/weekly-programme" class="btn btn-primary">
          Weekly programme
          <span class="btn-arrow">→</span>
        </a>
        <a href="/contact" class="btn btn-ghost text-white border-white/30 hover:border-white">Apply now</a>
      </div>
    </div>
  </section>

</BaseLayout>
