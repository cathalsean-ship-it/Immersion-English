---
/**
 * The previous version was a full seven-day timetable for the cancelled UCD
 * programme: check-in at Belgrove Residences, lunches at the UCD food hall,
 * named half-day trips (Trinity College & Book of Kells, Dublin Castle &
 * St Patrick's Cathedral, Howth, Grafton Street, Dundrum), a Kilkenny /
 * Wicklow / Glendalough full day, and a "6 day trips" stat. That is gone
 * and must not be restored.
 *
 * SOURCE for the sample day below: MLA's published Dublin/NCI programme
 * flyer ("Programme-Dublin-NCI-2026-EFJ.pdf"), the "A SAMPLE SCHEDULE"
 * table. This is the centre's own published typical day for this exact
 * campus — not a UCD-era guess, not invented. MLA has not separately
 * confirmed this for 2027; treat as "the centre's typical day" rather
 * than a 2027 guarantee until they do, same caveat already applied to
 * the excursions list in dublin.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dublin } from '../../data/dublin';

const { lessonsPerWeek, hoursPerWeek } = dublin;

const sampleDay = [
  { time: '8:00 AM', activity: 'Wake up and breakfast' },
  { time: '9:00 AM', activity: 'Lesson, or an excursion / activity' },
  { time: '12:30 PM', activity: 'Lunch' },
  { time: '2:00 PM', activity: 'Lesson, or an excursion / activity' },
  { time: '6:30 PM', activity: 'Dinner' },
  { time: '7:30–10:00 PM', activity: 'Evening activities' },
];
---

<BaseLayout
  title={`Weekly Programme – Dublin Summer ${dublin.year} | Immersion English`}
  description={`${lessonsPerWeek} lessons a week (${hoursPerWeek} hours) with qualified native-speaker teachers at an international summer centre in Dublin, plus daily excursions and evening activities.`}
  ogImage="/teens-cafe.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange-text);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Weekly programme
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Classes every <span style="color: var(--orange-text);">morning.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[48ch] leading-[1.55]">
        {lessonsPerWeek} lessons every week – {hoursPerWeek} hours – with qualified
        native-speaker teachers at the centre, plus daily excursions and evening activities.
      </p>
    </div>
  </section>

  <!-- OVERVIEW CARDS -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">A week at the centre</span>
        <h2>Mornings in class. Afternoons out.</h2>
        <p>
          Students take <strong class="text-ink">{lessonsPerWeek} lessons every week</strong>
          ({hoursPerWeek} hours) with the centre's qualified native-speaker teachers, with
          excursions and activities built around them.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
        {[
          { title: 'Lessons', body: `${lessonsPerWeek} lessons a week – ${hoursPerWeek} hours – after an online placement test puts every student in the right class.` },
          { title: 'Excursions', body: "Full-day and half-day excursions run by the centre's local staff, with transport and entry tickets included." },
          { title: 'Evenings and weekends', body: 'Cooking, art and games by day; talent shows, karaoke, themed discos and movie nights once the sun goes down.' },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SAMPLE DAY -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">A typical day</span>
        <h2>Structured, but never idle.</h2>
        <p>
          Lessons in the morning or afternoon, excursions and activities filling the rest –
          the centre's own published rhythm for a day at this campus.
        </p>
      </div>

      <div class="max-w-[62ch] mx-auto">
        <ul class="list-none p-0 m-0 flex flex-col gap-3 mb-10">
          {sampleDay.map(({ time, activity }) => (
            <li class="flex items-center gap-4 rounded-lg px-5 py-4" style="background: var(--cream); border: 1px solid var(--line);">
              <span class="font-heading font-semibold text-[0.92rem] flex-shrink-0 w-[110px]" style="color: var(--green);">{time}</span>
              <span class="text-[0.95rem] text-ink">{activity}</span>
            </li>
          ))}
        </ul>

        <div class="rounded-md overflow-hidden shadow-lift mb-8">
          <img
            src="/teens-cafe.webp"
            alt=""
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 16/9; display: block;"
            loading="lazy" />
        </div>

        <div class="flex gap-3 flex-wrap">
          <a href="/dublin-summer-2027" class="btn btn-primary">Back to the programme</a>
          <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
