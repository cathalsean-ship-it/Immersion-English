---
/**
 * The previous version was a full seven-day timetable for the cancelled UCD
 * programme: check-in at Belgrove Residences, lunches at the UCD food hall,
 * named half-day trips (Trinity College & Book of Kells, Dublin Castle &
 * St Patrick's Cathedral, Howth, Grafton Street, Dundrum), a Kilkenny /
 * Wicklow / Glendalough full day, and a "6 day trips" stat. That is gone
 * and must not be restored.
 *
 * The timetable is the shared ProgrammeTimetable component, transcribed
 * from the centre's Summer 2027 profile (p.42) — a 14-day / 13-night
 * sample. A clock-time "typical day" list (8:00 breakfast ... 10:00 PM) used
 * to follow it; it came from MLA's 2026 flyer, not the 2027 brochure, and
 * was removed at the site owner's request (14 Oct 2026). Don't restore it
 * without 2027 confirmation.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dublin } from '../../data/dublin';
import ProgrammeTimetable from '../../components/ProgrammeTimetable.astro';

const { lessonsPerWeek, hoursPerWeek } = dublin;
---

<BaseLayout
  title={`Weekly Programme – Dublin Summer ${dublin.year} | Immersion English`}
  description={`${lessonsPerWeek} lessons a week (${hoursPerWeek} hours) with qualified English teachers at an international summer centre in Dublin, plus regular excursions and a different activity every evening.`}
  ogImage="/teens-cafe.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Weekly programme
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Something new <span style="color: var(--orange);">every day.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[48ch] leading-[1.55]">
        {lessonsPerWeek} lessons every week – {hoursPerWeek} hours – with qualified
        English teachers at the centre, plus regular excursions and a different
        activity every evening.
      </p>
    </div>
  </section>

  <!-- TIMETABLE -->
  <section class="section" style="padding-bottom: 44px;">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Sample programme</span>
        <h2>Lessons, excursions and activities, <span style="color: var(--orange-text);">day by day.</span></h2>
        <p>
          Students take <strong class="text-ink">{lessonsPerWeek} lessons every week</strong>
          ({hoursPerWeek} hours) with the centre's qualified English teachers, with
          excursions and activities built around them. Sample 14-day / 13-night
          programme; shorter stays follow a shorter schedule.
        </p>
      </div>

      <ProgrammeTimetable />
    </div>
  </section>

  <!-- WHAT FILLS THE DAY -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">What fills the day</span>
        <h2>Learning, exploring and <span style="color: var(--orange-text);">having fun.</span></h2>
      </div>

      <div class="trip-card-img-wrap rounded-[20px] overflow-hidden mb-5" style="aspect-ratio: 21 / 9;">
        <img src="/christ-church-group.webp" alt="A group of students on an excursion at Christ Church Cathedral, Dublin" class="trip-card-img w-full h-full object-cover" style="object-position: center 60%;" loading="lazy" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {[
          { title: 'Lessons', body: `${lessonsPerWeek} lessons a week – ${hoursPerWeek} hours – after an online placement test puts every student in the right class.` },
          { title: 'Excursions', body: "Full-day and half-day excursions with the centre's local staff, transport and entry tickets included.", href: '/dublin-summer-2027/trips-and-activities', cta: 'See the trips' },
          { title: 'Daytime activities', body: 'Kitchen, where students practise English while learning to cook easy, tasty local dishes; plus art, sports and magic.' },
          { title: 'Evenings', body: 'Karaoke, trivia, themed discos, a scavenger hunt, Kahoot night, an Irish céilí dance and a talent show to finish.' },
        ].map(({ title, body, href, cta }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
            {href && (
              <a href={href} class="inline-flex items-center gap-2 text-[0.88rem] font-heading font-semibold no-underline mt-auto pt-2" style="color: var(--green);">{cta} →</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-x">
      <div class="flex gap-3 flex-wrap justify-center">
        <a href="/dublin-summer-2027" class="btn btn-primary">Back to the programme</a>
        <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
      </div>
    </div>
  </section>

</BaseLayout>
