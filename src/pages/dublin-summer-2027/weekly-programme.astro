---
/**
 * HOLDING PAGE.
 *
 * The previous version was a full seven-day timetable for the cancelled UCD
 * programme: check-in at Belgrove Residences, lunches at the UCD food hall,
 * named half-day trips (Trinity College & Book of Kells, Dublin Castle &
 * St Patrick's Cathedral, Howth, Grafton Street, Dundrum), a Kilkenny /
 * Wicklow / Glendalough full day, and a "6 day trips" stat.
 *
 * The 2027 timetable is set by MLA at the NCI centre and has not been supplied.
 * Only the lesson volume below is confirmed in dublin-overview-copy.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderBlock from '../../components/ProviderBlock.astro';
import { dublin } from '../../data/dublin';

const { lessonsPerWeek, hoursPerWeek } = dublin;
---

<BaseLayout
  title={`Weekly Programme – Dublin Summer ${dublin.year} | Immersion English`}
  description={`${lessonsPerWeek} lessons a week (${hoursPerWeek} hours) with qualified native-speaker teachers at MLA's summer centre in Dublin, plus evening and weekend activities. Timetable for Summer ${dublin.year} coming soon.`}
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange-text);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Weekly programme
      </p>
      <h1 class="text-white mb-5 max-w-[16ch]">
        Classes every <span style="color: var(--orange-text);">morning.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[48ch] leading-[1.55]">
        {lessonsPerWeek} lessons every week – {hoursPerWeek} hours – with qualified
        native-speaker teachers at the centre, plus evening and weekend activities.
      </p>
    </div>
  </section>

  <!-- HOLDING -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-[62ch] mx-auto">
        <p class="text-ink-soft text-[1.08rem] leading-relaxed mb-4">
          Students take <strong class="text-ink">{lessonsPerWeek} lessons every week</strong>
          ({hoursPerWeek} hours) with the centre's qualified native-speaker teachers.
          Evening and weekend activities are run by the centre's own activity team.
        </p>

        <p class="text-ink-soft text-[1.08rem] leading-relaxed mb-8">
          The day-by-day timetable for Summer {dublin.year} is coming soon.
        </p>

        {/* TODO: awaiting MLA 2027 confirmation — daily timetable, lesson times,
            excursion scheduling and evening activity programme for the NCI centre.
            The UCD-era timetable has been removed and must not be restored. */}

        <div class="flex gap-3 flex-wrap">
          <a href="/dublin-summer-2027" class="btn btn-primary">Back to the programme</a>
          <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
        </div>
      </div>
    </div>
  </section>

  <ProviderBlock />

</BaseLayout>
