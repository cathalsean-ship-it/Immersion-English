---
/**
 * HOLDING PAGE.
 *
 * The previous version of this page was entirely about UCD Belfield and Belgrove
 * Residences — a UCD campus hero photo, an "About UCD" institutional section,
 * campus amenities, and food-hall budgets. All of it described the cancelled
 * programme, and the meals copy contradicted the new full-board arrangement.
 *
 * No replacement copy for this page has been approved. The only accommodation
 * facts confirmed in dublin-overview-copy.md are stated below; everything else
 * is held. Do not reinstate the UCD content.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { dublin } from '../../data/dublin';

const { venue } = dublin;

// Genuine NCI campus photography, supplied by MLA. Ordered: building entrance,
// student bedrooms, communal living/kitchen spaces, then teaching spaces.
const nciGalleryImages = [
  { src: '/nci-gallery/nci-02.jpg', alt: 'Entrance to the National College of Ireland building' },
  { src: '/nci-gallery/nci-04.jpg', alt: 'Student bedroom with desk and storage, NCI residence' },
  { src: '/nci-gallery/nci-06.jpg', alt: 'Student bedroom with shelving and desk, NCI residence' },
  { src: '/nci-gallery/nci-03.jpg', alt: 'Student bedroom with bookshelf, NCI residence' },
  { src: '/nci-gallery/nci-05.jpg', alt: 'Student bedroom desk and shelving detail, NCI residence' },
  { src: '/nci-gallery/nci-01.jpg', alt: 'Student bedroom with en-suite bathroom, NCI residence' },
  { src: '/nci-gallery/nci-08.jpg', alt: 'Shared living room with sofas, NCI residence' },
  { src: '/nci-gallery/nci-07.jpg', alt: 'Shared living room, NCI residence' },
  { src: '/nci-gallery/nci-10.jpg', alt: 'Shared kitchen and dining area, NCI residence' },
  { src: '/nci-gallery/nci-09.jpg', alt: 'Shared kitchen and dining area with city view, NCI residence' },
  { src: '/nci-gallery/nci-18.jpg', alt: 'Lecture theatre at the National College of Ireland' },
  { src: '/nci-gallery/nci-16.jpg', alt: 'Large tiered lecture theatre at NCI' },
  { src: '/nci-gallery/nci-14.jpg', alt: 'Meeting room with round tables at NCI' },
  { src: '/nci-gallery/nci-15.jpg', alt: 'Open collaborative learning space at NCI, overlooking Dublin' },
  { src: '/nci-gallery/nci-17.jpg', alt: 'Breakout teaching space at NCI' },
  { src: '/nci-gallery/nci-11.jpg', alt: 'Breakout room with round tables at NCI' },
  { src: '/nci-gallery/nci-12.jpg', alt: 'Classroom at the National College of Ireland' },
  { src: '/nci-gallery/nci-13.jpg', alt: 'Classroom at the National College of Ireland' },
];
---

<BaseLayout
  title={`Accommodation – Dublin Summer ${dublin.year} | Immersion English`}
  description={`Students travelling with Immersion English to Dublin stay in en-suite accommodation on campus at the ${venue.name}, with full board. Full details for Summer ${dublin.year} coming soon.`}
  ogImage="/teens-dublin.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange-text);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Accommodation
      </p>
      <h1 class="text-white mb-5" style="max-width: 20ch;">
        On campus at the <span style="color: var(--orange-text);">{venue.name}</span>, in the heart of the {venue.area}.
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55]" style="max-width: 46ch;">
        En-suite accommodation on campus, right in the middle of the city's
        most modern waterside district, with full board throughout the stay.
      </p>
    </div>
  </section>

  <!-- HOLDING -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">On campus</span>
        <h2>Everything under one roof.</h2>
        <p>
          Students stay in <strong class="text-ink">en-suite accommodation on campus</strong> at the
          {venue.name}, in {venue.area}, ten minutes' walk from the city centre. Lessons,
          meals and activities all happen on the same campus.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
        {[
          { title: 'En-suite rooms', body: 'Single or twin rooms with their own bathroom, on the campus itself.' },
          { title: 'Full board', body: 'From dinner on the day of arrival to breakfast on the day of departure. A prepaid meal card covers excursion days.' },
          { title: 'In the city', body: `${venue.area}, about ten minutes' walk from Temple Bar and the main attractions.` },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>

      <div class="max-w-[68ch] mx-auto">
        {/* Genuine NCI campus photography supplied by MLA — bedrooms, communal
            residence spaces and teaching spaces. Replaces the earlier generic
            placeholder photo. Do not caption individual rooms as guaranteed —
            room allocation is still pending MLA confirmation (see TODO below). */}
        <div class="mb-10">
          <PhotoCarousel images={nciGalleryImages} id="nci-accommodation-gallery" />
        </div>

        <h3 class="text-[1.15rem] mb-4">The area.</h3>
        <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-8">
          The campus sits in Dublin's Docklands, the modern, waterside stretch of
          the city along the Liffey known for its striking architecture and
          buzzing café culture — all a short walk from Temple Bar and the
          city centre.
        </p>

        <div class="rounded-md overflow-hidden shadow-lift mb-10" style="aspect-ratio: 16/9;">
          <iframe
            src="https://www.youtube.com/embed/1xoFnAmRRnk"
            title="Dublin Docklands drone video"
            style="width: 100%; height: 100%; display: block; border: 0;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy">
          </iframe>
        </div>

        {/* TODO: awaiting MLA 2027 confirmation — exact room configuration and
            night supervision arrangements, and written confirmation of whether age
            grouping applies in the residence as well as in classes (see
            dublin.ts ageGroupingScope.residence). The previous UCD / Belgrove
            Residences copy has been removed and must not be restored. Once MLA
            confirms, reinstate a short "room allocation" note here if needed. */}

        <div class="flex gap-3 flex-wrap">
          <a href="/dublin-summer-2027" class="btn btn-primary">Back to the programme</a>
          <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
