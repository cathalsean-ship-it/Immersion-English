---
/**
 * HOLDING PAGE.
 *
 * The previous version of this page was entirely about UCD Belfield and Belgrove
 * Residences — a UCD campus hero photo, an "About UCD" institutional section,
 * campus amenities, and food-hall budgets. All of it described the cancelled
 * programme, and the meals copy contradicted the new full-board arrangement.
 *
 * No replacement copy for this page has been approved. The only accommodation
 * facts confirmed in dublin-overview-copy.md are stated below; everything else
 * is held. Do not reinstate the UCD content.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocationMap from '../../components/LocationMap.astro';
import { dublin } from '../../data/dublin';

const { venue } = dublin;
---

<BaseLayout
  title={`Accommodation – Dublin Summer ${dublin.year} | Immersion English`}
  description={`Students travelling with Immersion English to Dublin stay in en-suite accommodation on campus at the ${venue.name}, with full board. Full details for Summer ${dublin.year} coming soon.`}
  ogImage="/teens-dublin.webp"
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer {dublin.year}
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange-text);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Accommodation
      </p>
      <h1 class="text-white mb-5" style="max-width: 16ch;">
        On campus at the <span style="color: var(--orange-text);">{venue.shortName}.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55]" style="max-width: 46ch;">
        En-suite accommodation on campus at the {venue.name}, in the heart of Dublin,
        with full board throughout the stay.
      </p>
    </div>
  </section>

  <!-- HOLDING -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">On campus</span>
        <h2>Everything under one roof.</h2>
        <p>
          Students stay in <strong class="text-ink">en-suite accommodation on campus</strong> at the
          {venue.name}, in {venue.area}, ten minutes' walk from the city centre. Lessons,
          meals and activities all happen on the same campus.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
        {[
          { title: 'En-suite rooms', body: 'Single or twin rooms with their own bathroom, on the campus itself.' },
          { title: 'Full board', body: 'From dinner on the day of arrival to breakfast on the day of departure. A prepaid meal card covers excursion days.' },
          { title: 'In the city', body: `${venue.area}, about ten minutes' walk from Temple Bar and the main attractions.` },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>

      {/* Every factual claim in this section was verified against ncirl.ie, the IFSC
          business directory, calatrava.com, libeskind.com, theccd.ie and Wikipedia's
          Silicon Docks entry in August 2026. Note the deliberate split between "a few
          minutes' walk" (Samuel Beckett Bridge, Convention Centre — both beside the
          Spencer Dock building) and "across the river" (Bord Gáis Energy Theatre,
          Google, Meta — Grand Canal, roughly 15 minutes on foot). Do not flatten that
          into "next door". None of these companies is connected to the programme and
          students do not visit them; this is neighbourhood context only. */}
      <div class="max-w-[68ch] mx-auto mb-14">
        <h3 class="text-[1.15rem] mb-4">The neighbourhood.</h3>
        <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-4">
          The campus is in the IFSC, the part of Dublin rebuilt over the last
          twenty-five years and now home to much of the city's modern architecture.
          Santiago Calatrava's <strong class="text-ink">Samuel Beckett Bridge</strong> —
          a cable-stayed span shaped like a harp turned on its side, after Ireland's
          national emblem — is a few minutes' walk, as is the
          {' '}<strong class="text-ink">Convention Centre Dublin</strong>, designed by the
          Irish-born Pritzker Prize winner Kevin Roche and the first carbon-neutral
          convention venue in the world. Across the river at Grand Canal Square stands
          Daniel Libeskind's <strong class="text-ink">Bord Gáis Energy Theatre</strong>,
          with its tilted glass façade.
        </p>
        <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-4">
          It is also where a large part of Europe's technology industry works. Google,
          Meta, LinkedIn and Airbnb all run European operations from the surrounding
          streets — which is how the area earned the nickname
          {' '}<strong class="text-ink">Silicon Docks</strong> — and the IFSC itself houses
          more than 300 financial institutions. The college even has its own Luas stop:
          Mayor Square – NCI.
        </p>
        <p class="text-ink-soft text-[0.95rem] leading-relaxed mb-8">
          Students don't visit these offices; it's simply the city they'll be living in
          for the summer, and it is a working, modern one rather than a postcard.
        </p>

        <LocationMap />
      </div>

      <div class="max-w-[62ch] mx-auto">
        {/* Decorative only. Generic photography — deliberately NOT a picture of the
            residence, which has not been supplied. Must never imply a specific room.
            alt="" because the surrounding copy already describes it. */}
        <div class="rounded-md overflow-hidden shadow-lift mb-8">
          <img
            src="/teens-dublin.webp"
            alt=""
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 16/9; display: block;"
            loading="lazy" />
        </div>

        {/* TODO: awaiting MLA 2027 confirmation — residence details, room configuration,
            night supervision arrangements, and written confirmation of whether age
            grouping applies in the residence as well as in classes (see
            dublin.ts ageGroupingScope.residence). The previous UCD / Belgrove
            Residences copy has been removed and must not be restored. */}
        <p class="text-ink-soft text-[1.08rem] leading-relaxed mb-8">
          Room allocation, supervision arrangements and the rest of the residence detail
          come from MLA, and we will publish them here as soon as they confirm.
        </p>

        <div class="flex gap-3 flex-wrap">
          <a href="/dublin-summer-2027" class="btn btn-primary">Back to the programme</a>
          <a href="/contact" class="btn btn-ghost">Book a free consultation</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
