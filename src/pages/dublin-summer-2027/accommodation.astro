---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Student Accommodation in Dublin – UCD Belgrove Residences | Immersion English"
  description="Students on the Immersion English Dublin Summer Programme stay at Belgrove Residences, University College Dublin. Private single rooms, 24/7 supervision, safe and central."
>

  <!-- HERO -->
  <section class="relative flex items-center text-white overflow-hidden isolate" style="min-height: 50vh;">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.25) 0%, rgba(20,32,26,0.7) 100%);"></div>
    <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <a href="/dublin-summer-2027" class="inline-flex items-center gap-2 text-white/60 hover:text-white text-[0.88rem] font-heading font-semibold tracking-wide mb-6 transition-colors no-underline">
        ← Dublin Summer 2027
      </a>
      <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide mb-5" style="color: var(--orange);">
        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
        Accommodation
      </p>
      <h1 class="text-white mb-5" style="max-width: 16ch;">
        Staying at University College <span style="color: var(--orange);">Dublin.</span>
      </h1>
      <p class="text-white/80 text-[1rem] md:text-[1.15rem] max-w-[50ch] leading-[1.55]">
        Students stay at Belgrove Residences on the UCD campus – private single rooms, shared apartments, and 24/7 supervision in one of Dublin's most beautiful settings.
      </p>
    </div>
  </section>

  <!-- UCD -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20 items-center">
        <div class="rounded-md overflow-hidden shadow-lift">
          <img
            src="/trinity-college.jpg"
            alt="University College Dublin campus"
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 4/3; object-position: center; display: block;"
          />
        </div>
        <div>
          <span class="eyebrow eyebrow-dot">About UCD</span>
          <h2 class="mt-4 mb-5">One of Europe's great university campuses.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Founded over 160 years ago, University College Dublin is Ireland's largest and most internationally connected university. Ranked among the top 1% of universities worldwide, UCD is home to over 38,000 students from 152 countries.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            The beautiful 1.33 km² campus combines parkland, modern facilities, and world-class learning spaces. It's a campus designed for student life – with restaurants, sports facilities, libraries, and green spaces all within walking distance.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch]">
            For our students, staying at UCD isn't just about having a bed – it's about living and learning in an environment that feels genuinely academic, international, and inspiring.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BELGROVE -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1.1fr_1fr] gap-10 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot">Where students stay</span>
          <h2 class="mt-4 mb-3">Belgrove Residences at UCD.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Belgrove Residences are a collection of three-storey apartment buildings on the UCD campus, set around landscaped grassed areas. Each student has their own <strong class="text-ink">private single bedroom</strong> within a shared apartment of 4–5 bedrooms and 2 bathrooms.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-8">
            The residences are within walking distance of campus restaurants, the university gym, and the Dublin Bus terminus – which serves 16 different routes connecting the campus directly to the city centre and beyond.
          </p>

          <!-- Quick facts grid -->
          <dl class="grid grid-cols-2 gap-5 pt-7 border-t border-line">
            {[
              { label: 'Room type', value: 'Private single bedroom' },
              { label: 'Bathrooms', value: '2 shared per apartment' },
              { label: 'Per apartment', value: '4–5 students' },
              { label: 'Boys & girls', value: 'Separate areas' },
              { label: 'Wi-Fi', value: 'Free across campus' },
              { label: 'Security', value: '24/7 on-site' },
            ].map(({ label, value }) => (
              <div>
                <dt class="font-heading text-[0.72rem] uppercase tracking-[0.12em] text-ink-soft mb-1 font-semibold">{label}</dt>
                <dd class="m-0 font-heading font-semibold text-ink text-[0.98rem]">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="rounded-md overflow-hidden shadow-lift">
          <img
            src="/students-walking.jpg"
            alt="Students walking on the UCD campus"
            class="img-greyscale w-full object-cover"
            style="aspect-ratio: 4/3; object-position: center; display: block;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">What's included</span>
        <h2>Everything your child needs – <span style="color: var(--orange);">taken care of.</span></h2>
        <p>The programme fee of €1,350 covers accommodation and all activities. Flights and food are not included.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {[
          { label: 'Private single bedroom', detail: 'your own room in a shared apartment at Belgrove Residences, UCD' },
          { label: 'Free Wi-Fi', detail: 'across the entire UCD campus' },
          { label: '24/7 security', detail: 'on-site reception and security at the residence' },
          { label: 'Night supervision', detail: 'group leaders in rooms adjacent to student areas throughout the night' },
          { label: 'Airport transfers', detail: 'supervised transport on arrival and departure days' },
          { label: 'Bulgarian speaker on hand', detail: 'at every stage of the programme – from Sofia to Dublin and back' },
          { label: 'All trips and activities', detail: 'full-day and half-day trips across Dublin and beyond' },
          { label: 'English lessons', detail: '15 hours with a CELTA-qualified native teacher' },
          { label: 'Laundry facilities', detail: 'on-site at UCD campus (at additional cost)' },
        ].map(({ label, detail }) => (
          <div class="flex items-start gap-3 rounded-lg px-4 py-4" style="background: var(--cream); border: 1px solid var(--line);">
            <span class="flex-shrink-0 mt-[5px] w-[8px] h-[8px] rounded-full" style="background: var(--orange);"></span>
            <span class="text-[0.92rem]">
              <strong class="font-semibold text-ink">{label}</strong>
              <span class="text-ink-soft"> – {detail}</span>
            </span>
          </div>
        ))}
      </div>

      <!-- Food note -->
      <div class="mt-8 rounded-lg p-6 flex items-start gap-4" style="background: var(--ink); color: white;">
        <span class="flex-shrink-0 mt-[5px] w-[8px] h-[8px] rounded-full" style="background: var(--orange);"></span>
        <div>
          <p class="font-heading font-semibold text-[0.95rem] text-white mb-1">Food is not included in the programme fee</p>
          <p class="text-[0.88rem] leading-relaxed" style="color: rgba(255,255,255,0.7);">
            There are many breakfast, lunch, and dinner options at the UCD food hall. We recommend a daily food allowance of €20–25, plus around €50 per week for souvenirs and personal extras.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- GETTING THERE -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Getting there</span>
        <h2>Flights: book your own direct Ryanair route.</h2>
        <p>Following the postponement to summer 2027, flights are no longer included in the programme fee. Parents book directly with Ryanair – it's straightforward and we make it easy.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { n: '01', title: 'Direct route', body: 'Ryanair fly direct between Sofia (SOF) and Dublin (DUB). The journey takes around 3 hours and 30 minutes.' },
          { n: '02', title: 'Step-by-step guide', body: 'Once you register, we send you a full flight booking guide with exact dates, luggage requirements, and meeting instructions at Dublin Airport.' },
          { n: '03', title: 'We meet you there', body: 'Our team meets every student at Dublin Airport on arrival day and accompanies the group back to UCD campus.' },
        ].map(({ n, title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <span class="font-heading font-bold text-[1.5rem] leading-none" style="color: var(--orange);">{n}</span>
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <span class="eyebrow eyebrow-dot" style="color: var(--orange);">Questions?</span>
      <h2 class="mt-4 mb-5">We're happy to answer anything.</h2>
      <p class="max-w-[44ch] mx-auto mb-8 text-[1.05rem]" style="color: rgba(254,255,254,0.74);">
        From room allocation to what to pack – get in touch and we'll reply within one working day.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center flex-wrap">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="/dublin-summer-2027/faqs" class="btn btn-ghost text-white border-white/30 hover:border-white">Read the FAQs</a>
      </div>
    </div>
  </section>

</BaseLayout>
