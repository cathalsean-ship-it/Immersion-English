---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dublin Summer School for Teenagers 2027 | English Immersion Programme | Immersion English"
  description="English summer school in Dublin, Ireland for teenagers aged 13–17. 1 week of immersive English lessons, city trips, and cultural activities. July 2027. Groups from Sofia, Bulgaria. Летен езиков лагер в Дъблин, Ирландия за тийнейджъри 13–17 години. Английски в Дъблин 2027."

  ogImage="/teens-dublin.webp"
>


  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "English Summer Programme for Teens – Dublin 2027",
    "description": "1-week English immersion programme in Dublin, Ireland for Bulgarian teenagers aged 13–17. CELTA-qualified teaching, city trips, full supervision. July 2027.",
    "provider": {
      "@type": "Organization",
      "name": "Immersion English",
      "url": "https://immersion-english.com"
    },
    "courseMode": "onsite",
    "educationalLevel": "B2-C1",
    "inLanguage": "en",
    "offers": {
      "@type": "Offer",
      "price": "1350",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/LimitedAvailability"
    },
    "location": {
      "@type": "Place",
      "name": "University College Dublin",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dublin",
        "addressCountry": "IE"
      }
    }
  })}</script>

  <!-- HERO -->
  <section class="relative min-h-[88vh] flex items-stretch text-white overflow-hidden isolate pb-10">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <div class="absolute inset-0 -z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(20,32,26,0.3) 0%, rgba(20,32,26,0.5) 45%, rgba(20,32,26,0.92) 100%);"></div>

    <div class="container-x relative z-10 w-full flex items-end pt-[100px] md:pt-[116px] pb-[44px] md:pb-[56px]">
      <div class="max-w-[760px]">
        <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-7">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
          Dublin, Ireland · July 2027
        </p>

        <h1 class="text-white">
          English Summer<br />
          Programme for<br />
          <span style="color: var(--orange-text);">teens aged 13–17.</span>
        </h1>

        <p class="mt-4 text-[0.98rem] md:text-[1.18rem] text-white/85 max-w-[52ch] leading-[1.55]">
          A 1-week English immersion experience in Dublin, Ireland for Bulgarian teenagers aged 13–17. Small groups, CELTA-qualified teaching, and full supervision – from arrival to departure. Your child doesn’t just learn English here. They <em style="color: var(--orange-text);">live</em> it.
        </p>

        <div class="mt-7 flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-center">
          <a href="/contact" class="btn btn-primary">
            Reserve a place
          </a>
          <a href="#programme" class="btn btn-ghost text-white border-white/30 hover:border-white">
            See the programme
          </a>
        </div>

        <div class="mt-10 pt-6 border-t border-white/[.18] grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5 max-w-[680px]">
          <div>
            <span class="block font-heading font-bold text-[1.7rem] text-white leading-none tracking-[-0.02em]">7</span>
            <span class="block mt-2 text-[0.84rem] text-white/80">Days in Dublin</span>
          </div>
          <div>
            <span class="block font-heading font-bold text-[1.7rem] text-white leading-none tracking-[-0.02em]">13–17</span>
            <span class="block mt-2 text-[0.84rem] text-white/80">Age range</span>
          </div>
          <div>
            <span class="block font-heading font-bold text-[1.7rem] text-white leading-none tracking-[-0.02em]">13</span>
            <span class="block mt-2 text-[0.84rem] text-white/80">Group size</span>
          </div>
          <div>
            <span class="block font-heading font-bold text-[1.7rem] text-white leading-none tracking-[-0.02em]">€1,350</span>
            <span class="block mt-2 text-[0.84rem] text-white/80">Programme fee</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section" style="background: linear-gradient(135deg, #008037 0%, #006a2d 100%);">
    <div class="container-x">
      <div class="max-w-[860px] mx-auto">
        <p class="eyebrow eyebrow-dot text-center mb-5" style="color: var(--orange-text);">See it for yourself</p>
        <div style="position: relative; padding-bottom: 56.25%; height: 0; border-radius: var(--radius-md); overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,0.5);">
          <iframe
            src="https://www.youtube.com/embed/4Uouprh7d1k?rel=0&color=white"
            title="Immersion English Dublin Summer Programme"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMME OVERVIEW -->
  <section id="programme" class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20 items-start">
        <div class="dublin-img-wrap" style="position: relative; border-radius: var(--radius-md); overflow: hidden; min-height: 520px;">
          <img
            src="/teens-dublin.webp"
            alt="Teenagers enjoying Dublin"
            class="img-greyscale"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%;"
          />
          <!-- Dark gradient -->
          <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,26,0) 45%, rgba(20,32,26,0.65) 100%); pointer-events: none;"></div>
          <!-- Stat badge – bottom left -->
          <div style="position: absolute; bottom: 24px; left: 24px; right: 24px; display: flex; gap: 12px;">
            <div style="background: white; border-radius: 10px; padding: 14px 18px; flex: 1; box-shadow: 0 4px 16px rgba(0,0,0,0.15);">
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: var(--green); line-height: 1; margin: 0;">13</p>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.72rem; color: var(--ink-soft); margin: 3px 0 0; text-transform: uppercase; letter-spacing: 0.06em;">Group size</p>
            </div>
            <div style="background: white; border-radius: 10px; padding: 14px 18px; flex: 1; box-shadow: 0 4px 16px rgba(0,0,0,0.15);">
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: var(--green); line-height: 1; margin: 0;">7</p>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.72rem; color: var(--ink-soft); margin: 3px 0 0; text-transform: uppercase; letter-spacing: 0.06em;">Days in Dublin</p>
            </div>
            <div style="background: var(--orange); border-radius: 10px; padding: 14px 18px; flex: 1; box-shadow: 0 4px 16px rgba(0,0,0,0.15);">
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: white; line-height: 1; margin: 0;">€1,350</p>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.72rem; color: rgba(255,255,255,0.85); margin: 3px 0 0; text-transform: uppercase; letter-spacing: 0.06em;">Programme fee</p>
            </div>
          </div>
        </div>
        <div>
          <span class="eyebrow eyebrow-dot">What's included</span>
          <h2 class="mt-4 mb-3"><span style="color: var(--orange-text);">One week</span> – a journey into Irish culture, connection and communication.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed mb-8">
            A full week of English immersion, cultural adventures, and real friendships – in one of the world's most welcoming cities.
          </p>

          <ul class="list-none p-0 m-0 flex flex-col gap-3 mb-8">
            {[
              { label: '7 nights at UCD campus', detail: 'single-room accommodation at University College Dublin' },
              { label: '15 hours of English lessons', detail: 'with Lenny, an Irish CELTA-qualified teacher with 10+ years of experience' },
              { label: '1 full-day trip and 5 half-day trips', detail: 'Glendalough, Kilkenny, Trinity College, Dublin Castle and more' },
              { label: '7 evening activities', detail: 'talent show, sports night, quiz night, games evening and more' },
              { label: 'Level test and end-of-programme certificate', detail: 'with recommended next level aligned to the CEFR' },
              { label: 'All transport within Dublin included', detail: 'no hidden costs for trips or transfers' },
              { label: 'Full supervision from arrival to departure', detail: 'with a Bulgarian-speaking staff member available at all times' },
            ].map(({ label, detail }) => (
              <li class="flex items-start gap-3 rounded-lg px-4 py-3" style="background: var(--cream); border: 1px solid var(--line);">
                <span class="flex-shrink-0 mt-[5px] w-[10px] h-[10px] rounded-full" style="background: var(--orange);"></span>
                <span class="text-[0.95rem]">
                  <strong class="font-semibold text-ink">{label}</strong>
                  <span class="text-ink-soft"> – {detail}</span>
                </span>
              </li>
            ))}
          </ul>

          <div class="rounded-lg px-5 py-4 flex items-center justify-between gap-4" style="background: var(--green); color: white;">
            <div>
              <p class="font-heading font-semibold text-[0.75rem] uppercase tracking-[0.1em] opacity-80 mb-1">Programme fee</p>
              <p class="font-heading font-bold text-[1.6rem] leading-none tracking-tight">€1,350</p>
            </div>
            <div style="border-left: 1px solid rgba(255,255,255,0.25); padding-left: 20px;">
              <p class="text-[0.85rem] opacity-85 leading-snug max-w-[22ch]">Reserve a place with a €350 deposit. Balance due 31 May 2027.</p>
            </div>
          </div>

          <p class="text-ink-soft text-[0.85rem] italic mt-4">Flights not included – parents book direct Ryanair Sofia–Dublin. We send a step-by-step guide on registration.</p>

        </div>
      </div>
    </div>
  </section>

  <!-- WHY JOIN -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Why join</span>
        <h2><span style="color: var(--orange-text);">More</span> than a language course.</h2>
        <p>A week that builds confidence, friendships, and real English for life.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {[
          { title: 'Expert CELTA-qualified teaching', body: 'Study with Cathal (Lenny) Leonard – an Irish, native CELTA-qualified teacher with over 10 years of experience teaching English to teenagers and adults.' },
          { title: 'Speak English every day', body: 'Build real communicative confidence through interactive lessons, cultural activities, and daily real-world use – English inside and outside the classroom.' },
          { title: 'Make lasting friendships', body: 'Meet like-minded teenagers, build connections that last beyond the week, and discover what it feels like to communicate freely in another language.' },
          { title: 'Explore Dublin with a local', body: 'Experience Irish culture, music, and spirit with a local who knows the city. From Trinity College to the Wicklow Mountains – a city full of stories.' },
          { title: 'Grow in real confidence', body: 'Students leave not just with better English, but with the genuine confidence to use it – in meetings, interviews, travel, and everyday life.' },
          { title: 'Safe and fully supervised', body: 'From Sofia to Dublin and back. Bulgarian-speaking staff on hand throughout, 24/7 supervision, and a pre-departure evening in Sofia for parents.' },
        ].map(({ title, body }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0; min-height: 2.6em;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SAFETY -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-20 items-center" style="padding-bottom: 28px;">
        <div>
          <span class="eyebrow eyebrow-dot">Safety & supervision</span>
          <h2 class="mt-4 mb-5">Your child is in <span style="color: var(--orange-text);">safe</span> hands – every step of the way.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            Before departure, you'll meet Lenny and our Bulgarian-speaking team member at a pre-departure information evening in Sofia. During the programme, our team is available around the clock.
          </p>
          <ul class="flex flex-col gap-3 mt-6">
            {[
              '24/7 supervision by Immersion English staff',
              'Bulgarian-speaking staff member available throughout',
              'Group leaders in rooms adjacent to student areas at night',
              '24-hour security at UCD campus',
              'Pre-departure information evening in Sofia',
            ].map(item => (
              <li class="flex items-start gap-3 rounded-lg px-4 py-3" style="background: var(--cream); border: 1px solid var(--line);">
                <span class="flex-shrink-0 mt-[5px] w-[10px] h-[10px] rounded-full" style="background: var(--orange);"></span>
                <span class="text-ink text-[0.95rem]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div style="position: relative;">
          <!-- Main photo -->
          <div style="border-radius: var(--radius-md); overflow: hidden; box-shadow: 0 8px 32px rgba(20,32,26,0.12);">
            <img
              src="/teens-cafe.webp"
              alt="Teenagers laughing together"
              class="img-greyscale w-full object-cover"
              style="aspect-ratio: 4/3; display: block;"
            loading="lazy" loading="lazy" />
          </div>
          <!-- Offset quote card -->
          <div style="position: absolute; bottom: -20px; left: -16px; background: var(--ink); color: white; border-radius: 10px; padding: 12px 16px; max-width: 220px; box-shadow: 0 6px 20px rgba(20,32,26,0.22);">
            <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange-text); margin: 0 0 5px;">From Sofia to Dublin</p>
            <p style="font-size: 0.8rem; line-height: 1.45; color: rgba(255,255,255,0.8); margin: 0;">A Bulgarian speaker on hand at every step. Your child is never alone.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION LINKS -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Explore the programme</span>
        <h2><span style="color: var(--orange-text);">Everything</span> you need to know.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {[
          { href: '/dublin-summer-2027/accommodation', title: 'Accommodation', desc: 'Single-room accommodation at University College Dublin (UCD) – safe, comfortable, and at the heart of campus life.' },
          { href: '/dublin-summer-2027/trips-and-activities', title: 'Trips & Activities', desc: 'Trinity College, Book of Kells, Howth Cliff Walk, Glendalough, Dublin Castle – 6 trips plus 7 evening activities.' },
          { href: '/dublin-summer-2027/weekly-programme', title: 'Weekly Programme', desc: 'A balanced timetable of English lessons, afternoon trips, and evening social activities – every day structured and purposeful.' },
          { href: '/dublin-summer-2027/faqs', title: 'FAQs', desc: 'Answers to the questions parents and students ask most – from booking and costs to safety and daily life in Dublin.' },
        ].map(({ href, title, desc }) => (
          <a href={href} class="trust-card group no-underline text-ink">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0; color: var(--ink-soft); font-size: 0.96rem;">{desc}</p>
            <span class="inline-flex items-center gap-2 text-[0.88rem] font-heading font-semibold mt-auto pt-4 border-t border-line group-hover:gap-3 transition-all" style="color: var(--green);">
              Find out more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container-x text-center">
      <span class="eyebrow eyebrow-dot" style="color: var(--orange-text);">Limited places</span>
      <h2 class="mt-4 mb-5">Places are limited to 13 students.<br/>Reserve yours for July 2027.</h2>
      <p class="max-w-[48ch] mx-auto mb-8 text-[1.05rem]" style="color: rgba(254,255,254,0.74);">
        Secure your child's place with a €350 deposit. Balance of €1,000 due no later than 31 May 2027.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/contact" class="btn btn-primary">
          Reserve a place
        </a>
        <a href="/dublin-summer-2027/faqs" class="btn btn-ghost text-white border-white/30 hover:border-white">
          Read the FAQs
        </a>
      </div>
    </div>
  </section>


  <!-- STICKY CTA BAR — shows on scroll -->
  <div id="sticky-cta" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 40; background: var(--ink); color: white; padding: 12px 24px; display: none; align-items: center; justify-content: space-between; gap: 12px; box-shadow: 0 -4px 20px rgba(0,0,0,0.2);">
    <div class="hidden sm:block">
      <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.88rem; margin: 0;">Dublin Summer 2027</p>
      <p style="font-size: 0.78rem; color: rgba(255,255,255,0.65); margin: 0;">€1,350 · 13 students · July 2027</p>
    </div>
    <a href="/contact" class="btn btn-primary" style="white-space: nowrap; flex-shrink: 0; font-size: 0.88rem; padding: 10px 20px;">Reserve a place</a>
  </div>

  <script>
    const stickyCta = document.getElementById('sticky-cta');
    if (stickyCta) {
      window.addEventListener('scroll', () => {
        stickyCta.style.display = window.scrollY > 600 ? 'flex' : 'none';
      }, { passive: true });
    }
  </script>
</BaseLayout>
