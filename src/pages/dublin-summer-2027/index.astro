---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import teensDublin from '../../assets/teens-dublin.jpg';
import studentsWalking from '../../assets/students-walking.jpg';
import StudentVideo from '../../components/StudentVideo.astro';
import ProgrammeTimetable from '../../components/ProgrammeTimetable.astro';
import { dublin, durationOptionsLabel, priceRangeLabel, groupLeaderTravelPhrase, groupLeaderTravelPhraseGerund, formatStartDate, bestValueDuration } from '../../data/dublin';

const { provider, venue, ages, classSize, lessonsPerWeek, hoursPerWeek, durations, price, included, notIncluded, excursions, groupLeader, secondChaperone } = dublin;

const bestValue = bestValueDuration(durations);


// JSON-LD. Provider is MLA, not Immersion English. AggregateOffer spans the
// three duration options — each has its own fixed price, not a single figure.
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `English Summer Programme for Teens – Dublin ${dublin.year}`,
  description: `Summer English programme at the ${venue.name}, ${venue.city}, for students aged ${ages.min}–${ages.max}. ${lessonsPerWeek} lessons per week. Immersion English accompanies the group in Dublin as booking agent.`,
  // No provider named — see the note in BaseLayout.astro. Leaving this out is
  // deliberate; do not point it at Immersion English.
  courseMode: 'onsite',
  inLanguage: 'en',
  // Page-specific offer. Safe here because this schema is only emitted on the
  // Dublin overview page, unlike the site-wide block in BaseLayout.
  ...(durations.length > 0 && {
    offers: {
      '@type': 'AggregateOffer',
      lowPrice: String(Math.min(...durations.map(d => d.price))),
      highPrice: String(Math.max(...durations.map(d => d.price))),
      offerCount: String(durations.length),
      priceCurrency: price.currency,
      // Must be one of Free / Partially Free / Paid / Subscription per Google's
      // Course guidance. Not free text.
      category: 'Paid',
    },
  }),
  audience: { '@type': 'Audience', audienceType: `Students aged ${ages.min}–${ages.max}` },
  location: {
    '@type': 'Place',
    name: venue.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: venue.city,
      addressRegion: venue.area,
      addressCountry: 'IE',
    },
  },
};
---

<BaseLayout
  title={`Dublin Summer ${dublin.year} for Teens (12–17) | Immersion English`}
  description={`Immersion English takes a group from Sofia to an international summer centre at the National College of Ireland, Dublin. Ages ${ages.min}–${ages.max}. ${lessonsPerWeek} lessons a week. Full board, en-suite campus accommodation. Летен езиков курс в Дъблин.`}
  ogImage="/teens-dublin.webp"
>

  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <!-- HERO -->
  <section class="relative flex flex-col md:flex-row items-stretch text-white overflow-hidden isolate">
    <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, #1a3d5c 0%, #14201a 55%, #0d2d1a 100%);"></div>
    <img src="/dublin-welcome-group.webp" alt="A group of teenagers in front of the Welcome to Dublin sign" class="order-last w-full h-auto md:absolute md:-z-[2] md:inset-auto md:right-0 md:bottom-0 md:w-[62%] md:max-h-full md:object-cover md:object-bottom" fetchpriority="high" />
    <!-- Desktop: photo sits to the right with its own light touch, fading into the dark panel behind the text, so the Dublin sign stays bright and readable. -->
    <div class="absolute inset-0 -z-[1] pointer-events-none hidden md:block" style="background: linear-gradient(90deg, #14201a 0%, #14201a 34%, rgba(20,32,26,0.8) 44%, rgba(20,32,26,0.2) 62%, rgba(20,32,26,0) 80%), linear-gradient(180deg, #14201a 0%, #14201a 24%, rgba(20,32,26,0.6) 34%, rgba(20,32,26,0) 52%, rgba(20,32,26,0.15) 100%);"></div>

    <div class="container-x relative z-10 w-full flex items-end pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
      <div class="max-w-[760px]">
        <p class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-7">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
          Dublin, Ireland · Summer {dublin.year}
        </p>

        <h1 class="text-white">
          This isn't a language course.<br />
          <span style="color: var(--orange);">It's an experience.</span>
        </h1>

        <p class="mt-4 text-[0.98rem] md:text-[1.18rem] text-white/85 max-w-[52ch] leading-[1.55]">
          {durationOptionsLabel(durations)} in Dublin. A summer your teenager won't stop talking about.
        </p>

        <div class="mt-7 flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-center">
          <a href="#included" class="btn btn-primary">
            See what's included
          </a>
          <a href="/contact" class="btn btn-ghost text-white border-white/30 hover:border-white">
            Book a free consultation
          </a>
        </div>

        <!-- Trust strip -->
        <div class="mt-10 pt-6 border-t border-white/[.18] grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 max-w-[680px]">
          {[
            'Cambridge CELTA-qualified group leader from Sofia',
            'Bulgarian speaker available throughout',
            'International centre, students from across Europe',
            'Full board, en-suite campus accommodation',
          ].map(item => (
            <p class="flex items-start gap-2 text-[0.86rem] text-white/80 m-0">
              <span class="flex-shrink-0 mt-[7px] w-[6px] h-[6px] rounded-full" style="background: var(--orange);"></span>
              <span>{item}</span>
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="section" style="padding-top: 44px; padding-bottom: 44px;">
    <div class="container-x">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            title: 'Full board',
            desc: 'Every meal covered, from dinner on arrival to breakfast on departure day. Nothing left to plan or pay for once you land.',
          },
          {
            title: `Ages ${ages.min}–${ages.max}`,
            desc: 'Old enough to explore, young enough to need looking after – so we as leaders stay close, whatever the age.',
          },
          {
            title: 'International, grouped by level',
            desc: "A placement test before departure places every student by CEFR level, alongside students from across Europe — not just their own classmates from home.",
          },
          {
            title: `${groupLeader.name}, ${groupLeader.credential}`,
            desc: `${groupLeader.credential}, ${groupLeaderTravelPhraseGerund(groupLeader)} and with them for the whole stay.`,
          },
          {
            title: secondChaperone?.role,
            desc: `With the group throughout the stay — the person parents can always reach directly, in Bulgarian.`,
          },
          {
            title: `${venue.shortName}, in the heart of Dublin`,
            desc: `Campus accommodation at the ${venue.name}, in ${venue.area} — a short walk from Temple Bar and the city centre.`,
          },
        ].map(({ title, desc }) => (
          <div class="trust-card">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0; font-size: 1.05rem;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0; font-size: 0.92rem;">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" style="padding-top: 8px;">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Choose your stay</span>
        <h2>One destination, many <span style="color: var(--orange-text);">options</span>.</h2>
        <p>Return airport transfers are already included. Families book and pay for their own flights to and from Dublin.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {durations.map(({ days, nights, price: optionPrice, startDates: optionDates }) => {
          const isFeatured = bestValue !== null && days === bestValue.days;
          return (
            <div
              class={`pricing-card${isFeatured ? ' pricing-card-featured' : ''}`}
              style="display: flex; flex-direction: column; gap: 16px; position: relative;"
            >
              {isFeatured && <span class="pricing-card-badge">Best value</span>}
              <div>
                <p class="font-heading font-semibold text-[0.78rem] uppercase tracking-[0.1em] text-ink-soft m-0 mb-1">{days} days / {nights} nights</p>
                <p class="font-heading font-bold text-[1.9rem] text-ink m-0">€{optionPrice.toLocaleString('en-IE')}</p>
                <p class="text-[0.82rem] text-ink-soft m-0 mt-1">per student + flights</p>
              </div>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
              <div>
                <p class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">{dublin.year} start dates</p>
                <p class="text-[0.88rem] text-ink-soft leading-relaxed m-0">{optionDates.map(formatStartDate).join(' · ')}</p>
              </div>
            </div>
          );
        })}
      </div>

      <div class="flex justify-center mt-8">
        <a href="/contact" class="btn btn-primary">Book a free consultation</a>
      </div>
    </div>
  </section>

  {/* TODO: awaiting review — the programme video was filmed at the cancelled UCD
      programme and shows the old venue, group and excursions. Commented out
      rather than deleted. Restore only with MLA/NCI footage. */}

  <!-- WHY THIS CENTRE -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Why Dublin Summer {dublin.year}</span>
        <h2>They won't just study English. They'll <span style="color: var(--orange-text);">live</span> it.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1.1fr_1fr] gap-8 md:gap-11">
        <div>
          <div class="md:sticky md:top-[90px]">
            <StudentVideo
              videoId="4Uouprh7d1k"
              title="Immersion English Summer Programme for Teens in Dublin"
              poster={studentsWalking}
            />
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 28px;">
          <p style="margin: 0; font-size: 1.08rem; color: var(--ink-soft);">
            The right class level, a group small enough to actually be heard in,
            and someone they know close by the whole time. That's what makes a
            week abroad turn into real immersion.
          </p>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            <h3 style="margin: 0; font-size: 1.05rem;">A city built for immersion</h3>
            <p style="margin: 0; font-size: 0.95rem;">
              Not just a classroom – a real English-speaking capital, known for
              its warm, welcoming people. Weekly excursions in Dublin, the
              harbour village of Howth, and a full day trip to Kilkenny keep the
              English going long after the lesson ends.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            <h3 style="margin: 0; font-size: 1.05rem;">An international experience</h3>
            <p style="margin: 0; font-size: 0.95rem;">
              Small classes, averaging {classSize.average} students, with peers from
              across Europe and beyond – not just other Bulgarian teenagers. A full
              international summer centre in {venue.area}, ten minutes' walk from
              the city centre.
            </p>
          </div>

          {/* The group-leader/supervision message used to repeat a third time
              here. Trimmed per site owner's instruction, 13 Oct 2026 — the
              dedicated "Who Travels With You" section below already covers
              this in full, so this block would only restate it. */}
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section id="included" class="section section-tinted">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-20 items-start">
        <div class="dublin-img-wrap" style="position: relative; border-radius: var(--radius-md); overflow: hidden; min-height: 520px;">
          <Image
            src={teensDublin}
            alt="Teenagers in Dublin"
            class="img-greyscale"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%;"
            fetchpriority="high"
            loading="eager"
            widths={[640, 1024, 1440]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
          <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,26,0) 45%, rgba(20,32,26,0.65) 100%); pointer-events: none;"></div>
          <div style="position: absolute; bottom: 24px; left: 24px; right: 24px; display: flex; gap: 12px;">
            <div style="background: white; border-radius: 10px; padding: 14px 18px; flex: 1; box-shadow: 0 4px 16px rgba(0,0,0,0.15);">
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: var(--green); line-height: 1; margin: 0;">{classSize.average}</p>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.72rem; color: var(--ink-soft); margin: 3px 0 0; text-transform: uppercase; letter-spacing: 0.06em;">Average class</p>
            </div>
            <div style="background: white; border-radius: 10px; padding: 14px 18px; flex: 1; box-shadow: 0 4px 16px rgba(0,0,0,0.15);">
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: var(--green); line-height: 1; margin: 0;">{lessonsPerWeek}</p>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.72rem; color: var(--ink-soft); margin: 3px 0 0; text-transform: uppercase; letter-spacing: 0.06em;">Lessons a week</p>
            </div>
            {/* Ink on orange, not white on orange. White on --orange is 2.23:1,
                which fails accessibility contrast even for large text. Ink gives
                7.52:1 — the same pairing .btn-primary already uses. */}
            <div style="background: var(--orange); border-radius: 10px; padding: 14px 18px; flex: 1; box-shadow: 0 4px 16px rgba(0,0,0,0.15);">
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: var(--ink); line-height: 1; margin: 0;">{ages.min}–{ages.max}</p>
              <p style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.72rem; color: rgba(20,32,26,0.78); margin: 3px 0 0; text-transform: uppercase; letter-spacing: 0.06em;">Ages</p>
            </div>
          </div>
        </div>

        <div>
          <span class="eyebrow eyebrow-dot">Included in Dublin Summer {dublin.year}</span>

          <dl class="grid grid-cols-2 gap-7 mt-6 mb-8 py-8 border-y border-line">
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Lengths available</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">{durationOptionsLabel(durations)}</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Ages</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">{ages.min}–{ages.max}</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Class size</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">{classSize.average} average, {classSize.maximum} maximum</dd>
            </div>
            <div>
              <dt class="font-heading text-[0.74rem] uppercase tracking-[0.14em] text-ink-soft mb-2 font-semibold">Programme fee</dt>
              <dd class="m-0 font-heading font-semibold text-[1.08rem] text-ink tracking-[-0.01em]">From {priceRangeLabel(durations)}</dd>
            </div>
          </dl>

          <ul class="list-none p-0 m-0 flex flex-col gap-3 mb-6">
            {included.map(item => {
              const [lead, ...rest] = item.split(' – ');
              return (
                <li class="flex items-start gap-3 rounded-lg px-4 py-3" style="background: var(--cream); border: 1px solid var(--line);">
                  <span class="flex-shrink-0 mt-[5px] w-[10px] h-[10px] rounded-full" style="background: var(--orange);"></span>
                  <span class="text-[0.95rem]">
                    <strong class="font-semibold text-ink">{lead}</strong>
                    {rest.length > 0 && <span class="text-ink-soft"> – {rest.join(' – ')}</span>}
                  </span>
                </li>
              );
            })}
          </ul>

          {/* TODO: awaiting MLA 2027 confirmation — NCI excursion list, catalogue p.44.
              The "full excursion programme" bullet above deliberately names no
              excursions. The six UCD-era trips were self-chosen by Immersion English
              and must not be reinstated. Restore a named list only from
              dublin.ts excursions. */}

          <p class="text-ink-soft text-[0.9rem] leading-relaxed">
            Not included: {notIncluded.join(', ').toLowerCase()}. A refundable
            €{dublin.securityDeposit.amount} security deposit is collected on arrival.
          </p>
        </div>
      </div>

      <!-- SAMPLE TIMETABLE -->
      <div class="mt-16 md:mt-20">
        <p class="text-ink-soft text-[0.95rem] leading-relaxed max-w-[62ch] mb-6">
          Lessons in the mornings or afternoons, an excursion or activity in the other half of the day, and something different every evening. Sample 14-day / 13-night programme; shorter stays follow a shorter schedule.
        </p>

        <ProgrammeTimetable />
      </div>
    </div>
  </section>

  <!-- WHO TRAVELS WITH YOU -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-20 items-center">
        <div>
          <span class="eyebrow eyebrow-dot">Supervision</span>
          <h2 class="mt-4 mb-5"><span style="color: var(--orange-text);">Supported</span>, every step of the way.</h2>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-5">
            For many teenagers this is the first time away from home without their parents, and
            we know that's a big moment for you too. We give them real independence, with
            supervision always close by, and we stay in touch with you throughout.
          </p>
          <p class="text-ink-soft text-[1.05rem] leading-relaxed max-w-[54ch] mb-0">
            {groupLeader.name}{secondChaperone?.name ? ` and ${secondChaperone.name}` : ''} {groupLeader.travelsFromSofia ? 'travel with the group from Sofia and stay for the whole programme' : `meet the group at ${groupLeader.meetsAt} and stay for the whole programme`}.
            With {secondChaperone?.name ?? 'a native Bulgarian speaker'} speaking Bulgarian, and a welfare manager
            and medical staff on site around the clock, someone is always there for your child,
            and for you.
          </p>
        </div>
        <div style="position: relative;">
          <div class="grid grid-cols-2 gap-3">
            {[
              { src: '/team-lenny.webp', name: groupLeader.name, role: 'Group leader', pos: 'center 25%' },
              { src: '/team-lina.webp', name: secondChaperone?.name ?? 'Lina', role: 'Group leader · Bulgarian speaker', pos: 'center 20%' },
            ].map(({ src, name, role, pos }) => (
              <div style={`position: relative; border-radius: var(--radius-md); overflow: hidden; box-shadow: 0 8px 32px rgba(20,32,26,0.12); aspect-ratio: 3/4;`}>
                <img
                  src={src}
                  alt={`${name}, Immersion English group leader`}
                  class="img-greyscale"
                  style={`position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: ${pos};`}
                  loading="lazy" />
                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,26,0) 55%, rgba(20,32,26,0.78) 100%); pointer-events: none;"></div>
                <div style="position: absolute; left: 14px; right: 14px; bottom: 12px; color: white;">
                  <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1rem; margin: 0; color: white;">{name}</p>
                  <p style="font-size: 0.74rem; line-height: 1.3; margin: 2px 0 0; color: rgba(255,255,255,0.82);">{role}</p>
                </div>
              </div>
            ))}
          </div>
          <div style="margin-top: 14px; background: var(--ink); color: white; border-radius: 10px; padding: 14px 18px; box-shadow: 0 6px 20px rgba(20,32,26,0.22);">
            <p style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange); margin: 0 0 5px;">From Sofia to Dublin</p>
            <p style="font-size: 0.8rem; line-height: 1.45; color: rgba(255,255,255,0.8); margin: 0;">A native Bulgarian speaker on hand throughout the stay. Your child is never alone.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKING CTA -->
  <section class="section section-tinted">
    <div class="container-x">
      <div class="max-w-[62ch] mx-auto">
        <div class="flex justify-center">
          <a href="/about" class="btn btn-primary">More about us</a>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION LINKS -->
  <section class="section">
    <div class="container-x">
      <div class="section-head">
        <span class="eyebrow eyebrow-dot">Explore the programme</span>
        <h2><span style="color: var(--orange-text);">Everything</span> you need to know.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {[
          { href: '/dublin-summer-2027/accommodation', title: 'Accommodation', desc: `En-suite rooms on campus at the ${venue.name}, with full board.` },
          { href: '/dublin-summer-2027/trips-and-activities', title: 'Trips & Activities', desc: `The full excursion programme, plus evening and weekend activities run by the centre's own team.` },
          { href: '/dublin-summer-2027/weekly-programme', title: 'Weekly Programme', desc: `${lessonsPerWeek} lessons every week – ${hoursPerWeek} hours – with the centre's qualified teachers.` },
          { href: '/dublin-summer-2027/faqs', title: 'FAQs', desc: 'Answers to the questions parents and students ask most.' },
        ].map(({ href, title, desc }) => (
          <a href={href} class="trust-card group no-underline text-ink">
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <h3 style="margin: 0;">{title}</h3>
              <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange);"></div>
            </div>
            <p style="margin: 0; color: var(--ink-soft); font-size: 0.96rem;">{desc}</p>
            <span class="inline-flex items-center gap-2 text-[0.88rem] font-heading font-semibold mt-auto pt-4 border-t border-line group-hover:gap-3 transition-all" style="color: var(--green);">
              Find out more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
