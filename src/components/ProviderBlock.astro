---
/**
 * Provider disclosure — compact note.
 *
 * Reduced twice at the site owner's request: parents do not need the agent
 * relationship spelled out on every page, and comparable agency sites do not
 * foreground it. It now appears ONCE, beside the booking CTA on the Dublin
 * overview page, with a one-line version in the site footer.
 *
 * Keep it on the booking path. Wherever someone is being asked to commit money,
 * they should be able to see who the money is actually buying from without
 * hunting for it. Moving it off the overview page entirely, or behind a link,
 * would put it somewhere nobody reads before paying.
 */
import { dublin } from '../data/dublin';

const { provider, venue } = dublin;
---

<div
  class="rounded-lg px-5 py-4 mt-8"
  style="background: var(--cream); border: 1px solid var(--line);"
>
  <p class="text-[0.88rem] leading-relaxed m-0" style="color: var(--ink-soft);">
    <strong class="font-semibold" style="color: var(--ink);">How this works:</strong>
    {' '}the programme is run by {provider.brand} at the {venue.name}. Immersion English
    books your place and accompanies the group in Dublin; your booking contract is with
    {' '}{provider.legalEntity} under MLA's terms.
    {/* TODO: awaiting MLA 2027 confirmation — terms and safeguarding policy URLs.
        Link them here once dublin.ts provider.termsUrl / .safeguardingUrl are set. */}
    {provider.termsUrl && (
      <>
        {' '}<a href={provider.termsUrl} target="_blank" rel="noopener noreferrer">Read the full terms</a>.
      </>
    )}
  </p>
</div>
