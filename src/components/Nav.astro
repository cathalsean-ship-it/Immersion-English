---
import { type Lang, switchTarget, bgHref } from '../data/i18n';

interface Props { lang?: Lang; path?: string }
const { lang = 'en', path = '/' } = Astro.props;
const bg = lang === 'bg';

// On Bulgarian pages, labels are Bulgarian and links go to the Bulgarian
// version where one exists (see BG_PAGES in i18n.ts); otherwise to English.
const t = bg
  ? { about: 'За нас', lessons: 'Уроци', det: 'Duolingo тест', corporate: 'Корпоративно обучение', dublin: 'Лято в Дъблин 2027', blog: 'Блог', contact: 'Контакти', home: 'Immersion English – начало', open: 'Отвори менюто', detBtn: 'Duolingo тест', detLabel: 'Duolingo English Test – подготовка и информация', sub: 'Покажи подменюто за Лято в Дъблин', lessonsSub: 'Покажи подменюто за Уроци', detPrep: 'Подготовка за Duolingo English Test', groupLessons: 'Индивидуални и групови уроци' }
  : { about: 'About', lessons: 'Lessons', det: 'Duolingo Test', corporate: 'Corporate Training', dublin: 'Dublin Summer 2027', blog: 'Blog', contact: 'Contact', home: 'Immersion English – home', open: 'Open menu', detBtn: 'Duolingo Test', detLabel: 'Duolingo English Test – preparation and information', sub: 'Toggle Dublin Summer submenu', lessonsSub: 'Toggle Lessons submenu', detPrep: 'Duolingo English Test prep', groupLessons: 'Individual & group lessons' };
const href = (h: string) => (bg ? bgHref(h) : h);
const homeHref = bg ? '/bg' : '/';
const switchHref = switchTarget(path);

const dublinSub = [
  { href: '/dublin-summer-2027/accommodation', label: bg ? 'Настаняване' : 'Accommodation' },
  { href: '/dublin-summer-2027/trips-and-activities', label: bg ? 'Екскурзии и занимания' : 'Trips & Activities' },
  { href: '/dublin-summer-2027/weekly-programme', label: bg ? 'Седмична програма' : 'Weekly Programme' },
  { href: '/dublin-summer-2027/faqs', label: bg ? 'Въпроси и отговори' : 'FAQs' },
].map(i => ({ ...i, href: href(i.href) }));

const lessonsSub = [
  { href: href('/lessons') + '#courses', label: t.groupLessons },
  { href: href('/duolingo-english-test'), label: t.detPrep },
  { href: href('/corporate-training'), label: t.corporate },
];
---

<header class="sticky top-0 z-50 border-b border-ink/5 bg-off-white/70 backdrop-blur-md backdrop-saturate-150">
  <nav class="container-x">
    <div class="flex items-center justify-between gap-6 h-[72px]">
      <a href={homeHref} class="flex items-center gap-3 no-underline shrink-0" aria-label={t.home}>
        <img src="/ie-logo-80.png" alt="Immersion English" width="40" height="40" class="h-10 w-auto block" loading="eager" />
        <span class="block text-[0.72rem] font-heading font-semibold tracking-wide leading-tight" style="color: var(--ink-soft);">English.<br>For Living.</span>
      </a>

      <!-- DUOLINGO BUTTON: goes to our Duolingo English Test page (the page's own buttons carry the invite link),
           and stands in for a 'Duolingo Test' item in the menu.
           The full menu needs the xl width (1280px+) once this button is in; below that the menu button is used.
           Beside the full menu there is only room for the logo, so the 'Get the test' words show on tablets and
           phones in the menu-button layout (the link's aria-label says it for screen readers). Phones show the logo only.
           The logo is Duolingo's own file, used as supplied (no recolouring or stretching). -->
      <a
        href={href("/duolingo-english-test")}
        id="det-invite"
        aria-label={t.detLabel}
        title={t.detBtn}
        class="det-invite ml-auto shrink-0 flex items-center gap-3 no-underline bg-white rounded-full border border-ink/10 px-3 sm:px-4 py-2 transition-colors hover:border-brand-green"
      >
        <img src="/det/det-logo.png" alt="Duolingo English Test" width="293" height="44" class="h-[14px] sm:h-[18px] w-auto block" loading="eager" />
        <span class="hidden sm:block xl:hidden w-px h-4 bg-ink/15" aria-hidden="true"></span>
        <span class="hidden sm:block xl:hidden whitespace-nowrap font-heading font-semibold text-[0.8rem] text-ink">{t.detBtn}</span>
      </a>

      <!-- DESKTOP NAV -->
      <div class="hidden xl:flex items-center gap-5">
        <a href={href("/about")} class="text-ink-soft no-underline whitespace-nowrap text-[0.94rem] font-medium hover:text-brand-green transition-colors">{t.about}</a>
        <!-- Lessons dropdown (Corporate Training and DET prep sit under it to keep the menu short) -->
        <div class="relative group">
          <a href={href("/lessons")} class="flex items-center gap-1 text-ink-soft no-underline whitespace-nowrap text-[0.94rem] font-medium hover:text-brand-green transition-colors">
            {t.lessons}
            <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
            <ul class="bg-off-white border border-line rounded-md shadow-lift py-2 min-w-[250px]">
              {lessonsSub.map(item => (
                <li>
                  <a href={item.href} class="block px-5 py-[10px] text-[0.9rem] text-ink-soft no-underline whitespace-nowrap hover:text-brand-green hover:bg-cream transition-colors">{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Dropdown -->
        <div class="relative group">
          <a
            href={href("/dublin-summer-2027")}
            class="flex items-center gap-1 no-underline whitespace-nowrap text-[0.94rem] font-semibold transition-opacity hover:opacity-80"
            style="color: var(--orange-text);"
          >
            {t.dublin}
            <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <!-- pt-3 keeps the hover bridge so the menu doesn't close in the gap -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
            <ul class="bg-off-white border border-line rounded-md shadow-lift py-2 min-w-[230px]">
              {dublinSub.map(item => (
                <li>
                  <a
                    href={item.href}
                    class="block px-5 py-[10px] text-[0.9rem] text-ink-soft no-underline hover:text-brand-green hover:bg-cream transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href={href("/blog")} class="text-ink-soft no-underline whitespace-nowrap text-[0.94rem] font-medium hover:text-brand-green transition-colors">{t.blog}</a>
        <a href={href("/contact")} class="text-ink-soft no-underline whitespace-nowrap text-[0.94rem] font-medium hover:text-brand-green transition-colors">{t.contact}</a>
        <span class="flex items-center gap-1 text-[0.82rem] font-heading font-semibold pl-5 border-l border-line" aria-label="Language">
          {bg ? <a href={switchHref} hreflang="en" lang="en" class="text-ink-soft no-underline hover:text-brand-green transition-colors">EN</a> : <span class="text-ink" aria-current="true">EN</span>}
          <span class="text-ink-mute" aria-hidden="true">|</span>
          {bg ? <span class="text-ink" aria-current="true">БГ</span> : <a href={switchHref} hreflang="bg" lang="bg" class="text-ink-soft no-underline hover:text-brand-green transition-colors">БГ</a>}
        </span>
      </div>

      <!-- MOBILE TOGGLE -->
      <button
        id="nav-toggle"
        class="xl:hidden w-10 h-10 p-2 bg-transparent border-0 flex flex-col justify-center items-stretch gap-[5px] cursor-pointer"
        aria-label={t.open}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block h-[2px] bg-ink rounded-[2px] transition-transform"></span>
        <span class="block h-[2px] bg-ink rounded-[2px] transition-opacity"></span>
        <span class="block h-[2px] bg-ink rounded-[2px] transition-transform"></span>
      </button>
    </div>

    <!-- MOBILE MENU -->
    <div id="mobile-menu" class="hidden xl:hidden pb-5">
      <div class="flex flex-col gap-1 border-t border-line pt-4">
        <!-- Mobile dropdown — link + separate chevron -->
        <div>
          <div class="flex items-center justify-between">
            <a href={href("/dublin-summer-2027")} class="py-2 no-underline text-[0.98rem] font-semibold flex-1" style="color: var(--orange-text);">
                {t.dublin}
            </a>
            <button
              id="mobile-dublin-toggle"
              class="w-10 h-10 flex items-center justify-center bg-transparent border-0 cursor-pointer transition-colors" style="color: var(--orange-text);"
              aria-expanded="false"
              aria-controls="mobile-dublin-sub"
              aria-label={t.sub}
            >
              <svg id="mobile-dublin-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <ul id="mobile-dublin-sub" class="hidden flex-col gap-1 pl-4 mt-1 mb-2 border-l-2 border-line">
            {dublinSub.map(item => (
              <li>
                <a href={item.href} class="block py-[7px] text-[0.92rem] text-ink-soft no-underline hover:text-brand-green transition-colors">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <a href={href("/about")} class="py-2 text-ink-soft no-underline text-[0.98rem] font-medium hover:text-brand-green transition-colors">{t.about}</a>
        <div>
          <div class="flex items-center justify-between">
            <a href={href("/lessons")} class="py-2 text-ink-soft no-underline text-[0.98rem] font-medium flex-1 hover:text-brand-green transition-colors">{t.lessons}</a>
            <button
              id="mobile-lessons-toggle"
              class="w-10 h-10 flex items-center justify-center bg-transparent border-0 cursor-pointer text-ink-soft"
              aria-expanded="false"
              aria-controls="mobile-lessons-sub"
              aria-label={t.lessonsSub}
            >
              <svg id="mobile-lessons-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <ul id="mobile-lessons-sub" class="hidden flex-col gap-1 pl-4 mt-1 mb-2 border-l-2 border-line">
            {lessonsSub.map(item => (
              <li>
                <a href={item.href} class="block py-[7px] text-[0.92rem] text-ink-soft no-underline hover:text-brand-green transition-colors">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <a href={href("/blog")} class="py-2 text-ink-soft no-underline text-[0.98rem] font-medium hover:text-brand-green transition-colors">{t.blog}</a>
        <a href={href("/contact")} class="py-2 text-ink-soft no-underline text-[0.98rem] font-medium hover:text-brand-green transition-colors">{t.contact}</a>
        <div class="flex items-center gap-2 pt-3 mt-2 border-t border-line text-[0.9rem] font-heading font-semibold" aria-label="Language">
          {bg ? <a href={switchHref} hreflang="en" lang="en" class="text-ink-soft no-underline">English</a> : <span class="text-ink" aria-current="true">English</span>}
          <span class="text-ink-mute" aria-hidden="true">|</span>
          {bg ? <span class="text-ink" aria-current="true">Български</span> : <a href={switchHref} hreflang="bg" lang="bg" class="text-ink-soft no-underline">Български</a>}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Count clicks on the Duolingo button (to our DET page) (only sent if the visitor accepted cookies)
  document.getElementById('det-invite')?.addEventListener('click', () => {
    if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'det_page_click', { location: 'header' });
  });

  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Mobile submenu toggles (Dublin Summer, Lessons)
  for (const name of ['dublin', 'lessons']) {
    const subToggle = document.getElementById(`mobile-${name}-toggle`);
    const sub = document.getElementById(`mobile-${name}-sub`);
    const chevron = document.getElementById(`mobile-${name}-chevron`);
    subToggle?.addEventListener('click', () => {
      const open = sub?.classList.toggle('hidden') === false;
      sub?.classList.toggle('flex', open);
      subToggle.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    });
  }
</script>
