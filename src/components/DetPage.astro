---
/**
 * Duolingo English Test page body, in English or Bulgarian.
 *
 * Both /duolingo-english-test and /bg/duolingo-english-test render this, so
 * the two versions share one layout and one set of figures (src/data/det.ts
 * and src/data/courses.ts). Only the words differ. Do not type a price, a
 * duration or a count into the copy below – interpolate it.
 *
 * Partner badge: /det-gpn-member.svg is Duolingo's "Member" Global Partner
 * Network logo, unaltered except that the word MEMBER, which Duolingo ship as
 * live text in a font browsers don't have, was converted to outlines in Nunito,
 * the substitute font their brand guidelines name. Their guidelines also say:
 * don't recolour, stretch or add effects, keep it on a background where it is
 * legible, and don't show it too small to read. The clear space is built in.
 */
import { det, otherTests } from '../data/det';
import { courses, services } from '../data/courses';

interface Props { lang: 'en' | 'bg' }
const { lang } = Astro.props;
const bg = lang === 'bg';
const contact = bg ? '/bg/contact' : '/contact';
const c = (interest: string, from: string) => `${contact}?interest=${interest}&from=${from}#booking-form`;

const fb = services.detFeedback.price;
const prep = courses.examPreparation;

const t = bg ? {
  eyebrow: 'Duolingo English Test',
  h1a: 'Сертификат по английски ', h1b: 'по всяко време, навсякъде.', h1c: '',
  lead: `Duolingo English Test (DET) се признава от над ${det.institutionsBg} институции по света, струва около ${det.priceEurApprox} € и резултатите излизат до ${det.resultsDays} дни. Ще ви помогнем да прецените дали е подходящ за вас – и ще ви подготвим за него.`,
  ctaMain: 'Безплатна консултация', ctaFb: 'Вземете теста',
  badgeAlt: 'Duolingo English Test – Global Partner Network – Member',
  badgeCaption: 'Член на глобалната партньорска мрежа на Duolingo English Test',

  whatEyebrow: 'Тестът', whatH2a: 'Какво е ', whatH2b: 'Duolingo English Test?',
  whoLine: 'Модерен изпит по английски, положен от вкъщи, за ученици в последните класове и за всеки, който кандидатства в университет в чужбина.',
  fmtEyebrow: 'Формат на изпита', fmtH2a: 'Какво включва ', fmtH2b: 'Duolingo English Test?',
  fmtIntro: 'Изпитът проверява и четирите умения – четене, писане, слушане и говорене – за около час, наведнъж и в три части. Броят на въпросите е различен, защото тестът се адаптира към вас.',
  parts: [
    { n: `около ${det.format.setupMin} минути`, h: 'Подготовка', p: 'Покажете документ за самоличност, сканирайте стаята с телефона си и го нагласете като втора камера. Тук още нищо не се оценява.' },
    { n: `около ${det.format.adaptiveMin} минути`, h: 'Самият изпит', p: 'Кратки задачи по четене, слушане, писане и говорене. Стават по-трудни или по-лесни според отговорите ви и именно тази част определя резултата ви.' },
    { n: `около ${det.format.samplesMin} минути`, h: 'По-дълга писмена и устна задача', p: 'Напишете кратко есе и запишете един по-дълъг устен отговор. Те не се оценяват, но университетите ги получават заедно с резултата ви.' },
  ],
  qH3: 'Типове задачи',
  skills: [
    { k: 'Четене', v: det.questionTypes.reading.join(', ') },
    { k: 'Слушане', v: det.questionTypes.listening.join(', ') },
    { k: 'Писане', v: det.questionTypes.writing.join(', ') },
    { k: 'Говорене', v: det.questionTypes.speaking.join(', ') },
  ],
  scoreEyebrow: 'Резултати', scoreH2a: 'Какъв резултат от Duolingo English Test ', scoreH2b: 'ви е нужен?',
  scoreIntro: `Резултатите са от ${det.scoreMin} до ${det.scoreMax}. Ето как се сравняват с бандовете в IELTS и нивата по CEFR според официалното сравнение на Duolingo. Много университети изискват резултат ${det.typicalAsk}, а най-селективните – повече. Винаги проверявайте изискванията на вашата програма.`,
  scoreHead: ['Duolingo English Test', 'IELTS Academic', 'CEFR'],
  scoreKey: 'Диапазонът, който много университети изискват',
  stats: [
    { n: '~1 час', l: 'на собствения ви компютър, когато ви е удобно' },
    { n: det.institutionsBg, l: 'институции по света го признават' },
    { n: `${det.resultsDays} дни`, l: 'до резултатите' },
    { n: `~${det.priceEurApprox} €`, l: 'целият изпит, с неограничено изпращане на резултата' },
    { n: 'Адаптивен', l: 'въпросите стават по-трудни или по-лесни според отговорите ви, така че решавате задачи, близки до вашето ниво' },
    { n: '4 умения', l: 'четене, писане, слушане и говорене – в един изпит' },
  ],


  cmpEyebrow: 'Сравнение', cmpH2a: 'Duolingo English Test, ', cmpH2b: 'IELTS или Cambridge?',
  cmpHead: ['', 'Duolingo|English Test', 'IELTS|Academic', 'Cambridge|C1 Advanced'],
  cmpRows: [
    ['Цена', `около ${det.priceEurApprox} €, еднаква навсякъде`, `${otherTests.ieltsAcademicEur} €`, `${otherTests.cambridgeC1Eur} €`],
    ['Продължителност', 'около 1 час', 'около 2 часа и 45 минути', 'около 4 часа'],
    ['Къде и кога', 'от вкъщи, по всяко време', 'в изпитен център или онлайн от вкъщи, на определени дати', 'в изпитен център, на определени дати'],
    ['Резултати', `до ${det.resultsDays} дни`, '1–5 дни (на компютър), 6–8 дни (онлайн), около 13 дни (на хартия)', '1–3 седмици (на компютър), 4–6 седмици (на хартия)'],
    ['Оценяване', `${det.scoreMin}–${det.scoreMax} общо, плюс оценка за четене, писане, слушане и говорене`, 'бандове 0–9 общо, плюс оценка за всяко умение', 'Cambridge English Scale 160–210, оценка (A, B или C) и резултат за всяко умение'],
    ['Изпращане на резултата', 'безплатно, до колкото университети пожелаете', '5 безплатни копия, след това такса за всяко следващо', 'безплатна онлайн проверка за университетите'],
  ],

  helpEyebrow: 'Как можем да помогнем', helpH2a: 'Подгответе се ', helpH2b: 'с партньор и сертифициран обучител на DET',
  offers: [
    { h: 'Изберете правилния изпит', p: 'Не сте сигурни кой изпит е подходящ за вашите планове? Ще го обсъдим и ще ви кажем честно – DET, IELTS или Cambridge.', price: 'Безплатно', cta: 'Запишете консултация', href: c('det', 'det-offer-consultation') },
    { h: 'Подготовка 1:1', p: 'Индивидуални онлайн уроци за типовете задачи, времето и стратегията в DET, с ексклузивните материали на Duolingo – и обратна връзка за говоренето и писането ви от обучен изпитващ по говорене.', price: `${prep.perLesson} € / ${prep.lessonMinutes} мин`, cta: 'Попитайте за уроците', href: c('det', 'det-offer-lessons') },
    { h: 'Купете теста чрез нас', p: 'Купете теста с нашия код за покана. Ще виждаме официалния ви резултат и оценките по отделните умения, за да насочим подготовката точно там, където е нужна – с ексклузивните материали на Duolingo за партньори.', price: 'Официален партньор на DET', cta: 'Регистрирайте се с този линк', href: det.inviteUrl, ext: true },
  ],

  trainerEyebrow: 'Вашият преподавател',
  trainerCreds: `${det.trainerTitle.bg} · Изпитващ по говорене (British Council ESAT-J) · CELTA`,
  trainerP: 'Лени е носител на езика от Ирландия с над десет години опит в подготовката на ученици за изпити, включително IELTS и Cambridge C1 Advanced. Като обучен изпитващ по говорене той знае какво търсят оценителите – и как да помогне на притеснените да покажат на какво са способни.',
  photoAlt: 'Каъл (Лени) Леонард, преподавател в Immersion English',

  faqEyebrow: 'Въпроси', faqH2a: 'Duolingo English Test – ', faqH2b: 'често задавани въпроси',
  faqs: [
    { q: 'Кои университети приемат Duolingo English Test?', a: `Повече от ${det.institutionsBg} институции по света. В Ирландия почти всички университети го приемат, а виза не ви е нужна. Във Великобритания над ${det.ukUniversities} университета го приемат за бакалавърски и магистърски програми, но за подготвителна (foundation) или pre-sessional програма ще ви трябва одобрен от UKVI тест, например IELTS for UKVI. В САЩ и Канада е широко признат, включително от всички осем университета от Бръшляновата лига. За Нидерландия първо говорете с нас – няколко от големите университети там все още не го приемат. Винаги проверявайте изискванията на конкретната програма.` },
    { q: 'Може ли да се вярва на изпит, положен от вкъщи?', a: 'Да. Цялата сесия се записва чрез компютъра, камерата на телефона, микрофона, клавиатурата и мишката. Обучени проктори, подпомагани от изкуствен интелект, преглеждат всеки тест в няколко независими кръга, преди резултатът да бъде издаден. Въпросите идват от огромна база, а тестът се прекратява автоматично, ако опитате да отворите друго приложение.' },
    { q: 'Какво ми трябва, за да го положа?', a: 'Компютър с Windows или Mac с камера, микрофон и високоговорители, безплатното десктоп приложение на Duolingo English Test, смартфон (служи като втора камера, която записва екрана и клавиатурата ви), тиха стая, в която сте сами, и документ за самоличност.', link: { href: det.appDownloadUrl, label: 'Изтеглете приложението' } },
    { q: 'Има ли изпитващ при говоренето?', a: 'Не. Виждате или чувате задачата на екрана, имате момент да помислите и отговаряте – само вие и камерата. Говоренето се оценява като отделно умение, а университетите могат да гледат видеото ви. Без изпитващ срещу вас обаче напрежението е много по-малко.' },
    { q: 'Как се оценява?', a: `Получавате обща оценка от ${det.scoreMin} до ${det.scoreMax}, на стъпки от 5 точки, плюс отделни оценки за четене, писане, слушане и говорене.` },
    { q: 'Колко време е валиден резултатът?', a: `${det.validityYears} години.` },
    { q: 'Колко струва?', a: `${det.priceUsd} щатски долара (около ${det.priceEurApprox} €), еднаква цена навсякъде. Резултатите излизат до ${det.resultsDays} дни, а изпращането им до университети е безплатно.` },
    { q: 'Трябва ли да го положа веднага след покупката?', a: `Не. Имате ${det.daysToTakeAfterPurchase} дни да го положите.` },
  ],

  endH2: 'Не сте сигурни кой изпит е подходящ за вас?',
  endP: 'Запишете безплатна консултация и ще ви помогнем да изберете – без ангажимент.',
  endFb: `Обратна връзка – ${fb} €`,
} : {
  eyebrow: 'Duolingo English Test',
  h1a: 'Certify your English ', h1b: 'anytime, anywhere.', h1c: '',
  lead: `The Duolingo English Test (DET) is accepted by more than ${det.institutions} institutions worldwide, costs about €${det.priceEurApprox} and gives results in ${det.resultsDays} days. We'll help you decide if it's right for you – and get you ready for it.`,
  ctaMain: 'Book a free consultation', ctaFb: 'Get the test',
  badgeAlt: 'Duolingo English Test – Global Partner Network – Member',
  badgeCaption: 'Member of the Duolingo English Test Global Partner Network',

  whatEyebrow: 'The test', whatH2a: 'What is the ', whatH2b: 'Duolingo English Test?',
  whoLine: 'A modern English test, taken from home, for students in their final school years and anyone applying to a university abroad.',
  fmtEyebrow: 'Test format', fmtH2a: 'What\'s in the ', fmtH2b: 'Duolingo English Test?',
  fmtIntro: 'The test checks all four skills – reading, writing, listening and speaking – in about an hour, in one sitting and in three parts. The number of questions varies, because the test adapts as you go.',
  parts: [
    { n: `about ${det.format.setupMin} minutes`, h: 'Getting set up', p: 'Show your ID, scan the room with your phone, and set the phone up as a second camera. Nothing is scored yet.' },
    { n: `about ${det.format.adaptiveMin} minutes`, h: 'The test itself', p: 'Short questions covering reading, listening, writing and speaking. They get harder or easier depending on your answers, and this part gives you your score.' },
    { n: `about ${det.format.samplesMin} minutes`, h: 'A longer writing and speaking task', p: 'Write one short essay and record one longer spoken answer. These aren\'t scored, but universities receive them with your result.' },
  ],
  qH3: 'Question types',
  skills: [
    { k: 'Reading', v: det.questionTypes.reading.join(', ') },
    { k: 'Listening', v: det.questionTypes.listening.join(', ') },
    { k: 'Writing', v: det.questionTypes.writing.join(', ') },
    { k: 'Speaking', v: det.questionTypes.speaking.join(', ') },
  ],
  scoreEyebrow: 'Scores', scoreH2a: 'What Duolingo English Test score ', scoreH2b: 'do you need?',
  scoreIntro: `Scores run from ${det.scoreMin} to ${det.scoreMax}. Here's how they compare with IELTS bands and CEFR levels, according to Duolingo's official comparison. Many universities ask for a score of ${det.typicalAsk}, and the most selective ask for more. Always check your own programme.`,
  scoreHead: ['Duolingo English Test', 'IELTS Academic', 'CEFR'],
  scoreKey: 'The range many universities ask for',
  stats: [
    { n: '~1 hour', l: 'on your own computer, whenever suits you' },
    { n: det.institutions, l: 'institutions worldwide accept it' },
    { n: `${det.resultsDays} days`, l: 'for your results' },
    { n: `~€${det.priceEurApprox}`, l: 'the full test, with unlimited score reports included' },
    { n: 'Adaptive', l: 'questions get harder or easier as you answer, so you don\'t attempt questions far beyond your English level' },
    { n: '4 skills', l: 'reading, writing, listening and speaking, all in one test' },
  ],


  cmpEyebrow: 'At a glance', cmpH2a: 'How does the Duolingo English Test compare ', cmpH2b: 'to other tests?',
  cmpHead: ['', 'Duolingo|English Test', 'IELTS|Academic', 'Cambridge|C1 Advanced'],
  cmpRows: [
    ['Price', `about €${det.priceEurApprox}, the same everywhere`, `€${otherTests.ieltsAcademicEur}`, `€${otherTests.cambridgeC1Eur}`],
    ['Length', 'about 1 hour', 'about 2 hours 45 minutes', 'about 4 hours'],
    ['Where and when', 'at home, any time', 'at a test centre, or online from home, on booked dates', 'at an exam centre, on set dates'],
    ['Results', `within ${det.resultsDays} days`, '1–5 days (computer), 6–8 days (online), about 13 days (paper)', '1–3 weeks (computer), 4–6 weeks (paper)'],
    ['Scoring', `${det.scoreMin}–${det.scoreMax} overall, plus a score for reading, writing, listening and speaking`, 'bands 0–9 overall, plus a band for each skill', 'Cambridge English Scale 160–210, a grade (A, B or C) and a score for each skill'],
    ['Sending your score', 'free, to as many universities as you like', '5 free copies, then a fee per extra copy', 'free online verification for universities'],
  ],

  helpEyebrow: 'How we can help', helpH2a: 'Prepare with ', helpH2b: 'a DET partner and certified trainer',
  offers: [
    { h: 'Choose the right test', p: 'Not sure which test fits your plans? We\'ll talk it through and tell you honestly – DET, IELTS or Cambridge.', price: 'Free', cta: 'Book a consultation', href: c('det', 'det-offer-consultation') },
    { h: 'Prepare 1:1', p: '1:1 online lessons on the DET\'s question types, timing and strategy, using Duolingo\'s exclusive preparation materials – with feedback on your speaking and writing from a trained speaking examiner.', price: `€${prep.perLesson} / ${prep.lessonMinutes} min`, cta: 'Ask about lessons', href: c('det', 'det-offer-lessons') },
    { h: 'Book your test through us', p: 'Buy your test with our invite code. We\'ll see your official results and skill scores, so your preparation targets exactly what you need – using Duolingo\'s exclusive partner materials.', price: 'Official DET partner', cta: 'Register with this link', href: det.inviteUrl, ext: true },
  ],

  trainerEyebrow: 'Your trainer',
  trainerCreds: `${det.trainerTitle.en} · Trained speaking examiner (British Council ESAT-J) · CELTA-qualified`,
  trainerP: 'Lenny is a native English speaker from Ireland with over ten years\' experience preparing students for exams, including IELTS and Cambridge C1 Advanced. As a trained speaking examiner, he knows what assessors listen for – and how to help nervous speakers show what they can really do.',
  photoAlt: 'Cathal (Lenny) Leonard, Duolingo English Test trainer at Immersion English',

  faqEyebrow: 'Questions', faqH2a: 'Duolingo English Test: ', faqH2b: 'your questions answered',
  faqs: [
    { q: 'Which universities accept the Duolingo English Test?', a: `More than ${det.institutions} institutions worldwide. In Ireland, nearly every university accepts it, and there\'s no visa to worry about. In the UK, more than ${det.ukUniversities} universities accept it for degree courses, but for a foundation or pre-sessional course you\'ll need a UKVI-approved test such as IELTS for UKVI. In the US and Canada it\'s widely accepted, including by all eight Ivy League universities. For the Netherlands, talk to us first – several of the big Dutch universities don\'t accept it yet. Always check your programme\'s own admissions page.` },
    { q: 'Can you trust a test taken at home?', a: 'Yes. The whole session is recorded through your computer, phone camera, microphone, keyboard and mouse. Trained proctors, helped by AI, review every test in several independent rounds before the result is released. Questions come from a vast bank, and the test cancels itself if you try to open another app.' },
    { q: 'What do I need to take it?', a: 'A Windows or Mac computer with a camera, microphone and speakers, the free Duolingo English Test desktop app, a smartphone (it acts as a second camera, recording your screen and keyboard), a quiet room to yourself and your ID.', link: { href: det.appDownloadUrl, label: 'Download the app' } },
    { q: 'Is there an examiner for the speaking part?', a: 'No. You see or hear a prompt on screen, take a moment to think, and answer – just you and a camera. Speaking is still scored as a skill in its own right, and universities can watch your video. But without an examiner across the table, there\'s far less pressure.' },
    { q: 'How is it scored?', a: `You get an overall score from ${det.scoreMin} to ${det.scoreMax}, in 5-point steps, plus separate scores for reading, writing, listening and speaking.` },
    { q: 'How long are the results valid?', a: `${det.validityYears} years.` },
    { q: 'How much does it cost?', a: `US$${det.priceUsd} (about €${det.priceEurApprox}), the same price everywhere. Results arrive within ${det.resultsDays} days, and sending them to universities is free.` },
    { q: 'Do I have to take it straight after buying it?', a: `No. You have ${det.daysToTakeAfterPurchase} days to take it.` },
  ],

  endH2: 'Not sure which test is right for you?',
  endP: 'Book a free consultation and we\'ll help you choose – no commitment.',
  endFb: `Practice test feedback – €${fb}`,
};

// Service + Offer for the feedback product, so the price can show in search.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: services.detFeedback.name,
  description: services.detFeedback.summary,
  serviceType: 'Duolingo English Test preparation',
  provider: { '@type': 'EducationalOrganization', name: 'Immersion English', url: 'https://immersion-english.com/' },
  areaServed: 'BG',
  offers: { '@type': 'Offer', price: String(services.detFeedback.price), priceCurrency: 'EUR' },
};

// FAQPage structured data for this page, from the same answers shown below.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: t.faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<!-- HERO -->
<section class="relative flex items-center text-white overflow-hidden isolate">
  <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, var(--hero-top) 0%, #14201a 60%, #0a3f25 100%);"></div>
  <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
    <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <!-- The test's name sits INSIDE the h1 (styled as the usual eyebrow) so the
             page's main heading carries the phrase people search for. -->
        <h1 class="text-white mb-5">
          <span class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6" style="line-height: 1.4;">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
            {t.eyebrow}
          </span>
          <span class="block" style="max-width: 18ch;">{t.h1a}<span style="color: var(--orange);">{t.h1b}</span>{t.h1c}</span>
        </h1>
        <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55] mb-8 max-w-[52ch]">{t.lead}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={c('det', 'det-hero')} class="btn btn-primary">{t.ctaMain}</a>
          <a href={det.inviteUrl} target="_blank" rel="noopener" class="btn btn-ghost text-white border-white/30 hover:border-white">{t.ctaFb}</a>
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 md:p-8 shadow-lift">
        <img src="/det-gpn-member.svg" alt={t.badgeAlt} width="1848" height="881" class="w-full h-auto block" style="min-width: 220px;" loading="eager" />
        <p class="text-ink-soft text-[0.85rem] mt-4 text-center">{t.badgeCaption}</p>
      </div>
