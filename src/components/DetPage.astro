const quotes = [
  { quote: "Lenny is the most motivational English teacher I've ever met! His way of teaching involves so many kinds of innovative methods that you'll be studying in an atmosphere of fun, professionalism and individual attention on your own needs. I strongly recommend!", name: 'Natalya Baleva' },
  { quote: "Lenny is a great teacher and he helped me to learn and start using English as I wanted. I like his style of teaching – he involves grammar, vocabulary and exercises while we are chatting, reading and discussing daily topics. Highly recommend!", name: 'Dobromira Kozhuharova' },
];

// Service + Offer for the feedback product, so the price can show in search.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: services.detFeedback.name,
  description: services.detFeedback.summary,
  serviceType: 'Duolingo English Test preparation',
  provider: { '@type': 'EducationalOrganization', name: 'Immersion English', url: 'https://immersion-english.com/' },
  areaServed: 'BG',
  offers: { '@type': 'Offer', price: String(services.detFeedback.price), priceCurrency: 'EUR' },
};

// FAQPage structured data for this page, from the same answers shown below.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: t.faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<!-- HERO -->
<section class="relative flex items-center text-white overflow-hidden isolate">
  <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, var(--hero-top) 0%, #14201a 60%, #0a3f25 100%);"></div>
  <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
    <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <!-- The test's name sits INSIDE the h1 (styled as the usual eyebrow) so the
             page's main heading carries the phrase people search for. -->
        <h1 class="text-white mb-5">
          <span class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6" style="line-height: 1.4;">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
            {t.eyebrow}
          </span>
          <span class="block" style="max-width: 18ch;">{t.h1a}<span style="color: var(--orange);">{t.h1b}</span>{t.h1c}</span>
        </h1>
        <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55] mb-8 max-w-[52ch]">{t.lead}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={c('det', 'det-hero')} class="btn btn-primary">{t.ctaMain}</a>
          <a href={c('det-feedback', 'det-hero')} class="btn btn-ghost text-white border-white/30 hover:border-white">{t.ctaFb}</a>
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 md:p-8 shadow-lift">
        <img src="/det-gpn-member.svg" alt={t.badgeAlt} width="1848" height="881" class="w-full h-auto block" style="min-width: 220px;" loading="eager" />
        <p class="text-ink-soft text-[0.85rem] mt-4 text-center">{t.badgeCaption}</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT IS IT -->
<section class="section">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.whatEyebrow}</span>
      <h2>{t.whatH2a}<span style="color: var(--orange-text);">{t.whatH2b}</span></h2>
      <p>{t.whoLine}</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {t.stats.map(s => (
        <div class="bg-white border border-line rounded-xl p-5 shadow-soft">
          <p class="font-heading font-bold text-[1.6rem] text-ink leading-none mb-2">{s.n}</p>
          <p class="text-[0.88rem] text-ink-soft leading-snug">{s.l}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TEST FORMAT -->
<section class="section section-tinted" id="format" style="scroll-margin-top: 90px;">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.fmtEyebrow}</span>
      <h2>{t.fmtH2a}<span style="color: var(--orange-text);">{t.fmtH2b}</span></h2>
      <p>{t.fmtIntro}</p>
    </div>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10 list-none p-0">
      {t.parts.map((part, i) => (
        <li class="bg-white border border-line rounded-xl p-6 shadow-soft">
          <p class="font-heading font-semibold text-[0.78rem] uppercase tracking-[0.1em] mb-2" style="color: var(--green);">{i + 1} · {part.n}</p>
          <h3 class="text-[1.1rem] mb-2">{part.h}</h3>
          <p class="text-ink-soft text-[0.93rem] leading-relaxed">{part.p}</p>
        </li>
      ))}
    </ol>
    <h3 class="text-[1.2rem] mb-2">{t.qH3}</h3>
    <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
    <ul class="flex flex-col gap-3 max-w-[78ch]">
      {t.skills.map(k => (
        <li class="flex items-start gap-3 text-ink-soft leading-relaxed">
          <span class="w-[8px] h-[8px] rounded-full flex-shrink-0 mt-[9px]" style="background: var(--orange);"></span>
          <span><strong style="color: var(--ink);">{k.k}</strong> – <span lang="en">{k.v}</span></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- SCORES -->
<section class="section" id="scores" style="scroll-margin-top: 90px;">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.scoreEyebrow}</span>
      <h2>{t.scoreH2a}<span style="color: var(--orange-text);">{t.scoreH2b}</span></h2>
      <p>{t.scoreIntro}</p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-line shadow-soft bg-white max-w-[760px]">
      <table class="w-full text-left text-[0.92rem]">
        <thead>
          <tr style="background: var(--green);">
            {t.scoreHead.map(h => <th scope="col" class="font-heading font-semibold text-white px-4 py-3">{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {det.cefrBands.map((b, i) => (
            <tr class="border-t border-line align-top">
              <th scope="row" class="font-heading font-semibold text-ink px-4 py-3 whitespace-nowrap">{b.range}</th>
              <td class="px-4 py-3 text-ink font-semibold">{b.cefr}</td>
              <td class="px-4 py-3 text-ink-soft">{t.scoreDesc[i]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <a href={det.scoresUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-5 text-[0.92rem] font-heading font-semibold no-underline hover:underline" style="color: var(--green);">{t.scoreLink}</a>
  </div>
</section>

<!-- IS IT RIGHT FOR YOU -->
<section class="section section-tinted">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.fitEyebrow}</span>
      <h2>{t.fitH2a}<span style="color: var(--orange-text);">{t.fitH2b}</span></h2>
    </div>
    <ul class="flex flex-col gap-4 max-w-[72ch]">
      {t.fit.map(f => (
        <li class="flex items-start gap-3 text-ink-soft leading-relaxed">
          <span class="w-[8px] h-[8px] rounded-full flex-shrink-0 mt-[9px]" style="background: var(--orange);"></span>
          <span><strong style="color: var(--ink);">{f.k}</strong> – {f.v}</span>
        </li>
      ))}
    </ul>
    <p class="text-ink-soft text-[0.92rem] mt-6 max-w-[72ch]">{t.fitNote}</p>
  </div>
</section>

<!-- COMPARISON -->
<section class="section">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.cmpEyebrow}</span>
      <h2>{t.cmpH2a}<span style="color: var(--orange-text);">{t.cmpH2b}</span></h2>
    </div>
    <div class="overflow-x-auto rounded-xl border border-line shadow-soft bg-white">
      <table class="w-full text-left text-[0.92rem] min-w-[680px]">
        <thead>
          <tr style="background: var(--green);">
            {t.cmpHead.map((h, i) => <th scope="col" class={`font-heading font-semibold text-white px-4 py-3 ${i === 0 ? 'w-[18%]' : ''}`}>{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {t.cmpRows.map(row => (
            <tr class="border-t border-line align-top">
              <th scope="row" class="font-heading font-semibold text-ink px-4 py-3">{row[0]}</th>
              <td class="px-4 py-3 text-ink font-semibold" style="background: var(--green-soft);">{row[1]}</td>
              <td class="px-4 py-3 text-ink-soft">{row[2]}</td>
              <td class="px-4 py-3 text-ink-soft">{row[3]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- HOW WE CAN HELP -->
<section class="section section-tinted" id="offer" style="scroll-margin-top: 90px;">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.helpEyebrow}</span>
      <h2>{t.helpH2a}<span style="color: var(--orange-text);">{t.helpH2b}</span></h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {t.offers.map(o => (
        <div class="bg-white border border-line rounded-xl p-6 flex flex-col shadow-soft">
          <h3 class="text-[1.1rem] mb-2">{o.h}</h3>
          <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 14px;"></div>
          <p class="text-ink-soft text-[0.93rem] leading-relaxed mb-5 flex-1">{o.p}</p>
          <div class="pt-4 border-t border-line">
            <p class="font-heading font-bold text-ink text-[1.15rem]">{o.price}</p>
            <a href={o.href} class="btn btn-ghost mt-3 text-[0.86rem] py-[9px] px-4">{o.cta}</a>
          </div>
        </div>
      ))}
    </div>
    <h3 class="text-[1.2rem] mt-12 mb-2">{t.stepsH3}</h3>
    <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 18px;"></div>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none p-0">
      {t.steps.map((st, i) => (
        <li class="flex items-start gap-4">
          <span class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-heading font-bold text-white text-[0.95rem]" style="background: var(--green);">{i + 1}</span>
          <span><strong class="font-heading block text-ink mb-1">{st.h}</strong><span class="text-ink-soft text-[0.93rem] leading-relaxed">{st.p}</span></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- TRAINER -->
<section class="section">
  <div class="container-x">
    <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 md:gap-14 items-center">
      <div class="rounded-lg overflow-hidden shadow-lift" style="border: 1px solid var(--line);">
        <img src="/team-lenny.webp" alt={t.photoAlt} class="img-greyscale w-full object-cover" style="aspect-ratio: 3/4; object-position: center top; display: block;" loading="eager" />
      </div>
      <div>
        <span class="eyebrow eyebrow-dot">{t.trainerEyebrow}</span>
        <p class="font-heading font-bold text-[1.5rem] text-ink mt-3 mb-1">Cathal (Lenny) Leonard</p>
        <p class="text-[0.9rem] font-semibold mb-5" style="color: var(--green);">{t.trainerCreds}</p>
        <div style="width: 40px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 20px;"></div>
        <p class="text-ink-soft text-[1.02rem] leading-relaxed max-w-[62ch]">{t.trainerP}</p>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="section section-tinted">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.quotesEyebrow}</span>
      <h2>{t.quotesH2a}<span style="color: var(--orange-text);">{t.quotesH2b}</span></h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {quotes.map(q => (
        <figure class="bg-white border border-line rounded-xl p-6 shadow-soft m-0">
          <blockquote class="text-ink-soft leading-relaxed m-0" lang="en">“{q.quote}”</blockquote>
          <figcaption class="font-heading font-semibold text-ink text-[0.9rem] mt-4">{q.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- FAQS -->
<section class="section">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.faqEyebrow}</span>
      <h2>{t.faqH2a}<span style="color: var(--orange-text);">{t.faqH2b}</span></h2>
    </div>
    <div class="flex flex-col max-w-[820px] bg-white border border-line rounded-xl px-6 shadow-soft">
      {t.faqs.map(({ q, a, link }) => (
        <div class="faq-item border-b border-line last:border-0">
          <button class="faq-trigger w-full flex items-center justify-between gap-4 py-5 text-left bg-transparent border-0 cursor-pointer" aria-expanded="false">
            <span class="font-heading font-semibold text-[1rem] text-ink leading-snug">{q}</span>
            <span class="faq-icon flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center transition-colors duration-200" style="background: var(--cream);">
              <svg class="faq-chevron w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </button>
          <div class="faq-body" style="display:none;">
            <div class="pb-5 pr-2 md:pr-10">
              <p class="text-ink-soft text-[0.97rem] leading-relaxed max-w-[66ch]">{a}</p>
              {link && (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-block mt-3 text-[0.92rem] font-heading font-semibold no-underline hover:underline" style="color: var(--green);">{link.label}</a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section-dark">
  <div class="container-x text-center">
    <h2 class="mb-5">{t.endH2}</h2>
    <p class="max-w-[46ch] mx-auto mb-8">{t.endP}</p>
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center flex-wrap">
      <a href={c('det', 'det-bottom')} class="btn btn-primary">{t.ctaMain}</a>
      <a href={c('det-feedback', 'det-bottom')} class="btn btn-ghost text-white border-white/30 hover:border-white">{t.endFb}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = item.querySelector('.faq-body') as HTMLElement;
      const icon = trigger.querySelector('.faq-icon') as HTMLElement;
      const chevron = trigger.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      body.style.display = isOpen ? 'none' : 'block';
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      icon.style.background = isOpen ? 'var(--cream)' : 'var(--green-soft)';
      chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    });
  });
</script>
