  cmpEyebrow: 'At a glance', cmpH2a: 'How does the Duolingo English Test compare ', cmpH2b: 'to other tests?',
  cmpHead: ['', 'Duolingo|English Test', 'IELTS|Academic', 'Cambridge|C1 Advanced'],
  cmpRows: [
    ['Price', `about €${det.priceEurApprox}, the same everywhere`, `€${otherTests.ieltsAcademicEur}`, `€${otherTests.cambridgeC1Eur}`],
    ['Length', 'about 1 hour', 'about 2 hours 45 minutes', 'about 4 hours'],
    ['Where and when', 'at home, any time', 'at a test centre, or online from home, on booked dates', 'at an exam centre, on set dates'],
    ['Results', `within ${det.resultsDays} days`, '1–5 days (computer), 6–8 days (online), about 13 days (paper)', '1–3 weeks (computer), 4–6 weeks (paper)'],
    ['Scoring', `${det.scoreMin}–${det.scoreMax} overall, plus a score for reading, writing, listening and speaking`, 'bands 0–9 overall, plus a band for each skill', 'Cambridge English Scale 160–210, a grade (A, B or C) and a score for each skill'],
    ['Sending your score', 'free, to as many universities as you like', '5 free copies, then a fee per extra copy', 'free online verification for universities'],
  ],

  helpEyebrow: 'How we can help', helpH2a: 'Prepare with ', helpH2b: 'a DET partner and certified trainer',
  offers: [
    { h: 'Choose the right test', p: 'Not sure which test fits your plans? In a free consultation we\'ll tell you honestly – DET, IELTS or Cambridge.', price: 'Free', cta: 'Book a consultation', href: c('det', 'det-offer-consultation') },
    { h: 'Prepare 1:1', p: 'Online lessons built around the DET\'s question types and timing, using Duolingo\'s exclusive partner materials. Includes feedback on your speaking and writing from a trained speaking examiner.', price: `€${prep.perLesson} / ${prep.lessonMinutes} min`, cta: 'Ask about lessons', href: c('det', 'det-offer-lessons') },
    { h: 'Book through us', p: 'Register with our link and we can see your official results and skill scores – so we know exactly what to work on next. It costs you nothing extra.', copy: det.inviteUrl, copyLabel: 'Copy and share our link', copyBtn: 'Copy', copied: 'Copied', cta: 'Register with this link', href: det.inviteUrl, ext: true },
  ],

  trainerEyebrow: 'Your trainer',
  trainerCreds: `${det.trainerTitle.en} · Trained speaking examiner (British Council ESAT-J) · CELTA-qualified`,
  trainerP: 'Lenny is a native English speaker from Ireland with over ten years\' experience preparing students for exams, including IELTS and Cambridge C1 Advanced. As a trained speaking examiner, he knows what assessors listen for – and how to help nervous speakers show what they can really do.',
  photoAlt: 'Cathal (Lenny) Leonard, Duolingo English Test trainer at Immersion English',

  faqEyebrow: 'Questions', faqH2a: 'Duolingo English Test: ', faqH2b: 'your questions answered',
  faqs: [
    { q: 'Which universities accept the Duolingo English Test?', a: `More than ${det.institutions.replace('+', '')} institutions worldwide. In Ireland, nearly every university accepts it, and there\'s no visa to worry about. In the UK, more than ${det.ukUniversities} universities accept it for degree courses, but for a foundation or pre-sessional course you\'ll need a UKVI-approved test such as IELTS for UKVI. In the US and Canada it\'s widely accepted, including by all eight Ivy League universities. For the Netherlands, talk to us first – several of the big Dutch universities don\'t accept it yet. Always check your programme\'s own admissions page.` },
    { q: 'Can you trust a test taken at home?', a: 'Yes. The whole session is recorded through your computer, phone camera, microphone, keyboard and mouse. Trained proctors, helped by AI, review every session in several independent rounds before the result is released. Questions come from a vast bank, and the DET is cancelled automatically if you try to open another app.' },
    { q: 'What do I need to take it?', a: 'A Windows or Mac computer with a camera, microphone and speakers, the free Duolingo English Test desktop app, a smartphone (it acts as a second camera, recording your screen and keyboard), a quiet room to yourself and your ID.', link: { href: det.appDownloadUrl, label: 'Download the app' } },
    { q: 'Is there an examiner for the speaking part?', a: 'No. You see or hear a prompt on screen, take a moment to think, and answer – just you and a camera. Speaking is still scored as a skill in its own right, and universities can watch your video. But without an examiner across the table, there\'s far less pressure.' },
    { q: 'How is it scored?', a: `You get an overall score from ${det.scoreMin} to ${det.scoreMax}, in 5-point steps, plus separate scores for reading, writing, listening and speaking.` },
    { q: 'How long are the results valid?', a: `${det.validityYears} years.` },
    { q: 'How much does it cost?', a: `US$${det.priceUsd} (about €${det.priceEurApprox}), the same price everywhere. Results arrive within ${det.resultsDays} days, and sending them to universities is free.` },
    { q: 'Do I have to take it straight after buying it?', a: `No. You have ${det.daysToTakeAfterPurchase} days to take it.` },
  ],

  endH2: 'Not sure which test is right for you?',
  endP: 'Book a free consultation and we\'ll help you choose – no commitment.',
};

// FAQPage structured data for this page, from the same answers shown below.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: t.faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};

// Subscores. Duolingo report four skill scores (which average to the overall
// score) and four combined scores (each the average of two skills).
// Icons are our own line icons in brand green, not Duolingo's artwork.
const icon: Record<string, string> = {
  speaking: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 10.5a6.5 6.5 0 0 0 13 0M12 17v4M8.5 21h7"/>',
  writing: '<path d="M16.5 3.5l4 4L8 20H4v-4L16.5 3.5z"/><path d="M13.5 6.5l4 4"/>',
  reading: '<path d="M2.5 4.5h6a3.5 3.5 0 0 1 3.5 3.5v12a3 3 0 0 0-3-3H2.5z"/><path d="M21.5 4.5h-6A3.5 3.5 0 0 0 12 8v12a3 3 0 0 1 3-3h6.5z"/>',
  listening: '<path d="M11 5L6.5 9H3v6h3.5l4.5 4V5z"/><path d="M15.5 9a4.5 4.5 0 0 1 0 6M18.5 6a8.5 8.5 0 0 1 0 12"/>',
};
const skillKeys = ['speaking', 'writing', 'reading', 'listening'] as const;
const comboParts = {
  production: ['writing', 'speaking'],
  literacy: ['reading', 'writing'],
  comprehension: ['reading', 'listening'],
  conversation: ['speaking', 'listening'],
} as const;
const comboKeys = Object.keys(comboParts) as (keyof typeof comboParts)[];

// Sample report: made-up but internally consistent figures. The four skills
// average to the overall score, and each combined score is the average of its
// two skills. 120 sits in the 120–125 row of the concordance (IELTS 6.5, B2).
const sample = { speaking: 135, writing: 115, reading: 125, listening: 105 };
const sampleOverall = (sample.speaking + sample.writing + sample.reading + sample.listening) / 4;
const comboScore = (k: keyof typeof comboParts) => (sample[comboParts[k][0]] + sample[comboParts[k][1]]) / 2;
const barPct = (v: number) => `${((v - det.scoreMin) / (det.scoreMax - det.scoreMin)) * 100}%`;
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- HERO -->
<section class="relative flex items-center text-white overflow-hidden isolate">
  <div class="absolute inset-0 -z-[2]" style="background: linear-gradient(135deg, var(--hero-top) 0%, #14201a 60%, #0a3f25 100%);"></div>
  <div class="container-x relative z-10 pt-[100px] md:pt-[120px] pb-[60px] md:pb-[80px]">
    <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <!-- The test's name sits INSIDE the h1 (styled as the usual eyebrow) so the
             page's main heading carries the phrase people search for. -->
        <h1 class="text-white mb-5">
          <span class="flex items-center gap-2 font-heading font-semibold text-[0.82rem] tracking-wide text-white/80 mb-6" style="line-height: 1.4;">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--orange);"></span>
            {t.eyebrow}
          </span>
          <span class="block" style="max-width: 18ch;">{t.h1a}<span style="color: var(--orange);">{t.h1b}</span>{t.h1c}</span>
        </h1>
        <p class="text-white/80 text-[1rem] md:text-[1.15rem] leading-[1.55] mb-8 max-w-[52ch]">{t.lead}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={c('det', 'det-hero')} class="btn btn-primary">{t.ctaMain}</a>
          <a href={det.inviteUrl} target="_blank" rel="noopener" class="btn btn-ghost text-white border-white/30 hover:border-white">{t.ctaFb}</a>
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 md:p-8 shadow-lift">
        <img src="/det-gpn-member.svg" alt={t.badgeAlt} width="1848" height="881" class="w-full h-auto block" style="min-width: 220px;" loading="eager" />
        <p class="text-ink-soft text-[0.85rem] mt-4 text-center">{t.badgeCaption}</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT IS IT -->
<section class="section">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.whatEyebrow}</span>
      <h2>{t.whatH2a}<span style="color: var(--orange-text);">{t.whatH2b}</span></h2>
      <p>{t.whoLine}</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {t.stats.map(s => (
        <div class="bg-white border border-line rounded-xl p-4 sm:p-5 shadow-soft">
          <p class="text-[0.7rem] font-heading font-semibold uppercase tracking-[0.1em] mb-2" style="color: var(--orange-text);">{s.u}</p>
          <p class="font-heading font-bold text-[1.05rem] sm:text-[1.45rem] text-ink leading-tight mb-2 [overflow-wrap:break-word]">{s.n}</p>
          <p class="text-[0.88rem] text-ink-soft leading-snug">{s.l}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TEST FORMAT -->
<section class="section section-tinted" id="format" style="scroll-margin-top: 90px;">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.fmtEyebrow}</span>
      <h2>{t.fmtH2a}<span style="color: var(--orange-text);">{t.fmtH2b}</span></h2>
      <p>{t.fmtIntro}</p>
    </div>
    <!-- The three parts, drawn to scale (5 / 45 / 10 minutes) -->
    <div class="flex rounded-full overflow-hidden h-3 mb-3" aria-hidden="true" style={`--a:${det.format.setupMin};--b:${det.format.adaptiveMin};--c:${det.format.samplesMin}`}>
      <span style="flex: var(--a); background: var(--ink-soft); opacity: 0.35;"></span>
      <span style="flex: var(--b); background: var(--green);"></span>
      <span style="flex: var(--c); background: var(--orange);"></span>
    </div>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12 list-none p-0">
      {t.parts.map((part, i) => (
        <li class="bg-white border border-line rounded-xl p-6 shadow-soft flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-9 h-9 rounded-full flex items-center justify-center font-heading font-bold text-[0.95rem] flex-shrink-0" style={i === 0 ? 'background: var(--line); color: var(--ink);' : i === 1 ? 'background: var(--green); color: #fff;' : 'background: var(--orange); color: var(--ink);'}>{i + 1}</span>
            <p class="font-heading font-semibold text-[0.78rem] uppercase tracking-[0.1em] m-0" style="color: var(--green);">{part.n}</p>
          </div>
          <h3 class="text-[1.15rem] mb-3">{part.h}</h3>
          <ul class="flex flex-col gap-2 mb-4 list-none p-0">
            {part.pts.map(pt => (
              <li class="flex items-start gap-3 text-ink-soft text-[0.92rem] leading-relaxed">
                <span class="w-[7px] h-[7px] rounded-full flex-shrink-0 mt-[8px]" style="background: var(--orange);"></span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
          <p class="mt-auto text-[0.8rem] font-heading font-semibold pt-3 border-t border-line m-0" style={i === 0 ? 'color: var(--ink-soft);' : 'color: var(--green);'}>{part.note}</p>
        </li>
      ))}
    </ol>

    <h3 class="text-[1.2rem] mb-2">{t.qH3}</h3>
    <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 10px;"></div>
    <p class="text-ink-soft text-[0.95rem] mb-5">{t.qIntro} <span class="whitespace-nowrap"><span class="inline-block w-[8px] h-[8px] rounded-full align-middle mr-1" style="background: var(--green);"></span>{t.adaptiveTag}</span> – {t.adaptiveKey}.</p>
    <ul class="grid md:grid-cols-2 gap-4 mb-12 list-none p-0">
      {(['reading', 'listening', 'writing', 'speaking'] as const).map(k => (
        <li class="bg-white border border-line rounded-xl p-5 shadow-soft">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background: var(--green-soft); color: var(--green);">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon[k]} />
            </span>
            <h4 class="font-heading font-semibold text-ink text-[1.02rem] m-0">{t.skillNames[k]}</h4>
          </div>
          <div class="flex justify-between gap-3 pb-2 text-[0.7rem] font-heading font-semibold uppercase tracking-[0.08em] text-ink-mute" aria-hidden="true"><span>{t.qColType}</span><span>{t.qColCount}</span></div>
          <ul class="flex flex-col list-none p-0 m-0">
            {det.questionTypes[k].map(q => (
              <li class="flex items-start justify-between gap-3 py-[7px] border-t border-line text-[0.9rem]">
                <span class="text-ink flex items-start gap-2"><span class="w-[8px] h-[8px] rounded-full flex-shrink-0 mt-[7px]" style={det.adaptiveTypes.includes(q) ? 'background: var(--green);' : 'background: transparent; border: 1.5px solid var(--line);'} title={det.adaptiveTypes.includes(q) ? t.adaptiveTag : undefined}></span><span lang="en">{q}</span></span>
                <span class="text-ink-soft text-[0.85rem] text-right max-w-[48%] leading-snug pt-[1px]">{det.questionCounts[q]?.[lang]}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <h3 class="text-[1.2rem] mb-2">{t.tipsH3}</h3>
    <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 18px;"></div>
    <ul class="grid md:grid-cols-3 gap-5 list-none p-0">
      {t.tips.map(tip => (
        <li class="flex items-start gap-3">
          <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 mt-[2px]" style="background: var(--green-soft); color: var(--green);">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          </span>
          <span>
            <strong class="block font-heading font-semibold text-ink text-[0.98rem] mb-1">{tip.h}</strong>
            <span class="text-ink-soft text-[0.92rem] leading-relaxed">{tip.p}</span>
          </span>
        </li>
      ))}
    </ul>

    <!-- Duolingo's own PDFs from the partner pack, hosted unaltered in /public/downloads. -->
    <h3 id="downloads" class="text-[1.2rem] mb-2 mt-14" style="scroll-margin-top: 90px;">{t.dlH3}</h3>
    <div style="width: 32px; height: 3px; border-radius: 2px; background: var(--orange); margin-bottom: 18px;"></div>
    <ul class="grid md:grid-cols-2 gap-4 max-w-[900px]">
      {t.dl.map(d => (
        <li class="bg-white border border-line rounded-xl p-5 shadow-soft flex gap-4 items-start">
          <span class="w-12 h-12 rounded-lg flex-shrink-0 flex items-center justify-center" style="background: var(--green-soft); color: var(--green);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11v6M9.5 14.5L12 17l2.5-2.5"/></svg>
          </span>
          <div class="flex-1 min-w-0">
            <h4 class="font-heading font-semibold text-ink text-[1rem] mb-1">{d.h}</h4>
            <p class="text-ink-soft text-[0.9rem] leading-relaxed mb-3">{d.p}</p>
            <a href={d.href} download data-dl={d.href.split('/').pop()} class="det-download inline-flex items-center gap-2 font-heading font-semibold text-[0.9rem] no-underline" style="color: var(--green);">{t.dlBtn}<span class="font-body font-normal text-ink-soft text-[0.8rem]">· {d.size}</span></a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- COMPARISON -->
<section class="section" id="compare" style="scroll-margin-top: 90px;">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.cmpEyebrow}</span>
      <h2>{t.cmpH2a}<span style="color: var(--orange-text);">{t.cmpH2b}</span></h2>
    </div>
    <div class="overflow-x-auto rounded-xl border border-line shadow-soft bg-white">
      <table class="w-full text-left text-[0.92rem] min-w-[680px]">
        <thead>
          <tr style="background: var(--green);">
            {t.cmpHead.map((h, i) => <th scope="col" class={`font-heading font-semibold text-white px-4 py-3 ${i === 0 ? 'w-[18%] sticky left-0 z-10' : ''}`} style={i === 0 ? 'background: var(--green);' : ''}>{h.split('|').map((l, k) => <>{k > 0 && <br />}<span class="whitespace-nowrap">{l}</span></>)}</th>)}
          </tr>
        </thead>
        <tbody>
          {t.cmpRows.map(row => (
            <tr class="border-t border-line align-top">
              <!-- First column stays put when the table is scrolled sideways on mobile. -->
              <th scope="row" class="font-heading font-semibold text-ink px-4 py-3 sticky left-0 z-10 bg-white" style="box-shadow: 1px 0 0 var(--line);">{row[0]}</th>
              <td class="px-4 py-3 text-ink font-semibold" style="background: var(--green-soft);">{row[1]}</td>
              <td class="px-4 py-3 text-ink-soft">{row[2]}</td>
              <td class="px-4 py-3 text-ink-soft">{row[3]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- SCORES -->
<section class="section section-tinted" id="scores" style="scroll-margin-top: 90px;">
  <div class="container-x">
    <div class="section-head">
      <span class="eyebrow eyebrow-dot">{t.scoreEyebrow}</span>
      <h2>{t.scoreH2a}<span style="color: var(--orange-text);">{t.scoreH2b}</span></h2>
      <p>{t.scoreIntro}</p>
    </div>
    <div class="flex items-center gap-10">
    <div class="flex-1 overflow-x-auto rounded-xl border border-line shadow-soft bg-white max-w-[620px]">
      <table class="w-full text-left text-[0.92rem]">
        <thead>
          <tr style="background: var(--green);">
            {t.scoreHead.map(h => <th scope="col" class="font-heading font-semibold text-white px-4 py-3">{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {det.concordance.map(r => (
            <tr class="border-t border-line" style={r.typical ? 'background: var(--green-soft);' : ''}>
              <th scope="row" class="font-heading font-semibold text-ink px-4 py-[9px] whitespace-nowrap">{r.det}</th>
              <td class="px-4 py-[9px] text-ink">{r.ielts}</td>
              <td class="px-4 py-[9px] text-ink-soft">{r.cefr}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <!-- Duolingo's own "Duo graduate" animation, from the partner brand pack.
         Decorative, so empty alt. Desktop only, to keep the mobile page light. -->
    <img src="/duo-graduate.webp" alt="" width="260" height="260" class="hidden lg:block flex-shrink-0" loading="lazy" />
    </div>
    <p class="flex items-center gap-2 text-[0.85rem] text-ink-soft mt-4"><span class="inline-block w-4 h-4 rounded" style="background: var(--green-soft); border: 1px solid var(--line);"></span>{t.scoreKey}</p>

    <!-- Subscores (left) and a sample score report (right) -->
    <div class="grid lg:grid-cols-2 gap-10 mt-14 items-start">
      <div>
        <h3 class="text-[1.35rem] mb-2">{t.subH}</h3>
        <p class="text-ink-soft text-[0.95rem] mb-4">{t.subIndiv}</p>
        <ul class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-3 mb-8">
          {skillKeys.map(k => (
            <li class="bg-white border border-line rounded-xl shadow-soft px-3 py-5 flex flex-col items-center gap-3 text-center">
              <span class="w-12 h-12 rounded-full flex items-center justify-center" style="background: var(--green-soft); color: var(--green);">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon[k]} />
              </span>
              <span class="font-heading font-semibold text-[0.9rem] text-ink">{t.skillNames[k]}</span>
            </li>
          ))}
        </ul>
        <p class="text-ink-soft text-[0.95rem] mb-4">{t.subInteg}</p>
        <ul class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-3">
          {comboKeys.map(k => (
            <li class="bg-white border border-line rounded-xl shadow-soft px-3 py-5 flex flex-col items-center gap-3 text-center">
              <span class="flex items-center gap-1" style="color: var(--green);">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon[comboParts[k][0]]} />
                <span class="text-[0.9rem] font-semibold" style="color: var(--orange-text);" aria-hidden="true">+</span>
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon[comboParts[k][1]]} />
              </span>
              <span class="font-heading font-semibold text-[0.85rem] text-ink leading-snug">{t.combos[k]}</span>
              <span class="sr-only">{t.skillNames[comboParts[k][0]]} + {t.skillNames[comboParts[k][1]]}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sample report: Duolingo's own sample certificate (fictional test taker), shown unaltered. -->
      <figure class="m-0">
