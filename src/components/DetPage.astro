<script>
  // Count guide downloads in GA4 as 'det_guide_download', with the file name and page language.
  document.querySelectorAll<HTMLAnchorElement>('.det-download').forEach(link => {
    link.addEventListener('click', () => {
      (window as any).gtag?.('event', 'det_guide_download', { file_name: link.dataset.dl, page_language: document.documentElement.lang });
    });
  });
  // Copy the DET invite link (offer card "Book through us").
  document.querySelectorAll<HTMLButtonElement>('.copy-invite').forEach(btn => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copy || '';
      try { await navigator.clipboard.writeText(url); }
      catch { const el = btn.parentElement?.querySelector('.invite-url'); if (el) { const r = document.createRange(); r.selectNodeContents(el); const sel = getSelection(); sel?.removeAllRanges(); sel?.addRange(r); } }
      btn.textContent = btn.dataset.done || 'Copied';
      (window as any).gtag?.('event', 'det_invite_copy');
      setTimeout(() => { btn.textContent = label; }, 2000);
    });
  });
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = item.querySelector('.faq-body') as HTMLElement;
      const icon = trigger.querySelector('.faq-icon') as HTMLElement;
      const chevron = trigger.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      body.style.display = isOpen ? 'none' : 'block';
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      icon.style.background = isOpen ? 'var(--cream)' : 'var(--green-soft)';
      chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    });
  });
</script>
