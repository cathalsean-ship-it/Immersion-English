  ctaMain: 'Безплатна консултация', ctaFb: 'Вземете теста',
  badgeAlt: 'Duolingo English Test – Global Partner Network – Member',
  badgeCaption: 'Член на глобалната партньорска мрежа на Duolingo English Test',

  whatEyebrow: 'DET', whatH2a: 'Какво е ', whatH2b: 'Duolingo English Test?',
  whoLine: 'Модерен изпит по английски, положен от вкъщи, за ученици в последните класове и за всеки, който кандидатства в университет в чужбина.',
  fmtEyebrow: 'Формат на DET', fmtH2a: 'Как протича DET: ', fmtH2b: 'един час, три части',
  fmtIntro: 'И четирите умения – четене, слушане, писане и говорене – наведнъж, за около час, от вкъщи на собствения ви компютър.',
  minLabel: 'мин',
  parts: [
    { n: `около ${det.format.setupMin} минути`, h: 'Подготовка', note: 'Не се оценява', pts: ['Изтегляте приложението на DET за телефон и проверявате камерата, микрофона и високоговорителите', 'Показвате документ за самоличност със снимка и минавате кратка проверка на лицето', 'Сканирате стаята с телефона и го нагласяте като втора камера'] },
    { n: `около ${det.format.adaptiveMin} минути`, h: 'Адаптивният тест', note: 'Оценява се', pts: ['Кратки задачи и по четирите умения', 'Стават по-трудни или по-лесни според отговорите ви', 'Броят на въпросите е различен – тази част приключва, когато DET е сигурен в резултата ви'] },
    { n: `около ${det.format.samplesMin} минути`, h: 'Писмена и устна проба', note: 'Оценява се и се изпраща на университетите', pts: [`Пишете по зададена тема (${det.format.writingSampleMin} минути)`, `Отговаряте устно на въпрос (${det.format.speakingSampleMin} минути)`, 'Университетите получават и двете заедно с резултата ви, а вие можете да ги прегледате след това'] },
  ],
  qIntro: 'Всяка карта показва типовете задачи за едно умение и приблизително колко от всеки ще получите. Броят леко варира при всяко явяване.',
  qColType: 'Тип задача', qColCount: 'Колко',
  adaptiveTag: 'Адаптивни', adaptiveKey: 'стават по-трудни или по-лесни според отговорите ви',
  tipsH3: 'Полезно е да знаете',
  tips: [
    { h: 'Винаги отговаряйте', p: 'Грешният отговор не ви струва повече от празния, а частично верните отговори носят точки.' },
    { h: 'Всеки изпит е различен', p: 'Въпросите идват от огромна база, така че едва ли ще видите един и същ въпрос два пъти.' },
    { h: 'Някои въпроси ще ви се сторят трудни', p: 'Това е нормално – DET се адаптира, за да открие нивото ви.' },
  ],
  qH3: 'Типове задачи',
  dlH3: 'Официални материали за изтегляне',
  dlBtn: 'Изтеглете PDF',
  dl: [
    { h: 'Официално ръководство за кандидати 2026', p: 'Пълното ръководство на Duolingo: как работи DET, как да се подготвите, правилата в деня на изпита и как се оценява. 28 страници, на английски.', href: '/downloads/duolingo-english-test-official-guide-2026.pdf', size: 'PDF · 625 KB' },
    { h: 'Изпитът стъпка по стъпка', p: 'Всички типове задачи по ред – с времето за всяка и колко от тях да очаквате. 2 страници, на английски.', href: '/downloads/duolingo-english-test-test-flow.pdf', size: 'PDF · 642 KB' },
  ],
  skills: [
    { k: 'Четене', v: det.questionTypes.reading.join(', ') },
    { k: 'Слушане', v: det.questionTypes.listening.join(', ') },
    { k: 'Писане', v: det.questionTypes.writing.join(', ') },
    { k: 'Говорене', v: det.questionTypes.speaking.join(', ') },
  ],
  scoreEyebrow: 'Резултати', scoreH2a: 'Какъв резултат от Duolingo English Test ', scoreH2b: 'ви е нужен?',
  scoreIntro: `Резултатите са от ${det.scoreMin} до ${det.scoreMax}. Ето как се сравняват с бандовете в IELTS и нивата по CEFR според официалното сравнение на Duolingo. Много университети изискват резултат ${det.typicalAsk}, а най-селективните – повече. Винаги проверявайте изискванията на вашата програма.`,
  scoreHead: ['Duolingo English Test', 'IELTS Academic', 'CEFR'],
  scoreKey: 'Диапазонът, който много университети изискват',
  subH: 'Оценки по умения',
  subIndiv: 'Четири оценки за отделните умения. Средното от тях е общата ви оценка.',
  subInteg: 'Четири комбинирани оценки, всяка е средното от две умения.',
  skillNames: { speaking: 'Говорене', writing: 'Писане', reading: 'Четене', listening: 'Слушане' },
  combos: { production: 'Продукция (Production)', literacy: 'Грамотност (Literacy)', comprehension: 'Разбиране (Comprehension)', conversation: 'Разговор (Conversation)' },
  repTag: 'Пример', repH: 'Как изглежда един резултат',
  repOverall: 'Обща оценка', repEquiv: '≈ IELTS 6.5 · CEFR B2',
  repSkills: 'Умения', repCombos: 'Комбинирани оценки',
  repNote: 'Примерен сертификат от Duolingo – кандидатът е измислен. Истинският ви сертификат има собствен линк за проверка, който университетите могат да отворят.',
  repAlt: 'Примерен сертификат от Duolingo English Test: обща оценка 130 (CEFR C1), оценки по умения – говорене 130, писане 100, четене 135, слушане 145 – и комбинирани оценки – продукция 115, грамотност 120, разбиране 140, разговор 140.',
  stats: [
    { u: 'Удобен', n: '~1 час', l: 'онлайн, на собствения ви компютър – по всяко време и навсякъде по света' },
    { u: 'Бърз', n: `${det.resultsDays} дни`, l: 'до резултата ви – с обща оценка, оценки по умения и вашите писмен и устен отговор' },
    { u: 'Достъпен', n: `~${det.priceEurApprox} €`, l: 'част от цената на другите изпити, а резултатът се изпраща до колкото искате университети без допълнително заплащане' },
    { u: 'Признат', n: det.institutionsBg, l: 'институции по света го приемат' },
    { u: 'Адаптивен', n: 'Вашето ниво', l: 'въпросите стават по-трудни или по-лесни според отговорите ви, така че решавате задачи, близки до вашето ниво' },
    { u: 'Точен', n: 'Експертна оценка', l: 'създаден от специалисти по езиково тестване и оценяван от система, обучена да преценява английския ви като опитен изпитващ' },
    { u: 'Сигурен', n: 'Под наблюдение', l: 'всяка сесия се преглежда от квестори, подпомогнати от технология, която отбелязва всичко необичайно' },
    { u: 'Пълен', n: '4 умения', l: 'четене, писане, слушане и говорене – в един изпит' },
