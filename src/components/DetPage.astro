  parts: [
    { n: `~${det.format.setupMin} мин`, h: 'Подготовка', p: 'Проверка на самоличността, сканиране на стаята и настройване на телефона като втора камера.' },
    { n: `~${det.format.adaptiveMin} мин`, h: 'Адаптивен тест', p: 'Кратки задачи за четене, слушане, писане и говорене. Стават по-трудни или по-лесни според отговорите ви.' },
    { n: `~${det.format.samplesMin} мин`, h: 'Писмена и устна задача', p: `Един по-дълъг писмен отговор (${det.format.writingSampleMin} минути) и един по-дълъг устен отговор (${det.format.speakingSampleMin} минути). Университетите ги получават заедно с резултата ви.` },
