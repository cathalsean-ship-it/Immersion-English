<script>
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = item.querySelector('.faq-body') as HTMLElement;
      const icon = trigger.querySelector('.faq-icon') as HTMLElement;
      const chevron = trigger.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      body.style.display = isOpen ? 'none' : 'block';
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      icon.style.background = isOpen ? 'var(--cream)' : 'var(--green-soft)';
      chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    });
  });
</script>
