---
/**
 * Duolingo English Test page body, in English or Bulgarian.
 *
 * Both /duolingo-english-test and /bg/duolingo-english-test render this, so
 * the two versions share one layout and one set of figures (src/data/det.ts
 * and src/data/courses.ts). Only the words differ. Do not type a price, a
 * duration or a count into the copy below – interpolate it.
 *
 * Partner badge: /det-gpn-member.svg is Duolingo's "Member" Global Partner
 * Network logo, unaltered except that the word MEMBER, which Duolingo ship as
 * live text in a font browsers don't have, was converted to outlines in Nunito,
 * the substitute font their brand guidelines name. Their guidelines also say:
 * don't recolour, stretch or add effects, keep it on a background where it is
 * legible, and don't show it too small to read. The clear space is built in.
 */
import { det, otherTests } from '../data/det';
import { courses, services } from '../data/courses';

interface Props { lang: 'en' | 'bg' }
const { lang } = Astro.props;
const bg = lang === 'bg';
const contact = bg ? '/bg/contact' : '/contact';
const c = (interest: string, from: string) => `${contact}?interest=${interest}&from=${from}#booking-form`;

const fb = services.detFeedback.price;
const prep = courses.examPreparation;

const t = bg ? {
  eyebrow: 'Duolingo English Test',
