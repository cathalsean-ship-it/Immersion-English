---
interface Props {
  title: string;
  description?: string;
  href?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, href, image, imageAlt = '' } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow flex flex-col">
  {image
    ? <img src={image} alt={imageAlt || title} class="w-full h-48 object-cover" loading="lazy" loading="lazy" />
    : <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400 text-sm">Image placeholder</div>
  }
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-lg font-semibold mb-2">{title}</h3>
    {description && <p class="text-gray-600 text-sm leading-relaxed flex-1">{description}</p>}
    {href && (
      <a href={href} class="inline-block mt-4 text-blue-700 font-medium text-sm hover:underline">
        Learn more →
      </a>
    )}
  </div>
</div>
