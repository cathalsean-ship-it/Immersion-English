---
import type { Lang } from '../data/i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const bg = lang === 'bg';
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-off-white text-ink-soft">
  <div class="container-x py-8">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-line">
      <!-- Logo + strapline -->
      <div class="flex items-center gap-3">
        <img src="/ie-logo-80.png" alt="Immersion English" width="40" height="40" class="h-10 w-auto block" loading="lazy" />
        <p class="text-[0.88rem] font-heading font-semibold tracking-wide" style="color: var(--ink);">English. For Living.</p>
      </div>

      <!-- Social icons — grey -->
      <div class="flex items-center gap-3">
        <a href="https://facebook.com/immersionenglish.ie" target="_blank" rel="noopener noreferrer"
           aria-label="Immersion English on Facebook" title="Facebook"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-opacity hover:opacity-70"
           style="background: var(--ink-soft);">
          <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="white">
            <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.883v2.271h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
          </svg>
        </a>
        <a href="https://youtube.com/@immersionenglish3932" target="_blank" rel="noopener noreferrer"
           aria-label="Immersion English on YouTube" title="YouTube"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-opacity hover:opacity-70"
           style="background: var(--ink-soft);">
          <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="white">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-5 text-[0.84rem]">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5">
        <a href="mailto:immersionenglish.ie@gmail.com" class="text-ink-soft hover:text-brand-green transition-colors no-underline">immersionenglish.ie@gmail.com</a>
        <a href="tel:+359893387464" class="text-ink-soft hover:text-brand-green transition-colors no-underline">+359 893 387 464 <span style="color: var(--ink-mute);">(EN)</span></a>
        <a href="tel:+359889178100" class="text-ink-soft hover:text-brand-green transition-colors no-underline">+359 889 178 100 <span style="color: var(--ink-mute);">{bg ? '(БГ)' : '(BG)'}</span></a>
      </div>
      <span style="color: var(--ink-mute);"><a href="/privacy" class="text-ink-soft hover:text-brand-green transition-colors underline underline-offset-2">{bg ? 'Поверителност и бисквитки' : 'Privacy & cookies'}</a> &nbsp;&middot;&nbsp; &copy; {year} Immersion English. {bg ? 'Всички права запазени.' : 'All rights reserved.'}</span>
    </div>

  </div>
</footer>
