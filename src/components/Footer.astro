        </a>
        <!-- Viber (BG) — outlined purple -->
        <a href="viber://chat?number=%2B359889178100"
           aria-label="Viber (Bulgarian)" title="Viber (BG)"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-colors hover:bg-[#7360f2] group"
           style="border: 1.5px solid #7360f2;">
          <svg viewBox="0 0 24 24" class="w-[17px] h-[17px]" style="fill: #7360f2;">
            <path d="M11.997 2C6.477 2 2 6.477 2 12c0 1.74.45 3.37 1.24 4.79L2 22l5.36-1.22A9.96 9.96 0 0012 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2zm3.87 13.68c-.23.64-1.35 1.22-1.87 1.27-.52.05-1.01.23-3.4-.71-2.86-1.1-4.7-4.02-4.84-4.21-.14-.2-1.15-1.53-1.15-2.92 0-1.38.72-2.06 1-2.35.26-.28.57-.35.76-.35h.55c.18 0 .43-.07.67.51.25.6.84 2.06.92 2.21.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.28.14.44.12.6-.07.17-.19.7-.82.89-1.1.19-.28.38-.23.63-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.68-.16 1.32z"/>
          </svg>
        </a>
      </div>

    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-5 text-[0.84rem]">
      <a href="mailto:immersionenglish.ie@gmail.com" class="text-ink-soft hover:text-brand-green transition-colors no-underline">immersionenglish.ie@gmail.com</a>
      <span style="color: var(--ink-mute);"><a href="/privacy" class="text-ink-soft hover:text-brand-green transition-colors underline underline-offset-2">Privacy &amp; cookies</a> &nbsp;&middot;&nbsp; &copy; {year} Immersion English</span>
    </div>

  </div>
