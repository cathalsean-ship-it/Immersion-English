---
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-off-white text-ink-soft">
  <div class="container-x py-10">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-8 pb-8 border-b border-line">

      <div class="max-w-[300px]">
        <div class="mb-3">
          <img src="/ie-logo-80.png" alt="Immersion English" width="40" height="40" class="h-10 w-auto block" loading="lazy" />
        </div>
        <p class="text-[0.88rem] leading-relaxed font-heading font-semibold tracking-wide" style="color: var(--ink);">English. For Living.</p>
      </div>

      <div class="flex flex-wrap gap-x-8 gap-y-2 text-[0.92rem]">
        <a href="/about" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">About</a>
        <a href="/lessons" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">Lessons</a>
        <a href="/dublin-summer-2027" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">Dublin Summer 2027</a>
        <a href="/contact" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">Contact</a>
      </div>

      <!-- Social + contact icons -->
      <div class="flex items-center gap-2">
        <!-- Facebook — filled brand colour -->
        <a href="https://facebook.com/immersionenglish.ie" target="_blank" rel="noopener noreferrer"
           aria-label="Immersion English on Facebook" title="Facebook"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-opacity hover:opacity-80"
           style="background: #1877f2;">
          <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="white">
            <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.883v2.271h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
          </svg>
        </a>
        <!-- YouTube — filled brand colour -->
        <a href="https://youtube.com/@immersionenglish3932" target="_blank" rel="noopener noreferrer"
           aria-label="Immersion English on YouTube" title="YouTube"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-opacity hover:opacity-80"
           style="background: #ff0000;">
          <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="white">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>

        <span class="w-px h-5 mx-1" style="background: var(--line);"></span>

        <!-- WhatsApp (EN) — outlined green -->
        <a href="https://wa.me/359893387464" target="_blank" rel="noopener"
           aria-label="WhatsApp (English)" title="WhatsApp (EN)"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-colors hover:bg-[#25d366] group"
           style="border: 1.5px solid #25d366;">
