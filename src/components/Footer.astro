---
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-off-white text-ink-soft">
  <div class="container-x py-10">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-8 pb-8 border-b border-line">

      <div class="max-w-[300px]">
        <div class="flex items-center gap-[10px] mb-3">
          <span class="nav-mark text-sm">i<span class="text-brand-orange">·</span></span>
          <span class="font-heading font-bold text-ink text-[1rem]">Immersion English</span>
        </div>
        <p class="text-[0.88rem] leading-relaxed">Speaking-focused English lessons in Sofia and a summer programme in Dublin for teens aged 13–17.</p>
      </div>

      <div class="flex flex-wrap gap-x-8 gap-y-2 text-[0.92rem]">
        <a href="/about" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">About</a>
        <a href="/lessons" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">Lessons</a>
        <a href="/dublin-summer-2027" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">Dublin Summer 2027</a>
        <a href="/contact" class="text-ink-soft no-underline whitespace-nowrap hover:text-brand-green transition-colors">Contact</a>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://facebook.com/immersionenglish.ie"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Immersion English on Facebook"
          class="w-9 h-9 rounded-full border border-line grid place-items-center text-ink-soft hover:text-brand-green hover:border-brand-green transition-colors no-underline text-[1rem]"
        >f</a>
        <a
          href="https://youtube.com/@immersionenglish3932"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Immersion English on YouTube"
          class="w-9 h-9 rounded-full border border-line grid place-items-center text-ink-soft hover:text-brand-green hover:border-brand-green transition-colors no-underline text-[0.9rem]"
        >▶</a>
      </div>

    </div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-5 text-[0.84rem]">
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        <a href="mailto:immersionenglish.ie@gmail.com" class="text-ink-soft hover:text-brand-green transition-colors no-underline">immersionenglish.ie@gmail.com</a>
        <span>+359 893 387 464 <span class="opacity-60">(EN)</span></span>
        <span>+359 889 178 100 <span class="opacity-60">(BG)</span></span>
      </div>
      <span class="text-ink-soft opacity-60">&copy; {year} Immersion English</span>
    </div>
  </div>
</footer>
