        <a href="https://wa.me/359889178100" target="_blank" rel="noopener"
           aria-label="WhatsApp (Bulgarian)" title="WhatsApp (BG)"
           class="w-9 h-9 rounded-full grid place-items-center no-underline transition-colors hover:bg-[#25d366] group"
           style="border: 1.5px solid #25d366;">
          <svg viewBox="0 0 24 24" class="w-[17px] h-[17px]" style="fill: #25d366;">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.74.45 3.37 1.24 4.79L2 22l5.36-1.22A9.96 9.96 0 0012 22c5.523 0 10-4.477 10-10S17.52 2 12 2zm5.07 13.88c-.22.62-1.3 1.18-1.8 1.23-.5.05-.98.22-3.3-.69-2.77-1.07-4.56-3.9-4.7-4.08-.13-.19-1.11-1.48-1.11-2.83 0-1.34.7-2 .97-2.28.25-.27.55-.34.73-.34h.54c.17 0 .41-.07.65.5.24.58.81 2 .89 2.14.07.14.12.3.02.48-.09.18-.14.3-.27.46-.14.16-.28.36-.4.48-.14.14-.27.28-.12.55.16.27.68 1.12 1.46 1.8 1 .9 1.84 1.17 2.1 1.3.27.14.43.12.58-.07.17-.18.68-.8.86-1.07.18-.27.37-.22.61-.13.25.09 1.6.75 1.87.9.27.13.45.2.52.32.07.11.07.66-.15 1.28z"/>
