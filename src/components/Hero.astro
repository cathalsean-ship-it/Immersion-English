---
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  size?: 'lg' | 'sm';
}

const { title, subtitle, ctaText, ctaHref = '#', size = 'lg' } = Astro.props;
---

<section class:list={[
  'bg-blue-700 text-white px-4',
  size === 'lg' ? 'py-24' : 'py-14',
]}>
  <div class="max-w-3xl mx-auto text-center">
    <h1 class:list={[
      'font-bold mb-4',
      size === 'lg' ? 'text-4xl md:text-5xl' : 'text-3xl md:text-4xl',
    ]}>
      {title}
    </h1>
    {subtitle && (
      <p class="text-lg md:text-xl text-blue-100 mb-8 leading-relaxed">{subtitle}</p>
    )}
    {ctaText && (
      <a
        href={ctaHref}
        class="inline-block bg-white text-blue-700 font-semibold px-8 py-3 rounded-lg hover:bg-blue-50 transition-colors"
      >
        {ctaText}
      </a>
    )}
  </div>
</section>
