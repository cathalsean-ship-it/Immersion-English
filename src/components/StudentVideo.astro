---
/**
 * A YouTube video — click to play.
 *
 * PRIVACY: no YouTube markup, and no YouTube IMAGE, in the initial HTML.
 * A bare <iframe>, or even a poster served from i.ytimg.com, contacts Google
 * on page load for every visitor, before the cookie banner has been answered.
 * The banner promises that the only Google we load is Analytics, and that only
 * on acceptance — an auto-loading embed makes that promise untrue. Same
 * reasoning as LocationMap.astro, and this site's audience is parents of
 * minors in the EU. Nothing reaches Google until someone presses play, and the
 * player is then loaded from youtube-nocookie.com.
 *
 * Do not "simplify" this into a bare <iframe>.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  videoId: string;
  title: string;
  /** An imported asset, or a path to a file in public/. */
  poster: ImageMetadata | string;
  caption?: string;
}

const { videoId, title, poster, caption } = Astro.props;
const embedSrc = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
const shellId = `video-shell-${videoId}`;
const posterStyle =
  'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;';
---

<div style="display: flex; flex-direction: column; gap: 10px;">
  <div
    id={shellId}
    data-embed-src={embedSrc}
    data-title={title}
    class="relative w-full rounded-md overflow-hidden"
    style="aspect-ratio: 16/9; border: 1px solid var(--line); box-shadow: var(--shadow-md); background: var(--cream);"
  >
    {typeof poster === 'string'
      ? <img src={poster} alt="" style={posterStyle} loading="lazy" decoding="async" />
      : <Image
          src={poster}
          alt=""
          widths={[480, 760, 1140]}
          sizes="(max-width: 767px) 92vw, 620px"
          style={posterStyle}
          loading="lazy"
        />}

    <div
      aria-hidden="true"
      style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,75,50,0.08) 0%, rgba(20,32,26,0.48) 100%);"
    >
    </div>

    <button
      type="button"
      aria-label={`Play the video: ${title}`}
      style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 76px; height: 76px; border-radius: 50%; border: none; background: var(--orange); box-shadow: 0 10px 28px rgba(20,32,26,0.34); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0;"
    >
      <svg width="25" height="28" viewBox="0 0 30 34" fill="none" aria-hidden="true" style="margin-left: 4px;">
        <path
          d="M28 15.27a2 2 0 0 1 0 3.46L3 33.2A2 2 0 0 1 0 31.46V2.54A2 2 0 0 1 3 .8z"
          fill="#14201a"></path>
      </svg>
    </button>

    <p
      class="font-heading font-bold m-0"
      style="position: absolute; left: 22px; right: 22px; bottom: 20px; color: white; font-size: 1.05rem; line-height: 1.3; text-shadow: 0 1px 3px rgba(20,32,26,0.5);"
    >
      {title}
    </p>
  </div>

  {caption && <p class="text-[0.84rem] m-0" style="color: var(--ink-soft);">{caption}</p>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-embed-src]').forEach((shell) => {
    const btn = shell.querySelector('button');
    btn?.addEventListener('click', () => {
      const src = shell.dataset.embedSrc;
      if (!src) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = shell.dataset.title ?? 'Video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.setAttribute('allowfullscreen', '');
      frame.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      shell.replaceChildren(frame);
    });
  });
</script>
