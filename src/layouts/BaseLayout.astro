---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Immersion English – English language school in Sofia, Bulgaria',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;700&display=swap"
    />
    <title>{title} | Immersion English</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Greyscale reveal on scroll — works on both mobile and desktop
      // Targets: .img-greyscale, .trip-card-img, .homepage-hero-img
      const selectors = '.img-greyscale, .trip-card-img, .homepage-hero-img';

      function revealOnScroll() {
        const imgs = document.querySelectorAll(selectors);
        if (!imgs.length) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
            } else {
              // Remove when scrolled out so it re-animates on scroll back
              entry.target.classList.remove('in-view');
            }
          });
        }, {
          threshold: 0.2,   // 20% visible triggers reveal
          rootMargin: '0px 0px -40px 0px'
        });

        imgs.forEach(img => observer.observe(img));
      }

      // Run after DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', revealOnScroll);
      } else {
        revealOnScroll();
      }
    </script>
  </body>
</html>
