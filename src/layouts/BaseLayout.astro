---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Immersion English – English language school in Sofia, Bulgaria',
  ogImage = '/og-default.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://immersion-english.com');
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${canonicalURL.origin}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#008037" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Immersion English" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:site" content="@immersionenglish" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/iE-mark.svg" />
    <link rel="apple-touch-icon" href="/iE-mark.svg" />

    <!-- Fonts — non-blocking async load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Lato:wght@400;700&display=swap" /></noscript>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JCEKWZWT87"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JCEKWZWT87');
      gtag('config', 'G-G193KE10LZ');
    </script>
    <!-- Bulgarian language keywords for SEO -->
    <meta name="keywords" content="английски език София, летен езиков курс Дъблин, английски за тийнейджъри, езикова програма Ирландия, летен езиков лагер Дъблин, IELTS подготовка София, Cambridge CAE София, English summer school Dublin Bulgaria, английски уроци онлайн София" />
    <!-- JSON-LD structured data: Organisation (all pages) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Immersion English",
      "url": "https://immersion-english.com",
      "logo": "https://immersion-english.com/iE-mark.svg",
      "description": "Sofia-based English language school offering online English courses for adults and an immersive summer programme in Dublin, Ireland for teenagers aged 13-17. Courses include speaking, exam preparation (IELTS, Cambridge CAE), General English and Business English - all with a strong focus on real communication. Taught by Cathal (Lenny) Leonard - a CELTA-qualified native Irish teacher with over 10 years experience, including at the British Council. Small groups (max 8), real conversation from day one.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sofia",
        "addressCountry": "BG"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "immersionenglish.ie@gmail.com",
        "contactType": "customer service",
        "availableLanguage": ["English", "Bulgarian"]
      },
      "founder": {
        "@type": "Person",
        "name": "Cathal Leonard",
        "jobTitle": "English Language Teacher",
        "description": "CELTA-qualified native Irish English teacher with over 10 years experience teaching adults and teenagers, including at the British Council."
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "English Language Courses",
        "itemListElement": [
          {
            "@type": "Course",
            "name": "Speak Up! Group English Course",
            "description": "Structured group speaking programme. 12 lessons over 6 weeks, maximum 8 students, online. Level B2 and above.",
            "provider": { "@type": "EducationalOrganization", "name": "Immersion English" },
            "courseMode": "online",
            "educationalLevel": "B2-C1",
            "offers": { "@type": "Offer", "price": "290", "priceCurrency": "EUR" }
          },
          {
            "@type": "Course",
            "name": "Personal Speaking Coach",
            "description": "1:1 online English coaching tailored to your goals. Flexible schedule, targeted feedback every session. Level B2 and above.",
            "provider": { "@type": "EducationalOrganization", "name": "Immersion English" },
            "courseMode": "online",
            "educationalLevel": "B2-C1",
            "offers": { "@type": "Offer", "price": "45", "priceCurrency": "EUR" }
          },
          {
            "@type": "Course",
            "name": "Dublin Summer English Programme 2027",
            "description": "7-day immersive English summer programme in Dublin, Ireland for Bulgarian teenagers aged 13-17. Maximum 13 students. July 2027.",
            "provider": { "@type": "EducationalOrganization", "name": "Immersion English" },
            "courseMode": "onsite",
            "location": { "@type": "Place", "name": "Dublin", "address": { "@type": "PostalAddress", "addressLocality": "Dublin", "addressCountry": "IE" } },
            "educationalLevel": "secondary",
            "audience": { "@type": "Audience", "audienceType": "Teenagers aged 13-17" },
            "offers": { "@type": "Offer", "price": "1490", "priceCurrency": "EUR" }
          }
        ]
      },
      "sameAs": [
        "https://www.facebook.com/immersionenglish.ie",
        "https://www.youtube.com/@immersionenglish3932"
      ]
    })} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
    // Scroll-triggered greyscale reveal — runs on all devices
    (function () {
      const targets = document.querySelectorAll('.img-greyscale, .trip-card-img, .homepage-hero-img');
      if (!targets.length) return;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
            } else {
              entry.target.classList.remove('in-view');
            }
          });
        },
        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
      );
      targets.forEach((el) => observer.observe(el));
    })();
  </script>
</body>
</html>
