---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { dublin } from '../data/dublin';
// This JSON-LD is emitted on every page, so a figure typed in here is a figure
// on the whole site. It carried "price": "45" for the Personal Speaking Coach
// while courses.ts and the lessons page said €50 — Google was being told a
// different price from the one visitors saw. Render, never retype.
import { courses } from '../data/courses';
import { keywordsFor } from '../data/keywords';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  // Title shown on Facebook / WhatsApp / X previews only. Leaves <title>,
  // which Google uses, untouched.
  ogTitle?: string;
  // Only the 404 page sets this. It is served at every missing URL, so it must
  // not be indexed under any of them.
  noindex?: boolean;
}

const {
  title,
  description = 'Immersion English – English language school in Sofia, Bulgaria',
  ogImage = '/og/home.jpg',
  ogImageAlt,
  ogTitle,
  noindex = false,
} = Astro.props;

// WebPage + BreadcrumbList for every indexable page, built from the URL so it
// can never drift from the real structure. Skipped for 404 / thank-you.
const LABELS: Record<string, string> = {
  'about': 'About', 'lessons': 'Lessons', 'corporate-training': 'Corporate Training',
  'contact': 'Contact', 'blog': 'Blog', 'dublin-summer-2027': 'Dublin Summer 2027',
  'accommodation': 'Accommodation', 'trips-and-activities': 'Trips & Activities',
  'weekly-programme': 'Weekly Programme', 'faqs': 'FAQs', 'privacy': 'Privacy & Cookie Policy',
};
const segs = Astro.url.pathname.split('/').filter(Boolean);
const keywords = keywordsFor(Astro.url.pathname);
const origin = (Astro.site?.toString() || 'https://immersion-english.com').replace(/\/$/, '');
const crumbs = [{ name: 'Home', url: origin + '/' }, ...segs.map((s, i) => ({
  name: LABELS[s] ?? title.split('|')[0].trim(),
  url: origin + '/' + segs.slice(0, i + 1).join('/'),
}))];
const breadcrumbSchema = segs.length === 0 || ['404', 'thank-you'].includes(segs[0]) ? null : {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': origin + Astro.url.pathname + '#webpage', url: origin + Astro.url.pathname, name: title, description, inLanguage: 'en', ...(keywords ? { keywords: keywords.join(', ') } : {}), isPartOf: { '@type': 'WebSite', name: 'Immersion English', url: origin + '/' } },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) },
  ],
};
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://immersion-english.com');
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${canonicalURL.origin}${ogImage}`;

// Meta (Facebook) Pixel. Leave empty to keep it switched off. When set, it loads
// ONLY after a visitor clicks Accept on the cookie banner, exactly like Google
// Analytics, and the banner wording changes to name Meta.
const META_PIXEL_ID = '4098945000240922';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="google-site-verification" content="l7434Tgntc6NGtIY8T4JRlbAiD-kgJ9T9JGCAuPi9iw" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00682C" />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Immersion English" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />
    <meta name="twitter:site" content="@immersionenglish" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/montserrat-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/ie-logo-192.png" />
    <link rel="apple-touch-icon" href="/ie-logo-192.png" />

    <!-- Analytics & advertising pixels: loaded only after cookie consent -->
    <script is:inline define:vars={{ pixelId: META_PIXEL_ID }}>
      window.__IE_PIXEL_ID = pixelId;
      window.ieLoadTracking = function () {
        if (window.__ieTrackingLoaded) return;
        window.__ieTrackingLoaded = true;
        // Google Analytics
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-JCEKWZWT87';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){dataLayer.push(arguments);};
        window.gtag('js', new Date());
        window.gtag('config', 'G-JCEKWZWT87');
        window.gtag('config', 'G-G193KE10LZ');
        // Meta Pixel (only if an ID has been configured)
        if (window.__IE_PIXEL_ID) {
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', window.__IE_PIXEL_ID);
          window.fbq('track', 'PageView');
        }
      };
      try { if (localStorage.getItem('ie_cookie_consent') === 'accepted') window.ieLoadTracking(); } catch (e) {}
    </script>
    <!-- Page-specific search terms, EN + BG. See src/data/keywords.ts -->
    {keywords && <meta name="keywords" content={keywords.join(', ')} />}
    <!-- JSON-LD structured data: Organisation (all pages) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Immersion English",
      "url": "https://immersion-english.com",
      "logo": "https://immersion-english.com/ie-logo.png",
      // Lenny's portrait is the face of the business. Without an image here,
      // AI assistants (ChatGPT in Oct 2026) picked an unrelated photo from web
      // image search for the Immersion English card. Point them at the real one.
      "image": {
        "@type": "ImageObject",
        "url": "https://immersion-english.com/team-lenny.jpg",
        "width": 1200,
        "height": 1600,
        "caption": "Cathal (Lenny) Leonard, founder and English teacher at Immersion English"
      },
      "description": `Sofia-based English language school offering online English courses for adults, and a summer group to Dublin for students aged ${dublin.ages.min}–${dublin.ages.max} as booking agent. Courses include speaking, exam preparation (IELTS, Cambridge CAE), General English and Business English - all with a strong focus on real communication. Taught by Cathal (Lenny) Leonard - a CELTA-qualified native Irish teacher with over 10 years experience, including at the British Council. Small groups (max 8), real conversation from day one.`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sofia",
        "addressCountry": "BG"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "immersionenglish.ie@gmail.com",
        "contactType": "customer service",
        "availableLanguage": ["English", "Bulgarian"]
      },
      "founder": [
        {
          "@type": "Person",
          "@id": "https://immersion-english.com/about#lenny",
          "name": "Cathal Leonard",
          "alternateName": ["Lenny", "Cathal (Lenny) Leonard"],
          "url": "https://immersion-english.com/about",
          "image": "https://immersion-english.com/team-lenny.jpg",
          "nationality": { "@type": "Country", "name": "Ireland" },
          "jobTitle": "English Language Teacher and Co-founder",
          "description": "CELTA-qualified native Irish English teacher with over 10 years experience teaching adults and teenagers, including at the British Council."
        },
        {
          "@type": "Person",
          "name": "Lina Georgieva",
          "jobTitle": "Co-founder",
          "description": "Co-founder of Immersion English, with a background in international education with the British Council. Native Bulgarian speaker."
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "English Language Courses",
        "itemListElement": [
          {
            "@type": "Course",
            "name": courses.speakUp.name,
            "description": `Structured group speaking programme. 12 lessons over 6 weeks, each ${courses.speakUp.lessonMinutes} minutes, maximum 8 students, online. Level B1 and above.`,
            "provider": { "@type": "EducationalOrganization", "name": "Immersion English" },
            "courseMode": "online",
            "educationalLevel": "B1-C1",
            "timeRequired": `PT${courses.speakUp.lessonMinutes}M`,
            "offers": { "@type": "Offer", "price": String(courses.speakUp.total), "priceCurrency": "EUR" }
          },
          {
            "@type": "Course",
            "name": courses.personalSpeakingCoach.name,
            "description": `1:1 online English coaching tailored to your goals. ${courses.personalSpeakingCoach.lessonMinutes}-minute sessions. Flexible schedule, targeted feedback every session. Level B1 and above.`,
            "provider": { "@type": "EducationalOrganization", "name": "Immersion English" },
            "courseMode": "online",
            "educationalLevel": "B1-C1",
            "timeRequired": `PT${courses.personalSpeakingCoach.lessonMinutes}M`,
            "offers": { "@type": "Offer", "price": String(courses.personalSpeakingCoach.perLesson), "priceCurrency": "EUR" }
          },
          {
            // Provider is MLA, not Immersion English. Immersion English is the
            // booking agent and accompanies the group.
            // No `offers` block on purpose. This JSON-LD is emitted on EVERY page,
            // so a price here is a price everywhere and goes stale everywhere at
            // once. The figure lives in src/data/dublin.ts price.amount and is
            // rendered on the Dublin page and the homepage only.
            "@type": "Course",
            "name": `Dublin Summer English Programme ${dublin.year}`,
            "description": `Summer English programme at the ${dublin.venue.name}, ${dublin.venue.city}, for students aged ${dublin.ages.min}–${dublin.ages.max}. ${dublin.lessonsPerWeek} lessons per week; Immersion English accompanies the group in Dublin as booking agent.`,
            // No provider named. The programme is not provided by Immersion
            // English, so this must not fall back to the page's own
            // organisation — an omitted provider says nothing, whereas naming
            // the wrong one is a claim. See dublin.ts provider.
            "courseMode": "onsite",
            "location": { "@type": "Place", "name": dublin.venue.name, "address": { "@type": "PostalAddress", "addressLocality": dublin.venue.city, "addressRegion": dublin.venue.area, "addressCountry": "IE" } },
            "educationalLevel": "secondary",
            "audience": { "@type": "Audience", "audienceType": `Students aged ${dublin.ages.min}–${dublin.ages.max}` }
          }
        ]
      },
      // Bulgarian search terms live here and in src/data/keywords.ts only.
      // Lina decided (Oct 2026) not to show Bulgarian text on the pages.
      "keywords": "English lessons Sofia, native English teacher, IELTS preparation, Cambridge CAE, Business English, English summer course Dublin, уроци по английски София, курсове по английски София, английски с носител на езика, онлайн уроци по английски, подготовка за IELTS, бизнес английски, летен езиков курс Дъблин, Имършън Инглиш, Immersion English София, uroci po angliiski Sofia, angliiski s nositel na ezika",
      "knowsLanguage": ["en", "bg"],
      "areaServed": [{ "@type": "City", "name": "Sofia" }, { "@type": "Country", "name": "Bulgaria" }],
      "sameAs": [
        "https://www.facebook.com/immersionenglish.ie",
        "https://www.youtube.com/@immersionenglish3932"
      ]
    })} />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary of this site" />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
    // Greyscale reveal — only the image whose centre is closest to screen midpoint gets colour
    (function () {
      const targets = Array.from(document.querySelectorAll('.img-greyscale:not(.no-hover-reveal), .trip-card-img, .homepage-hero-img'));
      if (!targets.length) return;

      let ticking = false;

      function update() {
        const mid = window.innerHeight / 2;
        let closest = null;
        let closestDist = Infinity;
        targets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          const elMid = rect.top + rect.height / 2;
          const dist = Math.abs(elMid - mid);
          if (dist < closestDist) {
            closestDist = dist;
            closest = el;
          }
        });
        targets.forEach((el) => {
          if (el === closest) {
            el.classList.add('in-view');
          } else {
            el.classList.remove('in-view');
          }
        });
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });

      // Run after first paint so reading layout doesn't force a synchronous reflow.
      requestAnimationFrame(update);
    })();
  </script>

    <!-- Cookie consent banner -->
    <div id="cookie-banner" style="display:none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 999; background: var(--ink); padding: 16px 24px; box-shadow: 0 -4px 24px rgba(0,0,0,0.25);">
      <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <p style="margin: 0; font-size: 0.88rem; color: rgba(255,255,255,0.8); max-width: 640px; line-height: 1.5;">{META_PIXEL_ID ? 'We use cookies to understand how visitors use our site (Google Analytics) and to measure and improve our advertising (Meta). Nothing is loaded unless you accept.' : 'We use cookies to understand how visitors use our site (Google Analytics). No personal data is sold or shared.'} <a href="/privacy" style="color: var(--orange); text-decoration: underline;">Privacy &amp; cookies</a></p>
        <div style="display: flex; gap: 10px; flex-shrink: 0;">
          <button id="cookie-decline" style="background: transparent; border: 1px solid rgba(255,255,255,0.45); color: rgba(255,255,255,0.92); padding: 8px 18px; border-radius: 8px; cursor: pointer; font-family: Montserrat, sans-serif; font-weight: 600; font-size: 0.82rem;">Decline</button>
          <button id="cookie-accept" style="background: var(--orange); border: none; color: var(--ink); padding: 8px 18px; border-radius: 8px; cursor: pointer; font-family: Montserrat, sans-serif; font-weight: 700; font-size: 0.82rem;">Accept</button>
        </div>
      </div>
    </div>
    <script>
      (function() {
        var b = document.getElementById('cookie-banner');
        if (!localStorage.getItem('ie_cookie_consent') && b) b.style.display = 'block';
        document.getElementById('cookie-accept') && document.getElementById('cookie-accept').addEventListener('click', function() {
          localStorage.setItem('ie_cookie_consent', 'accepted');
          b.style.display = 'none';
          if (window.ieLoadTracking) window.ieLoadTracking();
        });
        document.getElementById('cookie-decline') && document.getElementById('cookie-decline').addEventListener('click', function() {
          localStorage.setItem('ie_cookie_consent', 'declined');
          b.style.display = 'none';
        });
      })();
    </script>
</body>
</html>
